satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.float f = 0.5
    satellite.variable.number counter = 0
    satellite.statement.while(counter < 200000)
    {
        f = f + 0.5
        counter = counter + 1
    }
    satellite.console.display(f)
    satellite.return(satellite)
}
