satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.float third = 1
    third = third / 3
    satellite.variable.float t = 0.0
    satellite.variable.number counter = 0
    satellite.statement.while(counter < 200000)
    {
        t = t + third
        counter = counter + 1
    }
    satellite.console.display(t)
    satellite.return(satellite)
}
