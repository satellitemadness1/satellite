// LISTS: a million appends, then the whole list summed, its largest found, and sorted.
satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.container.list<satellite.variable.number> items
    satellite.variable.number counter = 0
    satellite.statement.while(counter < 300000)
    {
        items.append(counter * 7919 % 1000003)
        counter = counter + 1
    }
    satellite.console.display(items.sum)
    satellite.console.display(items.max)
    satellite.console.display(items.sort().first)
    satellite.return(satellite)
}
