
satellite.include(satellite)

satellite.spacesuit test_class()
{
	satellite.protected
	{
		satellite.variable.string test_str = "VOID"
		
		satellite.capsule set_test_str(satellite.variable.string input_str)
		{
			test_str = input_str
		}
	}
	
	satellite.public
	{
		satellite.capsule call_set_test_str(satellite.variable.string call_input_str)
		{
			set_test_str(call_input_str)
		}
	}
}

satellite.capsule satellite.main()
{
    satellite.variable.number current_number = 0
    satellite.variable.number target_number = 100000

    satellite.statement.while(current_number < target_number)
    {
    	test_class local_test_object
    	
    	local_test_object.call_set_test_str("hello")
    	
        current_number = current_number + 1
    }

    satellite.return(satellite)
}
