
satellite.include(satellite)

satellite.capsule satellite.main(satellite.variable.arguments arguments)
{
    satellite.variable.window main_window = satellite.window.new("SATELLITE SOURCE EDITOR", "VERSION 001 REVISION 01", 800x600)

    main_window.satellite.section("files_display", 100%, 250)

    main_window.files_display.satellite.widgets.display.file("list_of_files", 100%, 100%)

    // now 50% of the window is made of this file display,

    main_window.satellite.open()

    // satellite.variable.string local_directory_input = main_window.file_display.text_input.listen()

