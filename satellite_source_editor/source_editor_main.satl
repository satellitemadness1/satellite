    // {
        // we have already opened the directory, so it exists at this point

    //    main_window.file_display(local_user_input) // pass the directory to the file display widget we named
    // } satellite.statement.else()
    // {
        // directory cannot be opened,

    //    main_window.file_display.text_input.write("directory does not exist!")
    // }

    // satellite.console.input(">>") // hold the window open until something is entered, and then...

    // main_window.close() // close the window!
    satellite.return(satellite) // exit the program
}