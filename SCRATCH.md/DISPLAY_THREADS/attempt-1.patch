diff --git a/satellite/display/display_buffer.hpp b/satellite/display/display_buffer.hpp
new file mode 100644
index 0000000..bf2dc97
--- /dev/null
+++ b/satellite/display/display_buffer.hpp
@@ -0,0 +1,86 @@
+#pragma once
+// satellite/display/display_buffer.hpp -- WHAT satl PRINTS, AND THE THREE THREADS THAT PRINT IT.
+//
+// The author, 2026-09-26: "we need to create a thread off of the satl process, and then have
+// that thread create 2 more threads, for a total of 3 threads... one will print as fast as it
+// can, one will keep a 256mb buffer, and one will hand pieces of the buffer (4mb at a time) to
+// the display thread", "the one that is handing the pieces to the display thread has to do the
+// converting too", "use std::vector<std::string> for this, and std::vector<satellite_string>
+// as the 256mb buffer, and actually make it a 512mb buffer", "crash the interpreter if it is
+// overran, because if 512mb is overrun, that is a real problem because a 512mb buffer should
+// never get overrun just printing information", and "we need to relieve the interpreter of that
+// conversion!"
+//
+//     the interpreter --satellite_string, MOVED--> 1  THE BUFFER     std::vector<satellite_string>
+//                                                    |  pieces of at most 4 MiB, still satellite_strings
+//                                                    v
+//                                                 2  THE CONVERTER  to_utf8(), one piece at a time
+//                                                    |  std::vector<std::string>
+//                                                    v
+//                                                 3  THE DISPLAY    write(1), as fast as it is taken
+//
+// THE INTERPRETER CONVERTS NOTHING. A string to display goes into the buffer as the
+// satellite_string it already is -- 16-bit codes in the author's order -- and to_utf8() runs on
+// the converter's thread. A long one is MOVED in, which costs the same ~15 ns at any size, where
+// converting a 1 MB string cost the interpreter about half a millisecond. A short one (under 1,024
+// characters) is copied onto the end of a gathering string instead, because a small string made
+// on one thread and freed on another costs more in glibc's allocator than the copy does
+// (display_buffer.cpp has the numbers).
+//
+// THE BUFFER THREAD IS STARTED OFF satl, AND IT STARTS THE OTHER TWO, the first time anything is
+// given to it -- so a run that prints nothing makes no threads. Each of the three blocks every
+// signal, so Ctrl-C still lands on the thread the program runs on.
+//
+// THE CHECK FOR AN OVERRUN IS ONE COMPARISON, and that is how it stays lazy. The buffer keeps a
+// running count of what it holds -- added when a string arrives, taken off when a piece leaves
+// for the converter -- so nothing ever walks the vector to size it. A caller adding a string
+// already holds the buffer's lock to push it; comparing the count against 512 MiB there costs one
+// add and one compare, and catches the overrun on the very string that makes it.
+//
+// WHAT IS COUNTED IS MEMORY: each string's characters at two bytes a unit, and the 48-byte object
+// holding them. A loop displaying one character at a time would otherwise fill gigabytes of
+// vector while the count said a few hundred megabytes. What has left for the converter is not
+// counted -- at most one piece waiting there and two converted ones waiting for the display.
+//
+// AN OVERRUN CRASHES THE PROGRAM, THROUGH THE ORDINARY WAY A PROGRAM STOPS. Everything the buffer
+// holds is let go, the display word that overran it is refused with
+// display_string_buffer_overrun (65), S840, and so is every display after it on any thread. It is
+// not a bare _exit: satl's own console is a window IN THIS PROCESS, and an _exit would close it
+// before anybody read why -- the refusal keeps it up on "stopped on machine code 65".
+//
+// std::cout WRITES INTO THE SAME BUFFER (display_stream.cpp), so satl's own lines -- the prompt,
+// a listing, a styled display -- land between the program's lines in the order they were written.
+// std::cerr is tied to std::cout, so a report flushes it first: a flush WAITS until the display
+// thread has written everything before it, and every report comes after the lines it explains.
+
+#include "../satellite_variable_string/satellite_string.hpp"
+
+#include <cstddef>
+
+namespace satellite004 {
+
+// "actually make it a 512mb buffer" -- and "(4mb at a time)".
+constexpr std::size_t kDisplayBufferBytes = 512ull * 1024 * 1024;
+constexpr std::size_t kDisplayPieceBytes = 4ull * 1024 * 1024;
+
+// THE INTERPRETER'S DOOR. The string is moved in, and `newline` puts one after it. Answers
+// success, display_error when the output has refused an earlier piece (S820, as before), or
+// display_string_buffer_overrun.
+signed long long int display_string(satellite_string &&text, bool newline);
+
+// satl's OWN BYTES -- std::cout's, the listing's progress line. They are made a satellite_string
+// on the way in, so the buffer holds one kind of thing. Bytes that are not UTF-8 are written as
+// they are, after everything given before them.
+signed long long int display_bytes(const char *bytes, std::size_t size);
+
+// Returns once everything given before the call has been written. Answers success, or
+// display_error when the output refused some of it. Never waits after an overrun.
+signed long long int display_drain();
+
+// Whether the buffer has overrun: from then on every display is refused.
+bool display_overran();
+
+// std::cout writes into the buffer from here on. main() calls it before anything prints.
+void display_takes_std_cout();
+
+} // namespace satellite004
