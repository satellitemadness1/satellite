@@ -0,0 +1,501 @@
+// satellite/display/display_buffer.cpp -- the buffer, the converter and the display thread.
+// display_buffer.hpp is the design and the author's words; this is the machinery.
+
+#include "display_buffer.hpp"
+
+#include "../machine/machine_codes.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <atomic>
+#include <cerrno>
+#include <condition_variable>
+#include <csignal>
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <poll.h>
+#include <pthread.h>
+#include <string>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+namespace satellite004 {
+namespace {
+
+constexpr std::size_t kPieceUnits = kDisplayPieceBytes / sizeof(char16_t);
+// HOW MANY CONVERTED PIECES MAY WAIT FOR THE DISPLAY THREAD -- my number, not the author's.
+// Without one, a display that fell behind would let the converter turn the whole buffer into
+// std::strings where the overrun count cannot see them. Two keeps the display thread fed.
+constexpr std::size_t kConvertedWaiting = 2;
+// A SHORT STRING IS GATHERED, NOT MOVED IN: copied onto the end of one gathering string, and let
+// go on the caller's own thread. Measured 2026-09-26, 1,000,000 lines of 37 characters: moved in
+// one by one, each cost the interpreter 230 ns, because every string was made on its thread and
+// freed on the buffer's, and glibc's allocator pays for that at both ends. Gathered, 130 ns -- the
+// copy is 74 bytes. A string past kGatherSmall is still moved in whole and never copied.
+constexpr std::size_t kGatherSmall = 1024;         // units
+constexpr std::size_t kGatherUnits = 16 * 1024;    // how long one gathering string grows
+constexpr std::chrono::microseconds kNap{1000};
+constexpr int kNaps = 10;                         // 10 ms of naps, then a sleep somebody must wake
+// THE THREE STACKS. They recurse nowhere, and satl widens its stack limit to gigabytes for the
+// program's own capsules (machine/stack_share.hpp), which a thread would otherwise inherit.
+constexpr std::size_t kThreadStack = 1024 * 1024;
+
+// A newline's code (satellite_string.hpp's table), asked for once and not at start-up.
+char32_t newline_code()
+{
+    static const char32_t code = satellite_string::code_of(U'\n');
+    return code;
+}
+
+std::size_t weight_of(const satellite_string &text)
+{
+    return sizeof(satellite_string) + text.units() * sizeof(char16_t);
+}
+
+struct DisplayBuffer {
+    // 1 THE BUFFER -- the one lock a caller ever takes.
+    std::mutex buffer_lock;
+    std::condition_variable buffer_has_work;
+    std::vector<satellite_string> arriving;
+    std::size_t held_bytes = 0;          // arriving, plus what the buffer thread is cutting
+    std::uint64_t given_units = 0;       // every unit ever given: what display_drain() waits for
+    bool buffer_thread_sleeps = false;   // a caller wakes it only then
+    bool last_gathers = false;           // arriving.back() is a gathering string, still growing
+
+    // 1 -> 2, ONE PIECE AT A TIME.
+    std::mutex piece_lock;
+    std::condition_variable piece_given, piece_taken;
+    satellite_string piece;
+    std::uint64_t piece_units = 0;
+    bool piece_waiting = false;
+
+    // 2 -> 3, the author's std::vector<std::string>.
+    std::mutex converted_lock;
+    std::condition_variable converted_given, converted_taken;
+    std::vector<std::string> converted;
+    std::uint64_t converted_units = 0;   // every unit converted, the waiting pieces included
+
+    // 3 -> display_drain()
+    std::mutex written_lock;
+    std::condition_variable written_changed;
+    std::uint64_t written_units = 0;
+
+    // HELD WHILE BYTES GO OUT, by the display thread and by a direct write, so neither lands
+    // inside the other.
+    std::mutex write_lock;
+
+    // Which of the other two the buffer thread could start. One that could not be made has its
+    // work done by the thread before it: slower, and nothing is lost.
+    bool converter_runs = false;
+    bool display_runs = false;
+};
+
+// NEVER DESTROYED. std::cout is flushed after main() returns, and that flush waits on these
+// threads -- a buffer destroyed first would be waited on after it had gone.
+DisplayBuffer &the_buffer()
+{
+    static DisplayBuffer *const one = new DisplayBuffer;
+    return *one;
+}
+
+std::atomic<bool> started{false};
+std::once_flag start_once;
+std::atomic<bool> direct_only{false};       // no buffer thread could be made
+std::atomic<bool> in_a_forked_child{false}; // the child of a fork has none of the three
+std::atomic<bool> failed{false};            // the output refused a write
+std::atomic<bool> overran{false};
+
+// write(1) until it is all out. EAGAIN -- an output somebody made non-blocking -- waits for room.
+bool write_all(const char *bytes, std::size_t size)
+{
+    while (size > 0) {
+        const ssize_t wrote = ::write(STDOUT_FILENO, bytes, size);
+        if (wrote > 0) {
+            bytes += wrote;
+            size -= static_cast<std::size_t>(wrote);
+        } else if (wrote < 0 && errno == EINTR) {
+            continue;
+        } else if (wrote < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            pollfd one{STDOUT_FILENO, POLLOUT, 0};
+            ::poll(&one, 1, -1);
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool write_directly(const char *bytes, std::size_t size)
+{
+    if (in_a_forked_child.load(std::memory_order_relaxed))
+        return write_all(bytes, size);   // one thread here, and the lock may be a dead thread's
+    const std::lock_guard<std::mutex> hold(the_buffer().write_lock);
+    return write_all(bytes, size);
+}
+
+void written_through(std::uint64_t units)
+{
+    DisplayBuffer &b = the_buffer();
+    {
+        const std::lock_guard<std::mutex> hold(b.written_lock);
+        b.written_units = units;
+    }
+    b.written_changed.notify_all();
+}
+
+// 3's WORK: the bytes out, and a failure remembered. After a failure the bytes are let go --
+// the count still moves, so nobody waits on a write that will never be made.
+void write_out(const std::string &bytes)
+{
+    if (!failed.load(std::memory_order_relaxed) && !write_all(bytes.data(), bytes.size()))
+        failed.store(true, std::memory_order_release);
+}
+
+// 2's WORK, handed to 3 -- or written here, when there is no display thread.
+void pass_on(std::string bytes, std::uint64_t units)
+{
+    DisplayBuffer &b = the_buffer();
+    if (!b.display_runs) {
+        std::uint64_t through = 0;
+        {
+            const std::lock_guard<std::mutex> hold(b.write_lock);
+            write_out(bytes);
+            through = b.converted_units += units;   // only this thread moves it now
+        }
+        written_through(through);
+        return;
+    }
+    {
+        std::unique_lock<std::mutex> hold(b.converted_lock);
+        b.converted_taken.wait(hold, [&b] { return b.converted.size() < kConvertedWaiting; });
+        b.converted.push_back(std::move(bytes));
+        b.converted_units += units;
+    }
+    b.converted_given.notify_one();
+}
+
+// 1's PIECE, handed to 2 -- or converted here, when there is no converter.
+void hand_on(satellite_string &&piece, std::uint64_t units)
+{
+    DisplayBuffer &b = the_buffer();
+    if (!b.converter_runs) {
+        pass_on(piece.to_utf8(), units);
+        return;
+    }
+    {
+        std::unique_lock<std::mutex> hold(b.piece_lock);
+        b.piece_taken.wait(hold, [&b] { return !b.piece_waiting; });
+        b.piece = std::move(piece);
+        b.piece_units = units;
+        b.piece_waiting = true;
+    }
+    b.piece_given.notify_one();
+}
+
+// 3, THE DISPLAY: "print as fast as it can". It takes every converted piece waiting at once.
+void *display_thread(void *)
+{
+    DisplayBuffer &b = the_buffer();
+    std::vector<std::string> writing;
+    for (;;) {
+        std::uint64_t through = 0;
+        {
+            std::unique_lock<std::mutex> hold(b.converted_lock);
+            b.converted_given.wait(hold, [&b] { return !b.converted.empty(); });
+            writing.swap(b.converted);
+            through = b.converted_units;
+        }
+        b.converted_taken.notify_one();
+        {
+            const std::lock_guard<std::mutex> hold(b.write_lock);
+            for (const std::string &bytes : writing)
+                write_out(bytes);
+        }
+        writing.clear();
+        written_through(through);
+    }
+    return nullptr;
+}
+
+// 2, THE CONVERTER: a 4 MiB satellite_string in, its UTF-8 out.
+void *converter_thread(void *)
+{
+    DisplayBuffer &b = the_buffer();
+    for (;;) {
+        satellite_string piece;
+        std::uint64_t units = 0;
+        {
+            std::unique_lock<std::mutex> hold(b.piece_lock);
+            b.piece_given.wait(hold, [&b] { return b.piece_waiting; });
+            piece = std::move(b.piece);
+            units = b.piece_units;
+            b.piece_waiting = false;
+        }
+        b.piece_taken.notify_one();
+        pass_on(piece.to_utf8(), units);
+    }
+    return nullptr;
+}
+
+bool start_thread(void *(*body)(void *), const char *name)
+{
+    pthread_attr_t shape;
+    if (pthread_attr_init(&shape) != 0)
+        return false;
+    pthread_attr_setstacksize(&shape, kThreadStack);
+    pthread_attr_setdetachstate(&shape, PTHREAD_CREATE_DETACHED);
+    // EVERY SIGNAL BLOCKED, and the new thread takes the mask: Ctrl-C and a closed terminal
+    // belong to the thread the program runs on, whose waits they are meant to break.
+    sigset_t all, before;
+    sigfillset(&all);
+    pthread_sigmask(SIG_BLOCK, &all, &before);
+    pthread_t id;
+    const bool made = pthread_create(&id, &shape, body, nullptr) == 0;
+    pthread_sigmask(SIG_SETMASK, &before, nullptr);
+    pthread_attr_destroy(&shape);
+    if (made)
+        pthread_setname_np(id, name);
+    return made;
+}
+
+// As many whole characters of `text`, from `unit`, as `room` units hold.
+std::size_t characters_that_fit(const satellite_string &text, std::size_t unit, std::size_t room,
+                                std::size_t &units)
+{
+    if (text.fast()) {
+        units = std::min(room, text.units() - unit);
+        return units;
+    }
+    std::size_t characters = 0, width = 0;
+    units = 0;
+    while (unit + units < text.units()) {
+        text.code_at_unit(unit + units, width);
+        if (units + width > room)
+            break;
+        units += width;
+        ++characters;
+    }
+    return characters;
+}
+
+// 1, THE BUFFER THREAD -- the one started off satl, which starts the other two -- and it cuts
+// what arrives into pieces of at most 4 MiB. A string that fits is MOVED into a piece whole; one
+// longer than a piece is cut between characters, never inside a wide one.
+void *buffer_thread(void *)
+{
+    DisplayBuffer &b = the_buffer();
+    b.display_runs = start_thread(display_thread, "satl-display");
+    b.converter_runs = start_thread(converter_thread, "satl-convert");
+
+    std::vector<satellite_string> cutting;
+    std::size_t next = 0, from_character = 0, from_unit = 0;
+    for (;;) {
+        if (next == cutting.size()) {
+            cutting.clear();
+            std::unique_lock<std::mutex> hold(b.buffer_lock);
+            // A SHORT NAP BEFORE A LONG SLEEP. A thread asleep has to be woken, and waking it is a
+            // system call on the interpreter's thread: a program displaying a line every couple
+            // of microseconds let this thread catch up and sleep between every two, and paid the
+            // wake on every display -- 420 ns a line against 155 napping (2026-09-26). So it naps
+            // 1 ms at a time, which nobody has to wake it from, and sleeps for real only after
+            // 10 ms with nothing. 1 ms and not 100 us, because fewer, bigger batches keep the
+            // three threads off the other cores, and a busy core slows the interpreter's own on
+            // this Xeon (7% with three busy, measured with the satl before this was built): 115 ns
+            // a line against 155. A line can wait up to 1 ms longer to appear; a screen shows a
+            // frame every 16.
+            for (int naps = 0; b.arriving.empty() && naps < kNaps; ++naps)
+                b.buffer_has_work.wait_for(hold, kNap);
+            if (b.arriving.empty()) {
+                b.buffer_thread_sleeps = true;
+                b.buffer_has_work.wait(hold, [&b] { return !b.arriving.empty(); });
+                b.buffer_thread_sleeps = false;
+            }
+            cutting.swap(b.arriving);
+            b.last_gathers = false;     // what it gathered is the buffer thread's now
+            next = from_character = from_unit = 0;
+        }
+        if (overran.load(std::memory_order_acquire)) {
+            cutting.clear();            // let it go: the program is being stopped
+            next = 0;
+            continue;
+        }
+        satellite_string piece;
+        std::size_t released = 0;
+        while (next < cutting.size() && piece.units() < kPieceUnits) {
+            satellite_string &text = cutting[next];
+            const std::size_t room = kPieceUnits - piece.units();
+            if (from_unit == 0 && text.units() <= room) {
+                released += weight_of(text);
+                if (piece.empty())
+                    piece = std::move(text);
+                else
+                    piece.append(text);
+                ++next;
+                continue;
+            }
+            std::size_t units = 0;
+            const std::size_t characters = characters_that_fit(text, from_unit, room, units);
+            if (characters == 0)
+                break;                  // a wide character with no room: the next piece takes it
+            satellite_string part;
+            text.substring(from_character, from_character + characters, part);
+            if (piece.empty())
+                piece = std::move(part);
+            else
+                piece.append(part);
+            from_character += characters;
+            from_unit += units;
+            if (from_unit == text.units()) {
+                released += weight_of(text);
+                ++next;
+                from_character = from_unit = 0;
+            }
+        }
+        const std::uint64_t units = piece.units();
+        if (units > 0)
+            hand_on(std::move(piece), units);
+        if (released > 0) {
+            const std::lock_guard<std::mutex> hold(b.buffer_lock);
+            b.held_bytes = b.held_bytes > released ? b.held_bytes - released : 0;
+        }
+    }
+    return nullptr;
+}
+
+void after_a_fork_in_the_child() { in_a_forked_child.store(true, std::memory_order_relaxed); }
+
+void drain_at_exit() { display_drain(); }
+
+void start()
+{
+    pthread_atfork(nullptr, nullptr, after_a_fork_in_the_child);
+    the_buffer();
+    if (!start_thread(buffer_thread, "satl-buffer"))
+        direct_only.store(true, std::memory_order_release);
+    else
+        std::atexit(drain_at_exit);   // every way out waits for what was given
+    started.store(true, std::memory_order_release);
+}
+
+bool goes_directly()
+{
+    if (!started.load(std::memory_order_acquire))
+        std::call_once(start_once, start);
+    return direct_only.load(std::memory_order_relaxed) || in_a_forked_child.load(std::memory_order_relaxed);
+}
+
+// INTO THE BUFFER, with the overrun check: one add and one compare, under the lock the push
+// already holds.
+signed long long int give(satellite_string &&text, bool newline)
+{
+    DisplayBuffer &b = the_buffer();
+    const std::size_t weight = weight_of(text) + (newline ? sizeof(satellite_string) + sizeof(char16_t) : 0);
+    const std::uint64_t units = text.units() + (newline ? 1 : 0);
+    std::vector<satellite_string> dropped;
+    bool wake = false;
+    {
+        const std::lock_guard<std::mutex> hold(b.buffer_lock);
+        if (overran.load(std::memory_order_relaxed))
+            return display_string_buffer_overrun;
+        if (b.held_bytes + weight > kDisplayBufferBytes) {
+            overran.store(true, std::memory_order_release);
+            dropped.swap(b.arriving);   // freed below, outside the lock
+            b.held_bytes = 0;
+            b.last_gathers = false;
+        } else if (units <= kGatherSmall) {
+            if (!b.last_gathers || b.arriving.back().units() + units > kGatherUnits) {
+                b.arriving.emplace_back();
+                b.last_gathers = true;
+                b.held_bytes += sizeof(satellite_string);
+            }
+            b.arriving.back().append(text);
+            if (newline)
+                b.arriving.back().append_code(newline_code());
+            b.held_bytes += units * sizeof(char16_t);
+            b.given_units += units;
+            wake = b.buffer_thread_sleeps;
+        } else {
+            b.arriving.push_back(std::move(text));
+            if (newline) {
+                b.arriving.emplace_back();
+                b.arriving.back().append_code(newline_code());
+            }
+            b.last_gathers = false;
+            b.held_bytes += weight;
+            b.given_units += units;
+            wake = b.buffer_thread_sleeps;
+        }
+    }
+    if (overran.load(std::memory_order_relaxed)) {
+        { const std::lock_guard<std::mutex> hold(b.written_lock); }
+        b.written_changed.notify_all();   // nobody waits on what was let go
+        return display_string_buffer_overrun;
+    }
+    if (wake)
+        b.buffer_has_work.notify_one();
+    return failed.load(std::memory_order_acquire) ? display_error : success;
+}
+
+} // namespace
+
+signed long long int display_string(satellite_string &&text, bool newline)
+{
+    if (failed.load(std::memory_order_acquire))
+        return display_error;
+    if (goes_directly()) {
+        std::string bytes = text.to_utf8();
+        if (newline)
+            bytes += '\n';
+        return write_directly(bytes.data(), bytes.size()) ? success : display_error;
+    }
+    if (!newline && text.empty())
+        return success;
+    return give(std::move(text), newline);
+}
+
+signed long long int display_bytes(const char *bytes, std::size_t size)
+{
+    if (size == 0)
+        return success;
+    if (failed.load(std::memory_order_acquire))
+        return display_error;
+    // AFTER AN OVERRUN satl's own words still reach the screen, written as they come: the
+    // buffer is gone, and what is left to say is why the program stopped.
+    if (goes_directly() || overran.load(std::memory_order_acquire))
+        return write_directly(bytes, size) ? success : display_error;
+    satellite_string text;
+    std::size_t bad = 0;
+    if (satellite_string::from_utf8(std::string(bytes, size), text, bad) != success) {
+        // NOT UTF-8 -- a file name no encoding made, say. It goes out as the bytes it is, after
+        // everything given before it.
+        display_drain();
+        return write_directly(bytes, size) ? success : display_error;
+    }
+    return give(std::move(text), false);
+}
+
+signed long long int display_drain()
+{
+    if (!started.load(std::memory_order_acquire) || direct_only.load(std::memory_order_relaxed) ||
+        in_a_forked_child.load(std::memory_order_relaxed))
+        return failed.load(std::memory_order_acquire) ? display_error : success;
+    DisplayBuffer &b = the_buffer();
+    std::uint64_t target = 0;
+    {
+        const std::lock_guard<std::mutex> hold(b.buffer_lock);
+        target = b.given_units;
+    }
+    {
+        std::unique_lock<std::mutex> hold(b.written_lock);
+        b.written_changed.wait(hold, [&b, target] {
+            return b.written_units >= target || overran.load(std::memory_order_acquire);
+        });
+    }
+    return failed.load(std::memory_order_acquire) ? display_error : success;
+}
+
+bool display_overran() { return overran.load(std::memory_order_relaxed); }
+
+} // namespace satellite004
