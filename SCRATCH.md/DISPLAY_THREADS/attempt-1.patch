+// satellite/display/display_stream.cpp -- std::cout, written into the display buffer.
+//
+// EVERYTHING satl ITSELF WRITES WITH std::cout -- a styled display, a number's digits from its
+// library, the prompt, a listing -- goes into the same buffer as the program's strings, so it lands
+// between them in the order it was written. display_buffer.hpp says why a flush is a wait.
+
+#include "display_buffer.hpp"
+
+#include "../machine/machine_codes.hpp"
+
+#include <iostream>
+#include <streambuf>
+
+namespace satellite004 {
+namespace {
+
+// NO BUFFER OF ITS OWN: every write goes into the display buffer at once. A byte held here would
+// be overtaken by the next string the interpreter moves in, and the lines would change order.
+class DisplayStream : public std::streambuf {
+protected:
+    std::streamsize xsputn(const char *bytes, std::streamsize size) override
+    {
+        if (size <= 0)
+            return 0;
+        return display_bytes(bytes, static_cast<std::size_t>(size)) == success ? size : 0;
+    }
+
+    int_type overflow(int_type c) override
+    {
+        if (traits_type::eq_int_type(c, traits_type::eof()))
+            return traits_type::not_eof(c);
+        const char one = traits_type::to_char_type(c);
+        return display_bytes(&one, 1) == success ? c : traits_type::eof();
+    }
+
+    // A FLUSH WAITS until the display thread has written everything before it, which is what
+    // every std::cout.flush() in satl already meant: said, before anything waits.
+    int sync() override { return display_drain() == success ? 0 : -1; }
+};
+
+} // namespace
+
+void display_takes_std_cout()
+{
+    // NEVER DESTROYED: std::cout is flushed after main() returns, through this.
+    static DisplayStream *const stream = new DisplayStream;
+    std::cout.rdbuf(stream);
+}
+
+} // namespace satellite004
