+expect "display buffer: 200 lines of 1 MiB come out byte for byte" \
+       "0|$(python3 -c "import hashlib; print(hashlib.sha256((('0123456789abcdef' * 65536) + chr(10)).encode() * 200).hexdigest())")" \
+       "$code|$(sha256sum < "$display_room/big.out" | cut -d' ' -f1)"
+# A WIDE CHARACTER ON A PIECE'S EDGE: a piece is 2,097,152 units, and the emoji is three. With
+# 2,097,151 characters before it, it does not fit and starts the next piece; with 2,097,152 it
+# starts the next piece exactly. Either way it is never cut in half.
+printf 'satellite.include(satellite)\n\nsatellite.capsule satellite.main()\n{\n    satellite.variable.string p = "a"\n    satellite.variable.string x = ""\n    satellite.statement.for(satellite.variable.number i = 0; i < 21; i++)\n    {\n        x = x + p\n        p = p + p\n    }\n    satellite.console.display(x + "😀" + "b")\n    satellite.console.display(x + "a" + "😀")\n    satellite.console.display(x + "中文")\n    satellite.return(satellite)\n}\n' > "$display_room/edge.satl"
+"$interpreter" "$display_room/edge.satl" > "$display_room/edge.out" 2> "$display_room/edge.err"; code=$?
+expect "display buffer: an emoji and two CJK characters at a 4 MiB piece's edge come out whole" \
+       "0|$(python3 -c "import hashlib; a = 'a' * (2 ** 21 - 1); print(hashlib.sha256((a + '😀b' + chr(10) + a + 'a😀' + chr(10) + a + '中文' + chr(10)).encode()).hexdigest())")" \
+       "$code|$(sha256sum < "$display_room/edge.out" | cut -d' ' -f1)"
+# A REPORT COMES AFTER THE LINES BEFORE IT: stderr is tied to std::cout, and a flush waits for
+# the display thread. 100,000 lines, then a division by zero, into one file.
+printf 'satellite.include(satellite)\n\nsatellite.capsule satellite.main()\n{\n    satellite.statement.for(satellite.variable.number i = 1; i < 100001; i++)\n    {\n        satellite.console.display(i)\n    }\n    satellite.variable.number z = 0\n    satellite.variable.number q = 1 / z\n    satellite.return(satellite)\n}\n' > "$display_room/report_after.satl"
+"$interpreter" "$display_room/report_after.satl" > "$display_room/report_after.out" 2>&1; code=$?
+expect "display buffer: the division-by-zero report comes after all 100,000 lines before it" "22|100000|yes" \
+       "$code|$(grep -cx '[0-9][0-9]*' "$display_room/report_after.out")|$([ "$(grep -n 'S401' "$display_room/report_after.out" | head -1 | cut -d: -f1)" -gt 100000 ] && echo yes)"
+# THE OVERRUN: a fifo nobody reads holds 64 KiB, the display thread waits on it, and the buffer
+# fills. 1,000 strings of 1 MiB characters is 2 GB; at 512 MiB the program is stopped with S840,
+# exit 65, and satl leaves at once with no more than the buffer's memory.
+printf 'satellite.include(satellite)\n\nsatellite.capsule satellite.main()\n{\n    satellite.variable.string s = "0123456789abcdef"\n    satellite.statement.for(satellite.variable.number i = 0; i < 16; i++)\n    {\n        s = s + s\n    }\n    satellite.statement.for(satellite.variable.number j = 0; j < 1000; j++)\n    {\n        satellite.console.display(s)\n    }\n    satellite.return(satellite)\n}\n' > "$display_room/overrun.satl"
+mkfifo "$display_room/nobody_reads"
+/usr/bin/time -o "$display_room/overrun.time" -f '%M' timeout 60 "$interpreter" "$display_room/overrun.satl" \
+    1<> "$display_room/nobody_reads" 2> "$display_room/overrun.err"; code=$?
+overrun_peak=$(tail -1 "$display_room/overrun.time")
+expect "display buffer: past 512 MB waiting, the program stops with S840 DISPLAY_STRING_BUFFER_OVERRUN, exit 65" "65|1|1" \
+       "$code|$(grep -c 'S840: DISPLAY_STRING_BUFFER_OVERRUN' "$display_room/overrun.err")|$(grep -c 'the display string buffer overran' "$display_room/overrun.err")"
+expect "display buffer: ... holding no more than the buffer: under 1 GiB at its peak (${overrun_peak} KiB)" "yes" \
+       "$([ "${overrun_peak:-999999999}" -lt 1048576 ] && echo yes)"
+
 echo "$passed passed, $failed failed"
 [ "$failed" = 0 ]
