+// ---------------------------------------------------------------------------
+// 13. A BINARY FILE IS A LIST OF BYTES (FO-8)
+// ---------------------------------------------------------------------------
+void bytes_are_items()
+{
+    // THE AUTHOR'S EXAMPLE, DONE IN BYTES: every method the same, with a byte where a line was.
+    const std::string p = at("demo.bin");
+    const Handle f = satellite_file::make_new(p, Kind::binary);
+    check(f && f->ok() && f->size() == 0 && f->empty() && f->kind() == Kind::binary, "bytes: new makes an empty binary file",
+          said(f));
+    if (!f || !f->ok())
+        return;
+    std::string out;
+    check(f->append("line_1") && f->size() == 6 && f->line(1, out) && out == "l" && f->line(6, out) && out == "1",
+          "bytes: append(\"line_1\") is 6 bytes, f[1] is \"l\", f[6] is \"1\"", said(f));
+    check(f->append("") && f->size() == 6, "bytes: an empty run adds nothing and is true", said(f));
+    check(f->append("line_2"), "bytes: append(\"line_2\")", said(f));
+    expect_all("bytes: ... line_1line_2", f, "line_1line_2");
+    check(f->insert(7, "X"), "bytes: insert(7, \"X\") goes in before byte 7", said(f));
+    expect_all("bytes: ... line_1Xline_2", f, "line_1Xline_2");
+    check(f->replace_line(7, "YY") && f->size() == 14, "bytes: replace(7, \"YY\"): byte 7 becomes two bytes", said(f));
+    expect_all("bytes: ... line_1YYline_2", f, "line_1YYline_2");
+    check(f->replace_text("line_2", "line_4"), "bytes: replace(\"line_2\", \"line_4\"): the first run", said(f));
+    expect_all("bytes: ... line_1YYline_4", f, "line_1YYline_4");
+    check(f->index_of("YY") == 7 && f->search("YY") == 7 && f->index_of("line_4") == 9 && f->search("4") == 14,
+          "bytes: index_of and search are the 1-based position where the run starts");
+    check(f->index_of("") == 0 && f->search("") == 0 && f->index_of("zzz") == 0 && !f->contains("zzz") && f->contains("1YYl"),
+          "bytes: an empty run is 0, an absent run is 0, contains is search != 0");
+    check(f->index_of("line_") == 1 && f->search("ine_4") == 10, "bytes: the FIRST run, counting from 1");
+    check(f->code() == success, "bytes: a question with no answer is not a failure", said(f));
+    check(f->remove("YY") && f->size() == 12, "bytes: remove(\"YY\") takes the run out", said(f));
+    expect_all("bytes: ... line_1line_4", f, "line_1line_4");
+    check(f->remove_at(1) && f->remove_first() && f->remove_last() && f->size() == 9, "bytes: remove_at(1), remove_first, remove_last",
+          said(f));
+    expect_all("bytes: ... ne_1line_", f, "ne_1line_");
+    check(f->truncate(4) && f->size() == 4 && f->truncate(9) && f->size() == 4, "bytes: truncate(4) keeps the first 4 bytes",
+          said(f));
+    check(f->first(out) && out == "n" && f->last(out) && out == "1", "bytes: first and last", out);
+    check(f->replace_line(1, "") && f->size() == 3, "bytes: replace(1, \"\") takes byte 1 out", said(f));
+    expect_all("bytes: ... e_1", f, "e_1");
+    check(!f->line(0, out) && f->code() == counts_from_one && contains_text(f->error(), "byte 0"),
+          "bytes: f[0] is counts_from_one, said as a byte", said(f));
+    check(!f->line(4, out) && f->code() == line_past_the_end && contains_text(f->error(), "byte 4") &&
+              contains_text(f->error(), "3 bytes"),
+          "bytes: f[size + 1] is line_past_the_end, said in bytes", said(f));
+    check(!f->insert(0, "x") && f->code() == counts_from_one && !f->insert(5, "x") && f->code() == line_past_the_end &&
+              f->insert(4, "zz") && f->size() == 5,
+          "bytes: insert(0) and insert(size + 2) false, insert(size + 1) appends", said(f));
+    check(!f->replace_text("", "x") && f->code() == empty_search_text && !f->replace_text("nope", "x") &&
+              f->code() == text_not_found && !f->remove("nope") && f->code() == text_not_found,
+          "bytes: an empty run to replace, and runs that are not there", said(f));
+    check(f->replace_text("zz", "") && f->size() == 3, "bytes: replace(run, \"\") takes the run out", said(f));
+    check(f->clear_lines() && f->size() == 0 && f->empty(), "bytes: clear: no bytes", said(f));
+    check(f->append("end") && f->close(), "bytes: append, close", said(f));
+    expect_bytes("bytes: the disk holds exactly those bytes", p, "end");
+    const Handle again = satellite_file::open_existing(p, Kind::binary);
+    check(again && again->ok() && again->size() == 3 && again->read_all() == "end" && again->line(2, out) && out == "n",
+          "bytes: read back: 3 bytes, read_all, byte 2", said(again));
+
+    // A 0x00 AND A 0xFF BYTE ARE BYTES.
+    const std::string z = at("zero.bin");
+    const std::string raw("\x00\xFF\x00", 3);
+    Handle g = satellite_file::make_new(z, Kind::binary);
+    check(g && g->append(raw) && g->size() == 3 && g->line(1, out) && out == std::string("\x00", 1) && g->line(2, out) &&
+              out == "\xFF",
+          "bytes: 0x00 and 0xFF are bytes, f[1] and f[2]", said(g));
+    check(g && g->index_of("\xFF") == 2 && g->search(std::string("\xFF\x00", 2)) == 2 && g->index_of(std::string("\x00", 1)) == 1,
+          "bytes: a run holding 0x00 and 0xFF is found");
+    check(g && g->close(), "bytes: close");
+    expect_bytes("bytes: the disk holds 00 FF 00", z, raw);
+    g = satellite_file::open_existing(z, Kind::text);
+    check(g && !g->ok() && g->code() == file_not_text && contains_text(g->error(), "0xFF"),
+          "a binary file opened as text is refused (file_not_text, naming the byte)", said(g));
+    g = satellite_file::open_existing(z, Kind::binary);
+    check(g && g->ok() && g->size() == 3, "... and opened as binary it is its 3 bytes", said(g));
+    check(g && g->close(), "bytes: close");
+
+    // A TEXT FILE OPENED AS BINARY IS ITS BYTES: a 2-byte character is 2 bytes, a \r is a byte.
+    const std::string t = at("text_as_bytes.txt");
+    put(t, "h\xC3\xA9llo\r\n");
+    g = satellite_file::open_existing(t, Kind::binary);
+    check(g && g->ok() && g->size() == 8 && g->line(2, out) && out == "\xC3" && g->line(7, out) && out == "\r",
+          "a text file opened as binary: 8 bytes, byte 2 is 0xC3, byte 7 is \\r", said(g));
+    put(at("lone_cr.bin"), "a\rb");
+    g = satellite_file::open_existing(at("lone_cr.bin"), Kind::binary);
+    check(g && g->ok() && g->size() == 3, "bytes: a lone \\r is a byte, not a refusal", said(g));
+
+    // THE APPEND FAST PATH ON BYTES: 100,000 appends of two bytes stream to the disk.
+    const std::string many = at("many.bin");
+    const Handle m = satellite_file::make_new(many, Kind::binary);
+    if (!m || !m->ok()) {
+        check(false, "bytes: 100,000 appends", said(m));
+        return;
+    }
+    const ino_t inode = inode_of(many);
+    std::string expected;
+    bool every = true;
+    bool streamed = false;
+    std::string at_50000;
+    for (int i = 1; i <= 100000; ++i) {
+        const char two[2] = {static_cast<char>('a' + i % 26), static_cast<char>(i & 0xFF)};
+        const std::string run(two, 2);
+        every = m->append(run) && every;
+        expected += run;
+        if (i == 50000) {
+            const std::string disk = bytes_of(many);
+            streamed = !disk.empty() && disk.size() < expected.size() && expected.compare(0, disk.size(), disk) == 0;
+            at_50000 = std::to_string(disk.size()) + " bytes on the disk of " + std::to_string(expected.size());
+        }
+    }
+    check(every && m->size() == 200000, "bytes: 100,000 appends: every one true, 200,000 bytes", said(m));
+    check(streamed, "bytes: 100,000 appends: past 64 KiB the bytes are on the disk before close", at_50000);
+    check(m->line(200000, out) && out == std::string(1, static_cast<char>(100000 & 0xFF)), "bytes: ... byte 200,000 while open",
+          shown(out));
+    check(m->close() && bytes_of(many) == expected && inode_of(many) == inode,
+          "bytes: 100,000 appends: close; the file holds every byte, never rewritten", said(m));
+    // THE PATTERN REPEATS every 3,328 appends, so the last ten bytes are first found much earlier:
+    // where std::string finds them.
+    const std::string last_ten = expected.substr(199990);
+    const Handle back = satellite_file::open_existing(many, Kind::binary);
+    check(back && back->size() == 200000 && back->line(1, out) && out == "b" &&
+              back->search(last_ten) == expected.find(last_ten) + 1 && back->search(expected.substr(100000, 50)) == 100001 - 6656 * 15,
+          "bytes: 100,000 appends: read back, byte 1, and a run found where std::string finds it", said(back));
+}
