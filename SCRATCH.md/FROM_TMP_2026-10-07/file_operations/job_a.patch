+// satellite/satellite_variable_file/file_cases_more.cpp -- the 2026-10-07 cases, run by
+// build/file_cases after the 2026-09-18 ones (file_cases.hpp):
+//
+//   FO-5  a handle opened to read refuses every change, and the file's bytes and mtime
+//         are what they were;
+//   FO-8  a binary file is a list of bytes: the author's example done in bytes, f[n] is
+//         byte n, a 0x00 and a 0xFF byte, runs found across the file, the append stream;
+//   FO-9  a big file (about 256 MB, written here and removed) walked, searched, edited
+//         at the top and near the end, saved, cut down, and saved again after a save the
+//         handle ran on its own -- with the process's RSS watched the whole way: it must
+//         stay under 64 MB above where it started, because the handle holds the index and
+//         the changes, never the file.
+//
+// THE BIG FILE TAKES A FEW SECONDS to write and to rewrite; the whole run stays well under
+// check.sh's 300 s.
+
+#include "file_cases.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
