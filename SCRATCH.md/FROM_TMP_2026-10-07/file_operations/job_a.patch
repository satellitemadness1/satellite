+// satellite/satellite_variable_file/file_runs.cpp -- the runs (file_runs.hpp says what each
+// method answers): how an item is found, read, moved into memory and taken out, the block
+// reader, and the cursor. satellite_file's methods decide WHAT to do; this file knows WHERE
+// the items are.
+//
+// A REFERENCE INTO `runs` NEVER OUTLIVES AN INSERT OR AN ERASE: every method here reads the
+// fields it needs into locals, changes the vector, and goes back in by index.
+//
+// NOTHING HERE SETS A CODE. A false answer means the disk is shorter than the image says --
+// a file something else cut while it was open -- and the caller turns that into
+// line_past_the_end, which is what reading a line that is not there is.
+
+#include "file_runs.hpp"
+
+#include <cerrno>
+#include <thread>
+#include <utility>
+
+#include <unistd.h>
+
+namespace satellite004 {
+namespace file_runs {
+
+void SpinLock::lock() noexcept
+{
+    while (taken_.test_and_set(std::memory_order_acquire))
+        std::this_thread::yield();
+}
+
+// ---------------------------------------------------------------------------
+// THE FIRST RUN, AND LETTING GO
+// ---------------------------------------------------------------------------
+
+void FileRuns::one_memory_run(std::vector<std::string> &&lines, std::vector<Ending> &&endings)
+{
+    release();
+    Run run;
+    run.lines = std::move(lines);
+    run.endings = std::move(endings);
+    total = run.lines.size();
+    runs.push_back(std::move(run));
+}
+
+void FileRuns::one_memory_run(std::string &&bytes)
+{
+    release();
+    Run run;
+    run.bytes = std::move(bytes);
+    total = run.bytes.size();
+    runs.push_back(std::move(run));
+}
+
+void FileRuns::one_disk_run(std::size_t count)
+{
+    runs.clear();
+    Run run;
+    run.on_disk = true;
+    run.begin = image.begin;
+    run.end = image.size;
+    run.first_line = 0;
+    run.count = count;
+    runs.push_back(std::move(run));
+    total = count;
+    image_changed();
+}
+
+void FileRuns::release() noexcept
+{
+    runs.clear();
+    total = 0;
+    if (image.fd >= 0)
+        ::close(image.fd);
+    image.fd = -1;
+    image.size = 0;
+    image.begin = 0;
+    image.unended = false;
+    std::vector<off_t>().swap(image.points);
+    image_changed();
+    std::string().swap(block_);
+}
+
+void FileRuns::image_changed() noexcept
+{
+    const SpinHold held(lock_);
+    cursor_.valid = false;
+    block_size_ = 0;
+}
+
+void FileRuns::forget_cursor() noexcept
+{
+    const SpinHold held(lock_);
+    cursor_.valid = false;
+}
+
+// ---------------------------------------------------------------------------
+// COUNTING
+// ---------------------------------------------------------------------------
+
+std::size_t FileRuns::items(const Run &run) const
+{
+    if (run.on_disk)
+        return run.count;
+    return kind == Kind::binary ? run.bytes.size() : run.lines.size();
+}
+
+bool FileRuns::any_on_disk() const
+{
+    for (const Run &run : runs)
+        if (run.on_disk)
+            return true;
+    return false;
+}
+
+std::size_t FileRuns::bytes_in_memory() const
+{
+    std::size_t sum = 0;
+    for (const Run &run : runs) {
+        if (run.on_disk)
+            continue;
+        if (kind == Kind::binary) {
+            sum += run.bytes.size();
+            continue;
+        }
+        for (std::size_t m = 0; m < run.lines.size(); ++m)
+            sum += run.lines[m].size() + ending_size(run.endings[m]);
+    }
+    return sum;
+}
+
+off_t FileRuns::bytes_in_all() const
+{
+    off_t sum = 0;
+    for (const Run &run : runs) {
+        if (run.on_disk) {
+            sum += run.end - run.begin;
+            if (unended_tail(run))
+                sum += static_cast<off_t>(ending_size(run.tail_ending));
+            continue;
+        }
+        if (kind == Kind::binary) {
+            sum += static_cast<off_t>(run.bytes.size());
+            continue;
+        }
+        for (std::size_t m = 0; m < run.lines.size(); ++m)
+            sum += static_cast<off_t>(run.lines[m].size() + ending_size(run.endings[m]));
+    }
+    return sum;
+}
+
+bool FileRuns::locate(std::size_t i, std::size_t &k, std::size_t &j) const
+{
+    std::size_t start = 0;
+    for (k = 0; k < runs.size(); ++k) {
+        const std::size_t count = items(runs[k]);
+        if (i < start + count) {
+            j = i - start;
+            return true;
+        }
+        start += count;
+    }
+    return false;
+}
+
+// ---------------------------------------------------------------------------
+// THE READER. Everything below the line is under lock_.
+// ---------------------------------------------------------------------------
+
+const char *FileRuns::block_at(off_t offset, std::size_t &available) const
+{
+    if (offset < 0 || offset >= image.size) {
+        available = 0;
+        return nullptr;
+    }
+    if (block_size_ > 0 && offset >= block_offset_ && offset < block_offset_ + static_cast<off_t>(block_size_)) {
+        const std::size_t at = static_cast<std::size_t>(offset - block_offset_);
+        available = block_size_ - at;
+        return block_.data() + at;
+    }
+    if (block_.size() < kReadBlock)
+        block_.resize(kReadBlock);
+    const std::size_t want = std::min<std::size_t>(kReadBlock, static_cast<std::size_t>(image.size - offset));
+    for (;;) {
+        const ssize_t got = ::pread(image.fd, &block_[0], want, offset);
+        if (got < 0 && errno == EINTR)
+            continue;
+        if (got <= 0) {
+            block_size_ = 0;
+            available = 0;
+            return nullptr;
+        }
+        block_offset_ = offset;
+        block_size_ = static_cast<std::size_t>(got);
+        available = block_size_;
+        return block_.data();
+    }
+}
+
+bool FileRuns::read_line_at(off_t offset, std::string &out, Ending &ending, off_t &next) const
+{
+    out.clear();
+    bool gathered = false;
+    for (;;) {
+        std::size_t available = 0;
+        const char *bytes = block_at(offset, available);
+        if (available == 0) {
+            if (!gathered)
+                return false;
+            ending = Ending::none;   // the last line, with no \n
+            next = offset;
+            return true;
+        }
+        const char *newline = static_cast<const char *>(std::memchr(bytes, '\n', available));
+        if (newline == nullptr) {
+            out.append(bytes, available);
+            gathered = true;
+            offset += static_cast<off_t>(available);
+            continue;
+        }
+        const std::size_t size = static_cast<std::size_t>(newline - bytes);
+        out.append(bytes, size);
+        next = offset + static_cast<off_t>(size) + 1;
+        if (!out.empty() && out.back() == '\r') {
+            out.pop_back();
+            ending = Ending::crlf;
+        } else {
+            ending = Ending::lf;
+        }
+        return true;
+    }
+}
+
+bool FileRuns::skip_lines(off_t &offset, std::size_t lines) const
+{
+    while (lines > 0) {
+        std::size_t available = 0;
+        const char *bytes = block_at(offset, available);
+        if (available == 0)
+            return false;
+        std::size_t at = 0;
+        while (lines > 0 && at < available) {
+            const char *newline = static_cast<const char *>(std::memchr(bytes + at, '\n', available - at));
+            if (newline == nullptr) {
+                at = available;
+                break;
+            }
+            at = static_cast<std::size_t>(newline - bytes) + 1;
+            --lines;
+        }
+        offset += static_cast<off_t>(at);
+    }
+    return true;
+}
+
+bool FileRuns::offset_of(std::size_t k, std::size_t j, off_t &offset) const
+{
+    const Run &run = runs[k];
+    if (kind == Kind::binary) {
+        offset = run.begin + static_cast<off_t>(j);
+        return true;
+    }
+    if (cursor_.valid && cursor_.run == k && cursor_.item == j) {
+        offset = cursor_.offset;
+        return true;
+    }
+    if (j == 0) {
+        offset = run.begin;
+        return true;
+    }
+    // THE NEAREST INDEX POINT AT OR BEFORE THE LINE, inside this run, then a scan forward --
+    // or the cursor, when it is behind the line and nearer than the point.
+    const std::size_t line = run.first_line + j;
+    const std::size_t point = line / kIndexEvery;
+    std::size_t skip = j;
+    offset = run.begin;
+    if (point < image.points.size() && point * kIndexEvery >= run.first_line) {
+        offset = image.points[point];
+        skip = line - point * kIndexEvery;
+    }
+    if (cursor_.valid && cursor_.run == k && cursor_.item < j && j - cursor_.item < skip) {
+        offset = cursor_.offset;
+        skip = j - cursor_.item;
+    }
+    return skip_lines(offset, skip);
+}
+
+bool FileRuns::read_disk_item(std::size_t k, std::size_t j, std::string &out, Ending &ending, off_t &offset,
+                              off_t &next) const
+{
+    if (!offset_of(k, j, offset))
+        return false;
+    if (kind == Kind::binary) {
+        std::size_t available = 0;
+        const char *bytes = block_at(offset, available);
+        if (available == 0)
+            return false;
+        out.assign(bytes, 1);
+        ending = Ending::none;
+        next = offset + 1;
+    } else if (!read_line_at(offset, out, ending, next)) {
+        return false;
+    }
+    cursor_.valid = true;
+    cursor_.run = k;
+    cursor_.item = j + 1;
+    cursor_.offset = next;
+    return true;
+}
+
+bool FileRuns::read_item(std::size_t k, std::size_t j, std::string &out, Ending &ending) const
+{
+    const Run &run = runs[k];
+    if (!run.on_disk) {
+        if (kind == Kind::binary) {
+            out.assign(1, run.bytes[j]);
+            ending = Ending::none;
+        } else {
+            out = run.lines[j];
+            ending = run.endings[j];
+        }
+        return true;
+    }
+    const SpinHold held(lock_);
+    off_t offset = 0, next = 0;
+    return read_disk_item(k, j, out, ending, offset, next);
+}
+
+// ---------------------------------------------------------------------------
+// CHANGING THE RUNS
+// ---------------------------------------------------------------------------
+
+bool FileRuns::split_run(std::size_t k, std::size_t j)
+{
+    off_t offset = 0;
+    {
+        const SpinHold held(lock_);
+        if (!offset_of(k, j, offset))
+            return false;
+        cursor_.valid = false;
+    }
+    Run rest;
+    rest.on_disk = true;
+    rest.begin = offset;
+    rest.end = runs[k].end;
+    rest.first_line = runs[k].first_line + j;
+    rest.count = runs[k].count - j;
+    rest.tail_ending = runs[k].tail_ending;
+    runs[k].end = offset;
+    runs[k].count = j;
+    runs[k].tail_ending = Ending::none;
+    runs.insert(runs.begin() + static_cast<std::ptrdiff_t>(k + 1), std::move(rest));
+    return true;
+}
+
+bool FileRuns::shrink_front(std::size_t k, std::size_t n)
+{
+    off_t offset = 0;
+    {
+        const SpinHold held(lock_);
+        if (!offset_of(k, n, offset))
+            return false;
+        cursor_.valid = false;
+    }
+    runs[k].begin = offset;
+    runs[k].first_line += n;
+    runs[k].count -= n;
+    return true;
+}
+
+bool FileRuns::shrink_back(std::size_t k, std::size_t n)
+{
+    off_t offset = 0;
+    {
+        const SpinHold held(lock_);
+        if (!offset_of(k, runs[k].count - n, offset))
+            return false;
+        cursor_.valid = false;
+    }
+    runs[k].end = offset;
+    runs[k].count -= n;
+    runs[k].tail_ending = Ending::none;   // its last line ends in the bytes now
+    return true;
+}
+
+void FileRuns::put_in_memory(std::size_t k, std::size_t j, std::string &&text, Ending ending)
+{
+    Run &run = runs[k];
+    if (kind == Kind::binary) {
+        run.bytes.insert(j, text);
+    } else {
+        run.lines.insert(run.lines.begin() + static_cast<std::ptrdiff_t>(j), std::move(text));
+        run.endings.insert(run.endings.begin() + static_cast<std::ptrdiff_t>(j), ending);
+    }
+}
+
+bool FileRuns::place_before(std::size_t i, std::size_t &k, std::size_t &j)
+{
+    if (i >= total) {
+        if (runs.empty() || runs.back().on_disk)
+            runs.emplace_back();
+        k = runs.size() - 1;
+        j = items(runs[k]);
+        return true;
+    }
+    if (!locate(i, k, j))
+        return false;
+    if (!runs[k].on_disk)
+        return true;
+    if (j == 0) {
+        if (k > 0 && !runs[k - 1].on_disk) {
+            --k;
+            j = items(runs[k]);
+            return true;
+        }
+        runs.emplace(runs.begin() + static_cast<std::ptrdiff_t>(k));
+        forget_cursor();
+        j = 0;
+        return true;
+    }
+    if (!split_run(k, j))
+        return false;
+    runs.emplace(runs.begin() + static_cast<std::ptrdiff_t>(k + 1));
+    ++k;
+    j = 0;
+    return true;
+}
+
+bool FileRuns::take_into_memory(std::size_t i, std::size_t &k, std::size_t &j)
+{
+    if (!locate(i, k, j))
+        return false;
+    if (!runs[k].on_disk)
+        return true;
+    std::string text;
+    Ending ending = Ending::none;
+    off_t offset = 0, next = 0;
+    {
+        const SpinHold held(lock_);
+        if (!read_disk_item(k, j, text, ending, offset, next))
+            return false;
+        cursor_.valid = false;
+    }
+    const std::size_t count = runs[k].count;
+    if (kind == Kind::text && ending == Ending::none)
+        ending = runs[k].tail_ending;   // the unended last line, as it was given one
+    if (count == 1) {
+        // THE WHOLE RUN GOES: onto the memory run before it, or before the one after, or it
+        // turns into a memory run where it is.
+        if (k > 0 && !runs[k - 1].on_disk) {
+            runs.erase(runs.begin() + static_cast<std::ptrdiff_t>(k));
+            --k;
+            j = items(runs[k]);
+        } else if (k + 1 < runs.size() && !runs[k + 1].on_disk) {
+            runs.erase(runs.begin() + static_cast<std::ptrdiff_t>(k));
+            j = 0;
+        } else {
+            runs[k] = Run();
+            j = 0;
+        }
+        put_in_memory(k, j, std::move(text), ending);
+        return true;
+    }
+    if (j == 0) {
+        runs[k].begin = next;
+        runs[k].first_line += 1;
+        runs[k].count -= 1;
+        if (k > 0 && !runs[k - 1].on_disk) {
+            --k;
+            j = items(runs[k]);
+        } else {
+            runs.emplace(runs.begin() + static_cast<std::ptrdiff_t>(k));
+            j = 0;
+        }
+        put_in_memory(k, j, std::move(text), ending);
+        return true;
+    }
+    if (j == count - 1) {
+        runs[k].end = offset;
+        runs[k].count -= 1;
+        runs[k].tail_ending = Ending::none;
+        if (!(k + 1 < runs.size() && !runs[k + 1].on_disk))
+            runs.emplace(runs.begin() + static_cast<std::ptrdiff_t>(k + 1));
+        ++k;
+        j = 0;
+        put_in_memory(k, 0, std::move(text), ending);
+        return true;
+    }
+    // THE MIDDLE: [0, j) stays, the item goes to a memory run between, [j + 1, count) follows.
+    Run rest;
+    rest.on_disk = true;
+    rest.begin = next;
+    rest.end = runs[k].end;
+    rest.first_line = runs[k].first_line + j + 1;
+    rest.count = count - j - 1;
+    rest.tail_ending = runs[k].tail_ending;
+    runs[k].end = offset;
+    runs[k].count = j;
+    runs[k].tail_ending = Ending::none;
+    runs.insert(runs.begin() + static_cast<std::ptrdiff_t>(k + 1), std::move(rest));
+    runs.emplace(runs.begin() + static_cast<std::ptrdiff_t>(k + 1));
+    ++k;
+    j = 0;
+    put_in_memory(k, 0, std::move(text), ending);
+    return true;
+}
+
+bool FileRuns::erase_items(std::size_t i, std::size_t count)
+{
+    while (count > 0) {
+        std::size_t k = 0, j = 0;
+        if (!locate(i, k, j))
+            return false;
+        const std::size_t have = items(runs[k]);
+        const std::size_t n = std::min(count, have - j);
+        if (!runs[k].on_disk) {
+            Run &run = runs[k];
+            if (kind == Kind::binary) {
+                run.bytes.erase(j, n);
+            } else {
+                run.lines.erase(run.lines.begin() + static_cast<std::ptrdiff_t>(j),
+                                run.lines.begin() + static_cast<std::ptrdiff_t>(j + n));
+                run.endings.erase(run.endings.begin() + static_cast<std::ptrdiff_t>(j),
+                                  run.endings.begin() + static_cast<std::ptrdiff_t>(j + n));
+            }
+            if (items(run) == 0)
+                runs.erase(runs.begin() + static_cast<std::ptrdiff_t>(k));
+        } else if (j == 0 && n == have) {
+            runs.erase(runs.begin() + static_cast<std::ptrdiff_t>(k));
+        } else if (j == 0) {
+            if (!shrink_front(k, n))
+                return false;
+        } else if (j + n == have) {
+            if (!shrink_back(k, n))
+                return false;
+        } else {
+            if (!split_run(k, j + n) || !shrink_back(k, n))
+                return false;
+        }
+        total -= n;
+        count -= n;
+    }
+    forget_cursor();
+    return true;
+}
+
+Run &FileRuns::memory_tail()
+{
+    if (runs.empty() || runs.back().on_disk)
+        runs.emplace_back();
+    return runs.back();
+}
+
+bool FileRuns::end_line_if_unended(std::size_t i, Ending ending)
+{
+    std::size_t k = 0, j = 0;
+    if (kind == Kind::binary || !locate(i, k, j))
+        return false;
+    Run &run = runs[k];
+    if (run.on_disk) {
+        if (j + 1 != run.count || !unended_tail(run) || run.tail_ending != Ending::none)
+            return false;
+        run.tail_ending = ending;
+        return true;
+    }
+    if (run.endings[j] != Ending::none)
+        return false;
+    run.endings[j] = ending;
+    return true;
+}
+
+void FileRuns::clear_items()
+{
+    runs.clear();
+    total = 0;
+    forget_cursor();
+}
+
+void FileRuns::append_bytes(const std::string &bytes)
+{
+    memory_tail().bytes.append(bytes);
+    total += bytes.size();
+}
+
+// ROOM FOR `more`, growing by doubling. reserve(size + 1) on every append would allocate
+// exactly one more each time and make a loop of appends quadratic (2026-09-18).
+template <typename Row>
+static void make_room(std::vector<Row> &rows, std::size_t more)
+{
+    const std::size_t needed = rows.size() + more;
+    if (needed > rows.capacity())
+        rows.reserve(std::max(needed, rows.capacity() * 2));
+}
+
+void FileRuns::put_lines(std::size_t k, std::size_t at, bool replacing, std::vector<std::string> &pieces,
+                         Ending ending, Ending last_ending)
+{
+    Run &run = runs[k];
+    const std::size_t count = pieces.size();
+    const std::size_t more = count - (replacing ? 1 : 0);
+    make_room(run.lines, more);
+    make_room(run.endings, more);
+    // NOTHING BELOW ALLOCATES: the room is made, and strings move without throwing.
+    std::size_t from = 0;
+    if (replacing) {
+        run.lines[at].swap(pieces[0]);
+        run.endings[at] = ending;
+        from = 1;
+    }
+    const auto at_line = run.lines.begin() + static_cast<std::ptrdiff_t>(at + from);
+    run.lines.insert(at_line, std::make_move_iterator(pieces.begin() + static_cast<std::ptrdiff_t>(from)),
+                     std::make_move_iterator(pieces.end()));
+    run.endings.insert(run.endings.begin() + static_cast<std::ptrdiff_t>(at + from), count - from, ending);
+    run.endings[at + count - 1] = last_ending;
+    total += more;
+}
+
+void FileRuns::append_line(std::string &&text, Ending ending)
+{
+    Run &tail = memory_tail();
+    make_room(tail.lines, 1);
+    make_room(tail.endings, 1);
+    tail.lines.push_back(std::move(text));
+    tail.endings.push_back(ending);
+    ++total;
+}
+
+void FileRuns::put_bytes(std::size_t k, std::size_t at, std::size_t replacing, const std::string &bytes)
+{
+    runs[k].bytes.replace(at, replacing, bytes);
+    total += bytes.size();
+    total -= replacing;
+}
