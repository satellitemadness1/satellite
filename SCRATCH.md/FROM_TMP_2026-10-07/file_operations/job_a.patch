+// ---------------------------------------------------------------------------
+// 12. A HANDLE OPENED TO READ (FO-5)
+// ---------------------------------------------------------------------------
+void read_only_handles()
+{
+    const std::string p = at("read_only.txt");
+    put(p, "a\nb\nc\n");
+    set_old_time(p);
+    const ino_t inode = inode_of(p);
+    Handle f = satellite_file::open_existing(p, Kind::text, true);
+    check(f && f->ok() && f->read_only() && f->size() == 3, "to read: opens, read_only() is true, 3 lines", said(f));
+    if (!f || !f->ok())
+        return;
+    std::string out;
+    check(f->line(2, out) && out == "b" && f->first(out) && out == "a" && f->last(out) && out == "c",
+          "to read: line, first and last answer", out);
+    check(f->index_of("b") == 2 && f->search("c") == 3 && f->contains("a") && !f->contains("z") && f->read_all() == "a\nb\nc\n",
+          "to read: index_of, search, contains and read_all answer");
+    check(f->code() == success, "to read: the questions set no code", said(f));
+    every_changing_method_refused(f, file_opened_to_read, "to read");
+    check(contains_text(f->error(), "opened to read") && contains_text(f->error(), p),
+          "to read: the error names the file and says it was opened to read", f->error());
+    check(f->save() && f->close() && !f->ok(), "to read: save() and close() are true and write nothing", said(f));
+    check(bytes_of(p) == "a\nb\nc\n" && has_old_time(p) && inode_of(p) == inode,
+          "to read: after close the bytes AND the mtime are what they were", shown(bytes_of(p)));
+    check(f->reopen() && f->ok() && f->read_only() && f->size() == 3, "to read: reopen() re-reads and the handle stays to read",
+          said(f));
+    check(!f->append("x") && f->code() == file_opened_to_read, "to read: ... and still refuses a change", said(f));
+    check(f->close(), "to read: close again");
+    {
+        const Handle g = satellite_file::open_existing(p, Kind::text, true);
+        check(g && g->ok() && g->line(1, out) && !g->append("x"), "to read: a handle let go unclosed", said(g));
+    }
+    check(bytes_of(p) == "a\nb\nc\n" && has_old_time(p), "to read: the destructor wrote nothing", shown(bytes_of(p)));
+
+    const Handle two = satellite_file::open_existing(p, Kind::text);
+    check(two && two->ok() && !two->read_only(), "the two-argument open opens to change (read_only() false)", said(two));
+    check(two && two->close(), "the two-argument open: close");
+
+    Handle missing = satellite_file::open_existing(at("read_only_missing.txt"), Kind::text, true);
+    check(missing && !missing->ok() && missing->code() == file_not_found && !there(at("read_only_missing.txt")),
+          "to read, a missing file: file_not_found, nothing made", said(missing));
+
+    const std::string b = at("read_only.bin");
+    put(b, std::string("\x00\x01\x02", 3));
+    set_old_time(b);
+    f = satellite_file::open_existing(b, Kind::binary, true);
+    check(f && f->ok() && f->read_only() && f->size() == 3 && f->line(3, out) && out == "\x02",
+          "to read, binary: opens, 3 bytes, byte 3", said(f));
+    every_changing_method_refused(f, file_opened_to_read, "to read, binary");
+    check(f && f->close() && bytes_of(b) == std::string("\x00\x01\x02", 3) && has_old_time(b),
+          "to read, binary: closed, the bytes and the mtime unchanged", said(f));
+}
