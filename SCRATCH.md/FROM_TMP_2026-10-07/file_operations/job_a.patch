+// ---------------------------------------------------------------------------
+// 14. THE BIG FILE (FO-9): the handle's memory does not grow with the file
+// ---------------------------------------------------------------------------
+void the_big_file()
+{
+    const std::string p = at("big.txt");
+    const std::size_t N = 19000000;   // "line_1" .. "line_19000000": about 255 MB
+    {
+        const int fd = ::open(p.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+        if (fd < 0) {
+            check(false, "big: writing the file", std::strerror(errno));
+            return;
+        }
+        std::string block;
+        block.reserve(1 << 20);
+        char text[32];
+        for (std::size_t n = 1; n <= N; ++n) {
+            const int size = std::snprintf(text, sizeof text, "line_%zu\n", n);
+            block.append(text, static_cast<std::size_t>(size));
+            if (block.size() >= (1u << 20) - 32) {
+                if (::write(fd, block.data(), block.size()) != static_cast<ssize_t>(block.size())) {
+                    check(false, "big: writing the file", std::strerror(errno));
+                    ::close(fd);
+                    return;
+                }
+                block.clear();
+            }
+        }
+        if (!block.empty() && ::write(fd, block.data(), block.size()) != static_cast<ssize_t>(block.size()))
+            check(false, "big: writing the file's end", std::strerror(errno));
+        ::close(fd);
+    }
+    const long long written = size_on_disk(p);
+    const long baseline = rss_kb();
+    // 64 MB ABOVE THE BASELINE THE WHOLE WAY. Under AddressSanitizer the budget is 320 MB more:
+    // its quarantine keeps freed memory (256 MB by default) resident, so the 66 MB of 1 MB
+    // lines freed below still count in RSS there, and that is the sanitizer's, not the handle's.
+    long budget = 64 * 1024;
+#if defined(__has_feature)
+#if __has_feature(address_sanitizer)
+    budget += 320 * 1024;
+    std::printf("note big: under AddressSanitizer the RSS budget is %ld MB (its quarantine keeps freed memory)\n",
+                budget / 1024);
+#endif
+#endif
+    long highest = baseline;
+    auto watch = [&] {
+        const long now = rss_kb();
+        if (now > highest)
+            highest = now;
+        return now - baseline < budget;
+    };
+    std::string out;
+    std::string expected;
+
+    auto started = std::chrono::steady_clock::now();
+    Handle f = satellite_file::open_existing(p, Kind::text);
+    const double opening = seconds_since(started);
+    check(f && f->ok() && f->size() == N, "big: opens, " + std::to_string(N) + " lines", said(f));
+    if (!f || !f->ok())
+        return;
+    check(watch(), "big: open holds the index, not the file: RSS " + kb_text(rss_kb() - baseline) + " above the start",
+          kb_text(highest - baseline));
+
+    started = std::chrono::steady_clock::now();
+    std::size_t wrong = 0;
+    for (std::size_t n = 1; n <= N; ++n) {
+        if (!f->line(n, out) || out.size() != 5 + std::to_string(n).size() || out.compare(5, std::string::npos, std::to_string(n)) != 0) {
+            if (wrong++ == 0)
+                expected = "line " + std::to_string(n) + " read as " + shown(out) + "; " + said(f);
+        }
+    }
+    const double walking = seconds_since(started);
+    check(wrong == 0, "big: walked by line(n) from 1 to size, every line right", expected);
+    check(watch(), "big: ... with RSS flat: " + kb_text(highest - baseline) + " above the start at most",
+          kb_text(rss_kb() - baseline));
+    std::printf("note big: timing: open %.3f s, walk of %zu lines %.3f s\n", opening, N, walking);
+
+    check(f->line(N, out) && out == "line_" + std::to_string(N) && f->line(1, out) && out == "line_1" &&
+              f->line(4096, out) && out == "line_4096" && f->line(4097, out) && out == "line_4097" && f->line(4098, out) &&
+              out == "line_4098" && f->line(N / 2, out) && out == "line_" + std::to_string(N / 2) && f->line(8193, out) &&
+              out == "line_8193",
+          "big: lines by number, backwards and forwards, around the index points", out);
+    check(!f->line(N + 1, out) && f->code() == line_past_the_end && f->line(N, out), "big: past the end, then the last again",
+          said(f));
+    started = std::chrono::steady_clock::now();
+    const std::size_t near_end = N - 1;
+    check(f->search("line_" + std::to_string(near_end)) == near_end && f->index_of("line_" + std::to_string(N)) == N &&
+              f->contains("line_7") && !f->contains("line_0") && f->search("ine_1000000") == 1000000,
+          "big: search and index_of find a line near the end, and the first that contains");
+    std::printf("note big: timing: three searches of the whole file %.3f s\n", seconds_since(started));
+    check(watch(), "big: the searches held nothing: RSS " + kb_text(highest - baseline) + " above the start at most");
+
+    // A LINE AT THE TOP AND ONE NEAR THE END, SAVED: the file is streamed to a new copy.
+    check(f->insert(1, "TOP") && f->size() == N + 1 && f->line(1, out) && out == "TOP" && f->line(2, out) && out == "line_1",
+          "big: insert(1, \"TOP\"): line 1 is TOP, line 2 is line_1", said(f));
+    check(f->replace_line(N, "NEAR_END") && f->line(N, out) && out == "NEAR_END" && f->line(N + 1, out) &&
+              out == "line_" + std::to_string(N),
+          "big: replace(N, \"NEAR_END\") near the end, the last line still the last", said(f));
+    check(f->search("NEAR_END") == N && f->index_of("TOP") == 1, "big: the edits are found where they went");
+    started = std::chrono::steady_clock::now();
+    check(f->save(), "big: save() streams the whole file", said(f));
+    const double saving = seconds_since(started);
+    const long long after = size_on_disk(p);
+    const long long expected_size = written + 4 + static_cast<long long>(std::strlen("NEAR_END\n")) -
+                                    static_cast<long long>(("line_" + std::to_string(near_end) + "\n").size());
+    check(after == expected_size, "big: the saved file is the old size + TOP + the replaced line",
+          std::to_string(after) + " bytes, not " + std::to_string(expected_size));
+    check(bytes_at(p, 0, 18) == "TOP\nline_1\nline_2\n", "big: the bytes at the top", shown(bytes_at(p, 0, 18)));
+    const std::string tail_wanted = "NEAR_END\nline_" + std::to_string(N) + "\n";
+    check(bytes_at(p, after - static_cast<long long>(tail_wanted.size()), tail_wanted.size()) == tail_wanted,
+          "big: the bytes at the end", shown(bytes_at(p, after - 40, 40)));
+    check(bytes_at(p, 4 + 7 * 9 + 8 * 90, 9) == "line_100\n", "big: the bytes in the middle", shown(bytes_at(p, 4 + 63 + 720, 9)));
+    check(watch(), "big: the save held nothing: RSS " + kb_text(highest - baseline) + " above the start at most");
+    std::printf("note big: timing: the full save %.3f s\n", saving);
+    check(f->line(1, out) && out == "TOP" && f->line(N + 1, out) && out == "line_" + std::to_string(N) && f->search("NEAR_END") == N,
+          "big: after the save the handle reads the new file", out);
+    check(leftovers(room).empty(), "big: no .saving. file is left");
+
+    // A SAVE ON ITS OWN: 66 MB of replacements pass the 64 MB budget, and the handle saves
+    // by itself; the next save() is an ordinary one.
+    const std::string wide(1024 * 1024, 'x');
+    const long long before_budget = size_on_disk(p);
+    bool replaced = true;
+    for (std::size_t k = 0; k < 66 && replaced; ++k)
+        replaced = f->replace_line(100 + k * 1000, wide);
+    // code() still holds the line_past_the_end set on purpose above (a later success never clears
+    // the last failure); what matters is that no save failed.
+    check(replaced && f->code() != file_unwritable, "big: 66 replacements of 1 MB each, and no save failed", said(f));
+    const long long after_budget = size_on_disk(p);
+    check(after_budget > before_budget + 64 * 1024 * 1024, "big: past the budget the handle saved on its own: the disk grew",
+          std::to_string(after_budget - before_budget) + " bytes more");
+    check(f->line(100, out) && out.size() == wide.size() && f->line(99, out) && out == "line_98",
+          "big: after the automatic save the lines read right", shown(out.substr(0, 20)));
+    check(f->replace_line(50, "FIFTY") && f->save() && bytes_at(p, 0, 4) == "TOP\n" && f->line(50, out) && out == "FIFTY",
+          "big: a save after the automatic save", said(f));
+    check(watch(), "big: the budget held: RSS " + kb_text(highest - baseline) + " above the start at most",
+          kb_text(rss_kb() - baseline));
+
+    // THE LAST LINE OUT, THEN CUT DOWN TO 1,000 LINES: small now, so held whole again.
+    check(f->remove_at(f->size()) && f->size() == N && f->last(out) && out == "NEAR_END", "big: remove_at of the last line",
+          said(f));
+    check(f->truncate(1000) && f->size() == 1000 && f->line(1000, out) && out == "line_999" && f->save(),
+          "big: truncate(1000), save", said(f));
+    // LINE k IS THE OLD line_(k - 1) since TOP went in at 1: line 50 was line_49, line 100 line_99.
+    expected = "TOP\n";
+    for (std::size_t n = 1; n <= 999; ++n)
+        expected += n == 49 ? std::string("FIFTY\n") : n == 99 ? wide + "\n" : "line_" + std::to_string(n) + "\n";
+    check(bytes_of(p) == expected, "big: the file is the 1,000 lines", std::to_string(size_on_disk(p)) + " bytes");
+    check(f->close() && !f->ok(), "big: close", said(f));
+    check(watch(), "big: RSS at the end " + kb_text(rss_kb() - baseline) + " above the start; the most was " +
+                       kb_text(highest - baseline));
+
+    // THE SAME BYTES AS A BINARY FILE, BIG: one run on the disk, byte n at its offset.
+    put(p, "");
+    {
+        const int fd = ::open(p.c_str(), O_WRONLY | O_TRUNC | O_CLOEXEC);
+        std::string block(1 << 20, 'b');
+        for (int k = 0; k < 5; ++k)
+            if (::write(fd, block.data(), block.size()) < 0)
+                check(false, "big binary: writing", std::strerror(errno));
+        ::close(fd);
+    }
+    const std::size_t size = 5u << 20;
+    f = satellite_file::open_existing(p, Kind::binary);
+    check(f && f->ok() && f->size() == size && f->line(size, out) && out == "b", "big binary: opens, 5 MB of bytes",
+          said(f));
+    check(f->append("TAIL") && f->search("bbTA") == size - 1 && f->index_of("TAIL") == size + 1,
+          "big binary: a run that starts on the disk and ends in memory is found", said(f));
+    check(f->replace_line(1, "") && f->insert(1, "HEAD") && f->size() == size + 7 && f->save(),
+          "big binary: byte 1 out, HEAD in, saved", said(f));
+    check(bytes_at(p, 0, 6) == "HEADbb" && bytes_at(p, static_cast<long long>(size) + 3, 4) == "TAIL" &&
+              size_on_disk(p) == static_cast<long long>(size) + 7,
+          "big binary: the bytes at both ends", shown(bytes_at(p, 0, 6)));
+    check(f->close() && watch(), "big binary: close; RSS " + kb_text(highest - baseline) + " above the start at most");
+    ::unlink(p.c_str());
+}
+
+} // namespace file_cases
