+// satellite/satellite_variable_file/file_saves.cpp -- THE DISK: the two saves, and what the
+// handle is after each. satellite_file.hpp says what save() promises.
+//
+// THE FAST PATH (save_appended) adds only what was appended since the last save, O_APPEND.
+// THE WHOLE PATH (save_whole) streams every run into .<name>.saving.<pid> beside the file --
+// a run on the disk copied in blocks, a run in memory written -- fsyncs it, keeps the mode
+// and the owner, renames it over the old file and fsyncs the folder: whole or not at all,
+// the old file untouched by any failure, a read-only file not got around by the rename.
+//
+// AFTER A SAVE THE FILE IS ONE RUN (FO-9): in memory when the whole file is up to
+// kWholeInMemory -- the small file, held as it always was -- and on the disk when it is
+// bigger, with a fresh index built while the bytes were written. So the memory the handle
+// holds goes back to nothing but the index whenever a big file is saved, and a loop that
+// appends for ever streams to the disk and holds at most 64 KiB.
+//
+// A SAVE ON ITS OWN (save_on_its_own): past kHeldBudget of held changes, or kMostRuns runs,
+// save() runs by itself. When it fails, the failure is kept in code() and error() as a
+// failed append write is, the change that asked for it still answers true, and the next
+// try is a budget further on -- not after every line.
+
+#include "satellite_file.hpp"
+
+#include "file_support.hpp"
+#include "../machine/machine_codes.hpp"
+
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+namespace satellite004 {
+
+using file_support::descriptor;
+using file_support::system_reason;
+using file_support::write_all;
+using file_runs::ending_bytes;
+using file_runs::ending_size;
+using file_runs::kIndexEvery;
+using file_runs::kWholeInMemory;
+using file_runs::Run;
+
+namespace {
+
+const char kByteOrderMark[] = "\xEF\xBB\xBF";
+constexpr std::size_t kByteOrderMarkSize = 3;
+constexpr std::size_t kWriteBuffer = 1024 * 1024;   // a full rewrite writes this much at a time
+
+} // namespace
+
+bool satellite_file::save()
+{
+    try {
+        if (!open_) {
+            fail(file_not_open, "save: " + path_ + " is not open");
+            return false;
+        }
+    } catch (...) {
+        out_of_memory(file_not_open);
+        return false;
+    }
+    if (read_only_ || !changed_)   // nothing can be pending on a handle opened to read
+        return true;
+    return only_appended_ ? save_appended() : save_whole();
+}
+
+void satellite_file::save_on_its_own()
+{
+    if (held_since_save_ <= save_after_ && runs_.runs.size() <= runs_after_)
+        return;
+    if (save())
+        return;
+    save_after_ = held_since_save_ + file_runs::kHeldBudget;
+    runs_after_ = runs_.runs.size() + file_runs::kMostRuns;
+}
+
+// THE FAST PATH: only what was appended since the last save (and the ending of the
+// disk's old last line, when it had none), added to the end. A write that fails
+// part way is cut back off, so the next save starts from the same place.
+bool satellite_file::save_appended() noexcept
+{
+    int fd = -1;
+    try {
+        std::string bytes;
+        bytes.reserve(pending_bytes_);
+        std::size_t ending_written = 0;
+        if (last_line_needs_ending_on_disk_ && saved_lines_ > 0) {
+            std::string text;
+            Ending ending = Ending::none;
+            std::size_t k = 0, j = 0;
+            if (runs_.locate(saved_lines_ - 1, k, j)) {
+                const Run &run = runs_.runs[k];
+                ending = run.on_disk ? run.tail_ending : run.endings[j];
+            }
+            bytes += ending_bytes(ending);
+            ending_written = ending_size(ending);
+        }
+        // THE PENDING ITEMS: in the only-appended state everything past the saved ones is in
+        // the memory tail, the last run.
+        if (saved_lines_ < runs_.total) {
+            std::size_t k = 0, j = 0;
+            if (!runs_.locate(saved_lines_, k, j) || runs_.runs[k].on_disk || k + 1 != runs_.runs.size()) {
+                fail(file_unwritable, "could not add to " + path_ + ": the appended lines are not where they should be");
+                return false;
+            }
+            const Run &tail = runs_.runs[k];
+            if (kind_ == Kind::binary) {
+                bytes.append(tail.bytes, j, std::string::npos);
+            } else {
+                for (std::size_t m = j; m < tail.lines.size(); ++m) {
+                    bytes += tail.lines[m];
+                    bytes += ending_bytes(tail.endings[m]);
+                }
+            }
+        }
+        fd = ::open(where_.c_str(), O_WRONLY | O_APPEND | O_CLOEXEC | O_NOCTTY | O_NONBLOCK);
+        if (fd < 0) {
+            const int why = errno;
+            fail(file_unwritable, "could not add to " + path_ + ": " + system_reason(why));
+            return false;
+        }
+        struct stat held {};
+        if (::fstat(fd, &held) != 0 || !S_ISREG(held.st_mode)) {
+            ::close(fd);
+            fd = -1;
+            fail(file_unwritable, "could not add to " + path_ + ": it is no longer a regular file");
+            return false;
+        }
+        int why = write_all(fd, bytes.data(), bytes.size());
+        if (why != 0) {
+            if (::ftruncate(fd, held.st_size) != 0) {
+                // the reason given is the write's; the file may keep a part of the new bytes
+            }
+            ::close(fd);
+            fd = -1;
+            fail(file_unwritable, "could not add to " + path_ + ": " + system_reason(why));
+            return false;
+        }
+        const int closed = ::close(fd);
+        why = errno;
+        fd = -1;
+        if (closed != 0 && why != EINTR) {
+            if (::truncate(where_.c_str(), held.st_size) != 0) {
+                // as above
+            }
+            fail(file_unwritable, "could not add to " + path_ + ": " + system_reason(why));
+            return false;
+        }
+        now_saved();
+        // THE WHOLE FILE IS ON THE DISK NOW: past kWholeInMemory it becomes one run there and
+        // the memory goes. A file this handle cannot open to read stays in memory, which is
+        // still right -- only bigger than it need be.
+        (void)after_appended_save(held.st_size + static_cast<off_t>(ending_written),
+                                  held.st_size + static_cast<off_t>(bytes.size()));
+        return true;
+    } catch (...) {
+        if (fd >= 0)
+            ::close(fd);
+        out_of_memory(file_unwritable);
+        return false;
+    }
+}
+
+// THE STRUCTURE AFTER THE FAST PATH. [disk][tail]: the disk run grows over the tail's bytes
+// and the index gains the tail's points. [memory, whole]: the memory run becomes the disk
+// run -- its items are exactly the disk's bytes, read from it or just written to it.
+bool satellite_file::after_appended_save(off_t tail_start, off_t new_size) noexcept
+{
+    try {
+        if (new_size <= kWholeInMemory)
+            return true;
+        const bool text = kind_ == Kind::text;
+        if (runs_.runs.size() == 2 && runs_.runs[0].on_disk && !runs_.runs[1].on_disk) {
+            const Run &tail = runs_.runs[1];
+            Run &disk = runs_.runs[0];
+            const std::size_t count = runs_.items(tail);
+            if (text) {
+                off_t at = tail_start;
+                for (std::size_t m = 0; m < count; ++m) {
+                    const std::size_t line = disk.first_line + disk.count + m;
+                    if (line % kIndexEvery == 0 && runs_.image.points.size() <= line / kIndexEvery)
+                        runs_.image.points.push_back(at);
+                    at += static_cast<off_t>(tail.lines[m].size() + ending_size(tail.endings[m]));
+                }
+            }
+            disk.end = new_size;
+            disk.count += count;
+            disk.tail_ending = Ending::none;
+            runs_.image.size = new_size;
+            runs_.image.unended = false;
+            runs_.runs.pop_back();
+            runs_.image_changed();
+            return true;
+        }
+        if (!runs_.holds_whole_file_in_memory())
+            return true;
+        const int fd = ::open(where_.c_str(), O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK);
+        if (fd < 0)
+            return false;
+        const Run &whole = runs_.runs[0];
+        const std::size_t count = runs_.items(whole);
+        std::vector<off_t> points;
+        bool unended = false;
+        const off_t begin = byte_order_mark_ ? static_cast<off_t>(kByteOrderMarkSize) : 0;
+        if (text) {
+            off_t at = begin;
+            for (std::size_t m = 0; m < count; ++m) {
+                if (m % kIndexEvery == 0)
+                    points.push_back(at);
+                at += static_cast<off_t>(whole.lines[m].size() + ending_size(whole.endings[m]));
+            }
+            unended = count > 0 && whole.endings.back() == Ending::none;
+        }
+        runs_.image.fd = fd;
+        runs_.image.size = new_size;
+        runs_.image.begin = begin;
+        runs_.image.unended = unended;
+        runs_.image.points = std::move(points);
+        runs_.one_disk_run(count);
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+// EVERY ITEM INTO ONE MEMORY RUN -- a file that is small after its changes is held whole,
+// as a small file is. False when the disk is shorter than it was. COPIED, NOT MOVED, out of
+// the memory runs: a gather that fails part way leaves the held changes as they were, and
+// what is gathered is at most kWholeInMemory.
+bool satellite_file::gather_into_memory()
+{
+    std::vector<std::string> lines;
+    std::vector<Ending> endings;
+    std::string bytes;
+    const bool text = kind_ == Kind::text;
+    if (text) {
+        lines.reserve(runs_.total);
+        endings.reserve(runs_.total);
+    }
+    for (std::size_t k = 0; k < runs_.runs.size(); ++k) {
+        const Run &run = runs_.runs[k];
+        if (!run.on_disk) {
+            if (text) {
+                for (std::size_t m = 0; m < run.lines.size(); ++m) {
+                    lines.push_back(run.lines[m]);
+                    endings.push_back(run.endings[m]);
+                }
+            } else {
+                bytes += run.bytes;
+            }
+            continue;
+        }
+        if (!text) {
+            if (!runs_.each_disk_block(run, [&](const char *piece, std::size_t size) {
+                    bytes.append(piece, size);
+                    return true;
+                }))
+                return false;
+            continue;
+        }
+        for (std::size_t m = 0; m < run.count; ++m) {
+            std::string line;
+            Ending ending = Ending::none;
+            if (!runs_.read_item(k, m, line, ending))
+                return false;
+            if (ending == Ending::none)
+                ending = run.tail_ending;
+            lines.push_back(std::move(line));
+            endings.push_back(ending);
+        }
+    }
+    if (text)
+        runs_.one_memory_run(std::move(lines), std::move(endings));
+    else
+        runs_.one_memory_run(std::move(bytes));
+    return true;
+}
+
+// ONE RUN ON THE DISK, the file just saved: the old descriptor goes, the new one is the image's.
+bool satellite_file::onto_the_disk(int fd, off_t size, bool unended, std::vector<off_t> &&points)
+{
+    const std::size_t count = runs_.total;
+    if (runs_.image.fd >= 0 && runs_.image.fd != fd)
+        ::close(runs_.image.fd);
+    runs_.image.fd = fd;
+    runs_.image.size = size;
+    runs_.image.begin = byte_order_mark_ ? static_cast<off_t>(kByteOrderMarkSize) : 0;
+    runs_.image.unended = unended;
+    runs_.image.points = std::move(points);
+    runs_.one_disk_run(count);
+    return true;
+}
+
+// THE WHOLE FILE, WHOLE OR NOT AT ALL: streamed to .<name>.saving.<pid> beside the real
+// file (the target, when the path is a symlink, so the link stays a link), fsync'd, given
+// the old file's permissions and renamed over it. Any failure removes the new copy and
+// leaves the old file as it was.
+bool satellite_file::save_whole() noexcept
+{
+    std::string temp;
+    bool made = false;
+    int fd = -1;
+    try {
+        auto give_up = [&](const std::string &reason) {
+            if (fd >= 0)
+                ::close(fd);
+            fd = -1;
+            if (made)
+                ::unlink(temp.c_str());
+            made = false;
+            fail(file_unwritable, reason);
+            return false;
+        };
+
+        // A SMALL RESULT IS GATHERED INTO ONE MEMORY RUN FIRST, and stays held after, as a
+        // small file is; a big one is written run by run and left on the disk.
+        const off_t whole = runs_.bytes_in_all() + (byte_order_mark_ ? static_cast<off_t>(kByteOrderMarkSize) : 0);
+        const bool small = whole <= kWholeInMemory;
+        if (small && !runs_.holds_whole_file_in_memory() && !gather_into_memory())
+            return give_up("could not save " + path_ + ": the file on the disk is shorter than when it was opened");
+
+        std::string real;
+        {
+            char *resolved = ::realpath(where_.c_str(), nullptr);
+            if (resolved == nullptr) {
+                const int why = errno;
+                return give_up("could not save " + path_ + ": " + system_reason(why));
+            }
+            try {
+                real = resolved;
+            } catch (...) {
+                std::free(resolved);
+                throw;
+            }
+            std::free(resolved);
+        }
+        struct stat about {};
+        if (::stat(real.c_str(), &about) != 0) {
+            const int why = errno;
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        }
+        if (!S_ISREG(about.st_mode))
+            return give_up("could not save " + path_ + ": it is no longer a regular file");
+        if (::faccessat(AT_FDCWD, real.c_str(), W_OK, AT_EACCESS) != 0) {
+            const int why = errno;
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        }
+
+        const std::size_t slash = real.rfind('/');   // realpath answers an absolute path
+        temp = real.substr(0, slash + 1) + "." + real.substr(slash + 1) + ".saving." + std::to_string(::getpid());
+        fd = ::open(temp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOCTTY, 0600);
+        if (fd < 0) {
+            const int why = errno;
+            return give_up("could not save " + path_ + ": could not make " + temp + " beside it: " + system_reason(why));
+        }
+        made = true;
+
+        // THE STREAM, AND THE NEW FILE'S INDEX built as it is written: every kIndexEvery-th
+        // line's offset, needed only when the file stays on the disk.
+        const bool index = !small && kind_ == Kind::text;
+        std::vector<off_t> points;
+        std::size_t lines = 0;
+        off_t written = 0;
+        int why = 0;
+        std::string buffer;
+        buffer.reserve(kWriteBuffer);
+        if (byte_order_mark_) {
+            buffer.append(kByteOrderMark, kByteOrderMarkSize);
+            written = static_cast<off_t>(kByteOrderMarkSize);
+        }
+        if (index)
+            points.push_back(written);
+        char last_byte = '\n';
+        auto put = [&](const char *bytes, std::size_t size) {
+            if (size == 0)
+                return true;
+            if (index) {
+                for (const char *n = static_cast<const char *>(std::memchr(bytes, '\n', size)); n != nullptr;
+                     n = static_cast<const char *>(std::memchr(n + 1, '\n', static_cast<std::size_t>(bytes + size - (n + 1))))) {
+                    if (++lines % kIndexEvery == 0)
+                        points.push_back(written + static_cast<off_t>(n - bytes) + 1);
+                }
+            }
+            buffer.append(bytes, size);
+            written += static_cast<off_t>(size);
+            last_byte = bytes[size - 1];
+            if (buffer.size() >= kWriteBuffer) {
+                why = write_all(fd, buffer.data(), buffer.size());
+                buffer.clear();
+                return why == 0;
+            }
+            return true;
+        };
+        for (const Run &run : runs_.runs) {
+            bool went = true;
+            if (run.on_disk) {
+                went = runs_.each_disk_block(run, [&](const char *bytes, std::size_t size) { return put(bytes, size); });
+                if (!went && why == 0)
+                    return give_up("could not save " + path_ + ": the file on the disk is shorter than when it was opened");
+            } else if (kind_ == Kind::binary) {
+                went = put(run.bytes.data(), run.bytes.size());
+            } else {
+                for (std::size_t m = 0; went && m < run.lines.size(); ++m)
+                    went = put(run.lines[m].data(), run.lines[m].size()) &&
+                           put(ending_bytes(run.endings[m]), ending_size(run.endings[m]));
+            }
+            if (!went)
+                return give_up("could not save " + path_ + ": " + system_reason(why));
+        }
+        why = write_all(fd, buffer.data(), buffer.size());
+        if (why != 0)
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        if (::fchmod(fd, about.st_mode & 07777) != 0) {
+            why = errno;
+            return give_up("could not save " + path_ + ": could not give the new copy the file's permissions: " +
+                           system_reason(why));
+        }
+        // THE OWNER TOO, WHEN IT CAN BE KEPT (only root can give a file away); a copy
+        // that cannot is still the user's own file, as any editor's would be.
+        struct stat mine {};
+        if (::fstat(fd, &mine) == 0 && (mine.st_uid != about.st_uid || mine.st_gid != about.st_gid)) {
+            if (::fchown(fd, about.st_uid, about.st_gid) != 0) {
+                // best effort, as above
+            }
+        }
+        if (::fsync(fd) != 0) {
+            why = errno;
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        }
+        const int closed = ::close(fd);
+        why = errno;
+        fd = -1;
+        if (closed != 0 && why != EINTR)
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        if (::rename(temp.c_str(), real.c_str()) != 0) {
+            why = errno;
+            return give_up("could not save " + path_ + ": " + system_reason(why));
+        }
+        made = false;
+
+        // THE RENAME ITSELF, TO THE DISK. Best effort: the new file is in place.
+        const std::string folder = slash == 0 ? std::string("/") : real.substr(0, slash);
+        const descriptor directory(::open(folder.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+        if (directory.get() >= 0 && ::fsync(directory.get()) != 0) {
+            // the save has landed; a folder that cannot be synced changes nothing here
+        }
+        now_saved();
+        if (!small) {
+            // THE FILE JUST WRITTEN IS THE IMAGE NOW. When it cannot be opened to read, the
+            // runs stay as they are: still right, read from the old image's descriptor,
+            // which holds the old file until the next save.
+            const int reading = ::open(real.c_str(), O_RDONLY | O_CLOEXEC | O_NOCTTY | O_NONBLOCK);
+            if (reading >= 0) {
+                const bool unended = kind_ == Kind::text && written > runs_.image.begin && last_byte != '\n';
+                onto_the_disk(reading, written, unended, std::move(points));
+            }
+        }
+        return true;
+    } catch (...) {
+        if (fd >= 0)
+            ::close(fd);
+        if (made)
+            ::unlink(temp.c_str());
+        out_of_memory(file_unwritable);
+        return false;
+    }
+}
