+// satellite/satellite_variable_file/file_scan.cpp -- the one pass over a text file's bytes.
+// file_scan.hpp says what it finds; this file says how.
+//
+// TWO SEARCHES A CHUNK, NOT ONE WALK A BYTE: the UTF-8 check skips ASCII eight bytes at a
+// time (the decoder's own trick), and the lines are found with memchr. A byte-at-a-time walk
+// that also looked for \n and \r was a third of the speed on ASCII text, which is the
+// likely text.
+
+#include "file_scan.hpp"
+
+#include "../machine/machine_codes.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+
+namespace satellite004 {
+namespace file_runs {
+
+namespace {
+
+// THE LENGTH A LEAD BYTE PROMISES: 0 for a byte that leads nothing -- a continuation byte,
+// C0, C1 (overlong), F5 and above (past U+10FFFF).
+int sequence_length(unsigned char b0)
+{
+    if (b0 < 0x80) return 1;
+    if (b0 < 0xC2) return 0;
+    if (b0 < 0xE0) return 2;
+    if (b0 < 0xF0) return 3;
+    if (b0 <= 0xF4) return 4;
+    return 0;
+}
+
+// Whether b[0, have) is a valid start of the sequence b[0] leads (Table 3-7: the second
+// byte's range depends on the first, which refuses overlongs, surrogates and anything above
+// U+10FFFF; the rest are 80..BF).
+bool prefix_ok(const unsigned char *b, int have)
+{
+    for (int k = 1; k < have; ++k) {
+        unsigned char low = 0x80, high = 0xBF;
+        if (k == 1) {
+            if (b[0] == 0xE0) low = 0xA0;
+            else if (b[0] == 0xED) high = 0x9F;
+            else if (b[0] == 0xF0) low = 0x90;
+            else if (b[0] == 0xF4) high = 0x8F;
+        }
+        if (b[k] < low || b[k] > high)
+            return false;
+    }
+    return true;
+}
+
+// THE FIRST BAD SEQUENCE in b[0, size): its offset, or size when there is none. `cut` is how
+// many bytes of a well-formed sequence the chunk's end cut off (0 when none).
+std::size_t first_bad(const unsigned char *b, std::size_t size, std::size_t &cut)
+{
+    cut = 0;
+    std::size_t at = 0;
+    while (at < size) {
+        if (b[at] < 0x80) {
+            while (size - at >= 8) {
+                std::uint64_t eight;
+                std::memcpy(&eight, b + at, 8);
+                if (eight & 0x8080808080808080ull)
+                    break;
+                at += 8;
+            }
+            while (at < size && b[at] < 0x80)
+                ++at;
+            continue;
+        }
+        const int length = sequence_length(b[at]);
+        if (length == 0)
+            return at;
+        const std::size_t have = std::min<std::size_t>(static_cast<std::size_t>(length), size - at);
+        if (!prefix_ok(b + at, static_cast<int>(have)))
+            return at;
+        if (have < static_cast<std::size_t>(length)) {
+            cut = have;
+            return size;
+        }
+        at += static_cast<std::size_t>(length);
+    }
+    return size;
+}
+
+std::string hex_byte(unsigned char byte)
+{
+    const char digits[] = "0123456789ABCDEF";
+    return std::string("0x") + digits[byte >> 4] + digits[byte & 0x0F];
+}
