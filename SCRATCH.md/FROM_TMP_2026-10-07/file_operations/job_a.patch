+// satellite/satellite_variable_file/file_search.cpp -- ASKING WHERE SOMETHING IS: index_of
+// and search over every item, in memory or on the disk, without holding the file.
+//
+// A LINE IS MATCHED WHOLE OR INSIDE ITSELF (text): index_of is the first line that IS the
+// text, search the first that CONTAINS it, and a line's text holds no newline, so neither
+// ever matches across a line ending. Matching on checked UTF-8 is character-exact: a valid
+// needle can only match where a character begins.
+//
+// BYTES HAVE NO INSIDE (binary, FO-8): index_of and search are the same question -- where
+// does the first run of these bytes start, counting from 1 -- and a run may start in one
+// piece of the file and end in the next, so the search carries the last size - 1 bytes of
+// each piece into the next one.
+
+#include "satellite_file.hpp"
+
+#include "../machine/machine_codes.hpp"
+
+#include <cstring>
+#include <string>
+
+namespace satellite004 {
+
+std::size_t satellite_file::index_of(const std::string &text) const
+{
+    try {
+        if (!usable())
+            return 0;
+        if (kind_ == Kind::binary)
+            return find_bytes(text);
+        std::size_t found = 0;
+        const std::size_t size = text.size();
+        const char *wanted = text.data();
+        runs_.each_item(0, [&](const char *bytes, std::size_t count, std::size_t index) {
+            if (count == size && std::memcmp(bytes, wanted, size) == 0) {
+                found = index + 1;
+                return false;
+            }
+            return true;
+        });
+        return found;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return 0;
+    }
+}
+
+std::size_t satellite_file::search(const std::string &text) const
+{
+    try {
+        if (!usable() || text.empty())
+            return 0;
+        if (kind_ == Kind::binary)
+            return find_bytes(text);
+        std::size_t found = 0;
+        const std::size_t size = text.size();
+        const char *wanted = text.data();
+        runs_.each_item(0, [&](const char *bytes, std::size_t count, std::size_t index) {
+            if (count >= size && ::memmem(bytes, count, wanted, size) != nullptr) {
+                found = index + 1;
+                return false;
+            }
+            return true;
+        });
+        return found;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return 0;
+    }
+}
+
+// THE 1-BASED POSITION WHERE THE FIRST RUN OF `needle` STARTS, or 0. An empty run is 0.
+std::size_t satellite_file::find_bytes(const std::string &needle) const
+{
+    const std::size_t size = needle.size();
+    if (size == 0 || runs_.total < size)
+        return 0;
+    std::size_t found = 0;
+    std::string carried;   // the last size - 1 bytes of what came before, then the piece
+    runs_.each_item(0, [&](const char *bytes, std::size_t count, std::size_t index) {
+        if (carried.empty()) {
+            const void *hit = ::memmem(bytes, count, needle.data(), size);
+            if (hit != nullptr) {
+                found = index + static_cast<std::size_t>(static_cast<const char *>(hit) - bytes) + 1;
+                return false;
+            }
+            if (size > 1)
+                carried.assign(bytes + count - std::min(size - 1, count), std::min(size - 1, count));
+            return true;
+        }
+        const std::size_t before = carried.size();
+        carried.append(bytes, count);
+        const void *hit = ::memmem(carried.data(), carried.size(), needle.data(), size);
+        if (hit != nullptr) {
+            found = index - before + static_cast<std::size_t>(static_cast<const char *>(hit) - carried.data()) + 1;
+            return false;
+        }
+        const std::size_t keep = std::min(size - 1, carried.size());
+        carried.erase(0, carried.size() - keep);
+        return true;
+    });
+    return found;
+}
+
+} // namespace satellite004
