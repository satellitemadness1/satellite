+#pragma once
+// satellite/satellite_variable_file/file_scan.hpp -- THE ONE PASS OVER A TEXT FILE'S BYTES,
+// chunk by chunk: strict UTF-8 (the decoder's Table 3-7, satellite_variable_string/
+// conversion_loops.hpp, checked here without decoding), no \r that ends no line, the lines
+// counted, the first ending, whether the last line has a \n, and the sparse index. The same
+// pass checks a small file read whole and a big file streamed in blocks (file_runs.hpp): one
+// rule for what text is, wherever the bytes came from. Built 2026-10-07 (FO-9).
+//
+// A REFUSAL NAMES THE LINE AND THE BYTE, as the line-by-line reader did before this
+// (2026-09-18): "line 2, the byte 0xFF at offset 0 in the line (offset 3 in the file)" --
+// the line counted from 1, the offsets from 0, a byte-order mark no part of line 1. The
+// FIRST problem in the file is the one named, in the order of the bytes.
+
+#include "file_runs.hpp"
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include <sys/types.h>
+
+namespace satellite004 {
+namespace file_runs {
+
+class TextScan {
+public:
+    // `begin` is where line 1 starts: 3 after a byte-order mark. `path` is for the refusal.
+    TextScan(const std::string &path, off_t begin);
+
+    // The next bytes of the file, in order. False when the text is refused: code() and
+    // reason() say why, and nothing more should be fed.
+    bool feed(const char *bytes, std::size_t size);
+    // The end of the file. A sequence cut by it, or a \r at it, is refused.
+    bool finish();
+
+    std::size_t lines() const { return lines_ + (unended_ ? 1 : 0); }
+    bool unended() const { return unended_; }
+    Ending first_ending() const { return first_ending_; }
+    std::vector<off_t> &points() { return points_; }   // points[k] is the offset of line k * kIndexEvery
+
+    signed long long int code() const { return code_; }
+    const std::string &reason() const { return reason_; }
+
+private:
+    void refuse_utf8(off_t at, unsigned char byte);
+    void refuse_return(off_t at);
+    void line_of(off_t at, std::size_t &line, off_t &line_start) const;
+
+    std::string path_;
+    off_t begin_ = 0;
+    off_t offset_ = 0;          // the file offset of the next byte fed
+    std::size_t lines_ = 0;     // lines ended by a \n so far
+    off_t line_start_ = 0;      // where the line being read began
+    unsigned char last_byte_ = 0;
+    bool unended_ = false;
+    Ending first_ending_ = Ending::lf;
+    bool have_first_ending_ = false;
+    std::vector<off_t> points_;
+    // A sequence cut by a chunk's end, finished with the next one's first bytes.
+    unsigned char carry_[4] = {};
+    int carried_ = 0;
+    off_t carry_offset_ = 0;
+    // A \r at a chunk's end: lone unless the next byte is \n.
+    bool return_pending_ = false;
+    off_t return_offset_ = 0;
+    // What the problem was, when one was found: the lines counted up to it, for the message.
+    const char *chunk_ = nullptr;   // the chunk being fed, for line_of
+    std::size_t chunk_size_ = 0;
+    signed long long int code_ = 0;
+    std::string reason_;
+};
+
+// TEXT ALREADY CHECKED, INTO LINES AND ENDINGS: '\n' ends a line and a '\r' just before it is
+// part of the ending; the piece after the last '\n' is a last line with no ending, when
+// there is one. "" is no lines; "\n" is one empty line.
+void split_checked_text(const char *bytes, std::size_t size, std::vector<std::string> &lines,
+                        std::vector<Ending> &endings);
