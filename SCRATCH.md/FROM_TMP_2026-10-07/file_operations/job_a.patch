+#pragma once
+// satellite/satellite_variable_file/file_runs.hpp -- A FILE AS A SEQUENCE OF RUNS, so a
+// handle's memory does not grow with the size of the file. SATELLITE_FILE_OPERATIONS FO-9,
+// built 2026-10-07 for DESIGN 1.2 ("no built-in limits").
+//
+// ONE STRUCTURE, TWO WAYS OF MAKING THE FIRST RUN. A file is a list of ITEMS -- lines for
+// "text", bytes for "binary" (FO-8, the same day) -- held as a sequence of RUNS. A run is
+// either ON THE DISK, a byte range of the file as it is on the disk with its item count, or
+// IN MEMORY, the items themselves: lines with their endings, or bytes. At open, a file up to
+// kWholeInMemory is read whole as ONE memory run -- the likely case (DESIGN 1.1), and
+// exactly the list of lines the class held before this; a bigger file is ONE disk run and
+// its sparse index. An edit splits a disk run at the item into [disk before][memory][disk
+// after], adjacent edits share the memory run, and appends go on a memory tail. A save puts
+// everything back on the disk and the file is one run again.
+//
+// THE SPARSE INDEX, text only: the byte offset of every kIndexEvery-th line of the file on
+// the disk, found in the one streaming pass at open that checks the text (file_scan.hpp).
+// Line n of a disk run is the nearest point and a scan forward; the reader remembers where
+// the last line it read ended, so a walk from 1 to size costs one line a step. A binary
+// file needs no index: byte n is at a known offset.
+//
+// THE READER IS SHARED BY EVERY NAME FOR THE FILE AND EVERY THREAD, and the author's lock
+// lets reading statements run at once (satellite_object/object_lock.hpp: a read waits only
+// for a write). So the block buffer and the cursor are under a lock of their own, taken
+// only on the disk path; the memory path has no shared scratch and takes nothing, as before.
+// A SPIN LOCK, NOT std::mutex: it is taken once a line, uncontended nearly always, and the
+// mutex's call costs more than the memchr the line needs.
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <sys/types.h>
+
+namespace satellite004 {
+namespace file_runs {
+
+enum class Ending { none, lf, crlf };
+enum class Kind { text, binary };
+
+// A FILE UP TO THIS MANY BYTES IS HELD WHOLE IN MEMORY, as one run. A choice of path and not a
+// limit on the user: the small file is the likely one, and it stays exactly as fast as it was.
+constexpr off_t kWholeInMemory = 4 * 1024 * 1024;
+// HELD CHANGES PAST THIS MANY BYTES SAVE ON THEIR OWN, so memory never grows without bound.
+constexpr std::size_t kHeldBudget = 64 * 1024 * 1024;
+// RUNS PAST THIS MANY SAVE ON THEIR OWN, for the same reason: a run is a hundred bytes, and
+// an item is found by a walk of the list.
+constexpr std::size_t kMostRuns = 16384;
+// THE DISK IS READ THIS MUCH AT A TIME.
+constexpr std::size_t kReadBlock = 256 * 1024;
+// ONE INDEX POINT EVERY THIS MANY LINES: 8 bytes a point, so a file of a hundred million
+// lines has an index of 200 KB, and a line is at most this many lines' scan from its point.
+constexpr std::size_t kIndexEvery = 4096;
+
+inline const char *ending_bytes(Ending ending)
+{
+    return ending == Ending::lf ? "\n" : ending == Ending::crlf ? "\r\n" : "";
+}
+
+inline std::size_t ending_size(Ending ending)
+{
+    return ending == Ending::crlf ? 2 : ending == Ending::lf ? 1 : 0;
+}
+
+// THE FILE AS IT IS ON THE DISK, read through one descriptor kept open while any run is on
+// the disk. `size` is the file as this handle knows it -- at open, after a save, after a
+// flushed append; bytes something else adds are not the file that was opened, and a file
+// something else cut short gives a short read, which is a line past the end, not a fault.
+struct DiskImage {
+    int fd = -1;
+    off_t size = 0;
+    off_t begin = 0;              // where item 1 starts: 3 after a byte-order mark, else 0
+    bool unended = false;         // text: the last line has no \n
+    std::vector<off_t> points;    // text: points[k] is the offset of line k * kIndexEvery, lines from 0
+};
+
+struct Run {
+    bool on_disk = false;
+    // ON THE DISK: its bytes, how many items they are, and (text) which line of the image its
+    // first one is. tail_ending is the ending its last line was GIVEN when something was put
+    // after it while the bytes had none -- the file's last line without a \n.
+    off_t begin = 0;
+    off_t end = 0;
+    std::size_t first_line = 0;
+    std::size_t count = 0;
+    Ending tail_ending = Ending::none;
+    // IN MEMORY: text as lines with their endings, row for row; binary as bytes.
+    std::vector<std::string> lines;
+    std::vector<Ending> endings;
+    std::string bytes;
+};
+
+// WHERE THE LAST READ ENDED: item `item` of run `run` starts at `offset` in the image.
+struct Cursor {
+    bool valid = false;
+    std::size_t run = 0;
+    std::size_t item = 0;
+    off_t offset = 0;
+};
+
+class SpinLock {
+public:
+    void lock() noexcept;
+    void unlock() noexcept { taken_.clear(std::memory_order_release); }
+
+private:
+    std::atomic_flag taken_ = ATOMIC_FLAG_INIT;
+};
+
+class SpinHold {
+public:
+    explicit SpinHold(SpinLock &lock) noexcept : lock_(lock) { lock_.lock(); }
+    ~SpinHold() { lock_.unlock(); }
+    SpinHold(const SpinHold &) = delete;
+    SpinHold &operator=(const SpinHold &) = delete;
+
+private:
+    SpinLock &lock_;
+};
+
+class FileRuns {
+public:
+    FileRuns() = default;
+    ~FileRuns() { release(); }
+    FileRuns(const FileRuns &) = delete;
+    FileRuns &operator=(const FileRuns &) = delete;
+
+    Kind kind = Kind::text;
+    std::vector<Run> runs;
+    DiskImage image;
+    std::size_t total = 0;   // items in every run
+
+    // THE TWO WAYS OF MAKING THE FIRST RUN. The image's fd, size, begin, unended and points
+    // are set by the caller before one_disk_run(). The lines (or bytes) given to one_memory_run
+    // are the whole file. Either way, what was held before is let go.
+    void one_memory_run(std::vector<std::string> &&lines, std::vector<Ending> &&endings);
+    void one_memory_run(std::string &&bytes);
+    void one_disk_run(std::size_t count);
+    // Every run and the descriptor let go (close, and a fresh read).
+    void release() noexcept;
+    // The image is a different file now (a save): the block held and the cursor are stale.
+    void image_changed() noexcept;
+    // The runs moved (one inserted or taken out): the cursor's run number is stale.
+    void forget_cursor() noexcept;
+
+    std::size_t items(const Run &run) const;
+    bool holds_whole_file_in_memory() const { return runs.size() == 1 && !runs[0].on_disk; }
+    bool any_on_disk() const;
+    // Items of memory runs, as bytes -- what a save has to write from memory.
+    std::size_t bytes_in_memory() const;
+    // Every byte the file has, as a save writes it: the byte-order mark excluded.
+    off_t bytes_in_all() const;
+
+    // ITEM i (counting from 0) -> run k, item j in it. False past the end.
+    bool locate(std::size_t i, std::size_t &k, std::size_t &j) const;
+    // THE TEXT OF ITEM j OF RUN k (the one byte, for binary) and its ending (lf/crlf from the
+    // bytes; none for an unended last line and for every byte). False when the disk is
+    // shorter than it was.
+    bool read_item(std::size_t k, std::size_t j, std::string &out, Ending &ending) const;
+
+    // EVERY ITEM FROM i ON, in order, as `visit(const char *bytes, std::size_t size, std::size_t
+    // index)` -- a line without its ending, or a BLOCK of bytes (binary: `size` bytes starting
+    // at item `index`). visit answers false to stop. Answers false when the disk ended early.
+    template <typename Visit>
+    bool each_item(std::size_t i, Visit &&visit) const;
+
+    // A MEMORY RUN WITH A PLACE BEFORE ITEM i: (k, j) such that inserting at row j of memory run
+    // k puts the new items before item i. i == total is the end. Splits a disk run when it must.
+    bool place_before(std::size_t i, std::size_t &k, std::size_t &j);
+    // ITEM i MOVED INTO MEMORY: (k, j) a memory run holding it, read from the disk when it was
+    // there. Its ending is the logical one: a disk run's tail_ending for an unended last line.
+    bool take_into_memory(std::size_t i, std::size_t &k, std::size_t &j);
+    // ITEMS [i, i + count) OUT.
+    bool erase_items(std::size_t i, std::size_t count);
+    // THE LAST RUN, IN MEMORY, for an append: made when the last one is on the disk.
+    Run &memory_tail();
+    // LINES INTO MEMORY RUN k: `pieces` go in at row `at`, over row `at` when replacing and
+    // before it when not, each ending in `ending` but the last, which ends in `last_ending`.
+    // The room is made first, so a failure part way changes nothing. total follows.
+    void put_lines(std::size_t k, std::size_t at, bool replacing, std::vector<std::string> &pieces, Ending ending,
+                   Ending last_ending);
+    // ONE LINE ON THE END (the likely append, with no list of pieces to make).
+    void append_line(std::string &&text, Ending ending);
+    // BYTES INTO MEMORY RUN k: `bytes` replace the `replacing` bytes at `at` (0: they go in
+    // before it). total follows.
+    void put_bytes(std::size_t k, std::size_t at, std::size_t replacing, const std::string &bytes);
+    // LINE i (text) GIVEN AN ENDING when it has none -- the file's old last line, once something
+    // is put after it: true when it changed.
+    bool end_line_if_unended(std::size_t i, Ending ending);
+    // Every item out; the image stays for the save.
+    void clear_items();
+    // BYTES ON THE END (binary's append).
+    void append_bytes(const std::string &bytes);
+    // Whether the disk run ends at the image's end with the image's unended last line.
+    bool unended_tail(const Run &run) const { return run.on_disk && run.end == image.size && image.unended; }
+    // THE DISK RUN'S BYTES, block by block, as `visit(const char *bytes, std::size_t size)`, the
+    // tail ending it was given included. For read_all and a full save.
+    template <typename Visit>
+    bool each_disk_block(const Run &run, Visit &&visit) const;
+
+private:
+    // THE BLOCK HOLDING `offset`: a pointer to its byte and how many follow it in the block, 0
+    // at the image's end or when the disk is shorter than it was. Under the lock.
+    const char *block_at(off_t offset, std::size_t &available) const;
+    // THE LINE STARTING AT `offset`: its text, its ending from the bytes, where the next one
+    // starts. False when nothing is there. Under the lock.
+    bool read_line_at(off_t offset, std::string &out, Ending &ending, off_t &next) const;
+    // `lines` LINES SKIPPED from `offset`. False when the disk ends first. Under the lock.
+    bool skip_lines(off_t &offset, std::size_t lines) const;
+    // THE OFFSET OF ITEM j OF DISK RUN k: text from the index and a scan, or the cursor;
+    // binary by arithmetic. Under the lock.
+    bool offset_of(std::size_t k, std::size_t j, off_t &offset) const;
+    // Item j of disk run k, with its offset and the next item's. Under the lock.
+    bool read_disk_item(std::size_t k, std::size_t j, std::string &out, Ending &ending, off_t &offset,
+                        off_t &next) const;
+    // DISK RUN k SPLIT AT ITEM j (0 < j < count): runs[k] keeps [0, j), runs[k + 1] is the rest.
+    bool split_run(std::size_t k, std::size_t j);
+    // Items [0, n) or [n, count) OF DISK RUN k OUT, from its front or its back.
+    bool shrink_front(std::size_t k, std::size_t n);
+    bool shrink_back(std::size_t k, std::size_t n);
+    void put_in_memory(std::size_t k, std::size_t j, std::string &&text, Ending ending);
+
+    mutable SpinLock lock_;
+    mutable Cursor cursor_;
+    mutable std::string block_;
+    mutable off_t block_offset_ = 0;
+    mutable std::size_t block_size_ = 0;
+};
+
+// ---------------------------------------------------------------------------
+// THE TEMPLATES
+// ---------------------------------------------------------------------------
+
+template <typename Visit>
+bool FileRuns::each_item(std::size_t i, Visit &&visit) const
+{
+    std::size_t k = 0, j = 0;
+    if (i >= total)
+        return true;
+    if (!locate(i, k, j))
+        return true;
+    std::size_t index = i;
+    for (; k < runs.size(); ++k, j = 0) {
+        const Run &run = runs[k];
+        if (!run.on_disk) {
+            if (kind == Kind::binary) {
+                if (j < run.bytes.size() && !visit(run.bytes.data() + j, run.bytes.size() - j, index))
+                    return true;
+                index += run.bytes.size() - j;
+                continue;
+            }
+            for (std::size_t m = j; m < run.lines.size(); ++m, ++index)
+                if (!visit(run.lines[m].data(), run.lines[m].size(), index))
+                    return true;
+            continue;
+        }
+        const SpinHold held(lock_);
+        off_t offset = 0;
+        if (!offset_of(k, j, offset))
+            return false;
+        if (kind == Kind::binary) {
+            while (offset < run.end) {
+                std::size_t available = 0;
+                const char *bytes = block_at(offset, available);
+                if (available == 0)
+                    return false;
+                const std::size_t size = std::min<std::size_t>(available, static_cast<std::size_t>(run.end - offset));
+                if (!visit(bytes, size, index))
+                    return true;
+                offset += static_cast<off_t>(size);
+                index += size;
+            }
+            continue;
+        }
+        // LINES STRAIGHT OUT OF THE BLOCK when one holds the whole line, gathered only when a
+        // line crosses a block.
+        std::string gathered;
+        for (std::size_t m = j; m < run.count; ++m, ++index) {
+            gathered.clear();
+            for (;;) {
+                std::size_t available = 0;
+                const char *bytes = block_at(offset, available);
+                if (available == 0) {
+                    if (gathered.empty())
+                        return false;   // the disk is shorter than it was
+                    offset = image.size;
+                    if (!visit(gathered.data(), gathered.size(), index))
+                        return true;
+                    break;
+                }
+                const char *newline = static_cast<const char *>(std::memchr(bytes, '\n', available));
+                if (newline == nullptr) {
+                    gathered.append(bytes, available);
+                    offset += static_cast<off_t>(available);
+                    continue;
+                }
+                std::size_t size = static_cast<std::size_t>(newline - bytes);
+                offset += static_cast<off_t>(size) + 1;
+                if (gathered.empty()) {
+                    if (size > 0 && bytes[size - 1] == '\r')
+                        --size;
+                    if (!visit(bytes, size, index))
+                        return true;
+                    break;
+                }
+                gathered.append(bytes, size);
+                if (!gathered.empty() && gathered.back() == '\r')
+                    gathered.pop_back();
+                if (!visit(gathered.data(), gathered.size(), index))
+                    return true;
+                break;
+            }
+        }
+    }
+    return true;
+}
+
+template <typename Visit>
+bool FileRuns::each_disk_block(const Run &run, Visit &&visit) const
+{
+    const SpinHold held(lock_);
+    off_t offset = run.begin;
+    while (offset < run.end) {
+        std::size_t available = 0;
+        const char *bytes = block_at(offset, available);
+        if (available == 0)
+            return false;
+        const std::size_t size = std::min<std::size_t>(available, static_cast<std::size_t>(run.end - offset));
+        if (!visit(bytes, size))
+            return false;
+        offset += static_cast<off_t>(size);
+    }
+    if (unended_tail(run) && run.tail_ending != Ending::none)
+        return visit(ending_bytes(run.tail_ending), ending_size(run.tail_ending));
+    return true;
+}
+
+} // namespace file_runs
+} // namespace satellite004
