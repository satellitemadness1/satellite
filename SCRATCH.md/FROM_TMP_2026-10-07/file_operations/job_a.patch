+} // namespace
+
+TextScan::TextScan(const std::string &path, off_t begin)
+    : path_(path), begin_(begin), offset_(begin), line_start_(begin)
+{
+    points_.push_back(begin);   // line 0 starts where the text does
+}
+
+// THE LINE `at` IS IN (from 1) and where that line starts: the lines counted before this
+// chunk, plus the newlines in the chunk before `at`.
+void TextScan::line_of(off_t at, std::size_t &line, off_t &line_start) const
+{
+    line = lines_ + 1;
+    line_start = line_start_;
+    if (chunk_ == nullptr || at < offset_)
+        return;   // before this chunk: the state as it was
+    const std::size_t in_chunk = static_cast<std::size_t>(at - offset_);
+    const char *from = chunk_;
+    const char *end = chunk_ + std::min(in_chunk, chunk_size_);
+    for (;;) {
+        const char *newline = static_cast<const char *>(std::memchr(from, '\n', static_cast<std::size_t>(end - from)));
+        if (newline == nullptr)
+            break;
+        ++line;
+        line_start = offset_ + static_cast<off_t>(newline - chunk_) + 1;
+        from = newline + 1;
+    }
+}
+
+void TextScan::refuse_utf8(off_t at, unsigned char byte)
+{
+    std::size_t line = 0;
+    off_t line_start = 0;
+    line_of(at, line, line_start);
+    code_ = file_not_text;
+    reason_ = path_ + " is not UTF-8 text: line " + std::to_string(line) + ", the byte " + hex_byte(byte) +
+              " at offset " + std::to_string(at - line_start) + " in the line (offset " + std::to_string(at) +
+              " in the file), starts no valid UTF-8 character";
+}
+
+void TextScan::refuse_return(off_t at)
+{
+    std::size_t line = 0;
+    off_t line_start = 0;
+    line_of(at, line, line_start);
+    code_ = file_not_text;
+    reason_ = path_ + " is not text 004 reads: line " + std::to_string(line) + " holds a \\r that is not followed by \\n (offset " +
+              std::to_string(at - line_start) + " in the line); 004 does not read files whose lines end in \\r alone";
+}
+
+bool TextScan::feed(const char *bytes, std::size_t size)
+{
+    const unsigned char *b = reinterpret_cast<const unsigned char *>(bytes);
+    chunk_ = bytes;
+    chunk_size_ = size;
+    std::size_t at = 0;
+
+    // A SEQUENCE CUT BY THE LAST CHUNK is finished with this one's first bytes. It began before
+    // every byte here, so it is the first problem when it is one.
+    if (carried_ > 0) {
+        const int length = sequence_length(carry_[0]);
+        while (carried_ < length && at < size)
+            carry_[carried_++] = b[at++];
+        if (!prefix_ok(carry_, carried_)) {
+            refuse_utf8(carry_offset_, carry_[0]);
+            return false;
+        }
+        if (carried_ < length) {   // this chunk was too small to finish it
+            if (size > 0)
+                last_byte_ = b[size - 1];
+            offset_ += static_cast<off_t>(size);
+            chunk_ = nullptr;
+            chunk_size_ = 0;
+            return true;
+        }
+        carried_ = 0;
+    }
+
+    // THE FIRST BAD UTF-8 AND THE FIRST LONE \r, as file offsets; the earlier one is the refusal.
+    std::size_t cut = 0;
+    const std::size_t bad = at + first_bad(b + at, size - at, cut);
+    off_t bad_at = bad < size ? offset_ + static_cast<off_t>(bad) : -1;
+    off_t lone_at = -1;
+    if (return_pending_) {
+        return_pending_ = false;
+        if (size > 0 && b[0] != '\n')
+            lone_at = return_offset_;
+    }
+    if (lone_at < 0) {
+        for (const char *r = static_cast<const char *>(std::memchr(bytes, '\r', size)); r != nullptr;
+             r = static_cast<const char *>(std::memchr(r + 1, '\r', static_cast<std::size_t>(bytes + size - (r + 1))))) {
+            const std::size_t p = static_cast<std::size_t>(r - bytes);
+            if (p + 1 < size) {
+                if (b[p + 1] != '\n') {
+                    lone_at = offset_ + static_cast<off_t>(p);
+                    break;
+                }
+            } else {
+                return_pending_ = true;
+                return_offset_ = offset_ + static_cast<off_t>(p);
+            }
+        }
+    }
+    if (bad_at >= 0 && (lone_at < 0 || bad_at < lone_at)) {
+        refuse_utf8(bad_at, b[bad]);
+        return false;
+    }
+    if (lone_at >= 0) {
+        refuse_return(lone_at);
+        return false;
+    }
+
+    // THE LINES: counted, the first ending noted, a point every kIndexEvery-th line.
+    for (const char *n = static_cast<const char *>(std::memchr(bytes, '\n', size)); n != nullptr;
+         n = static_cast<const char *>(std::memchr(n + 1, '\n', static_cast<std::size_t>(bytes + size - (n + 1))))) {
+        const std::size_t p = static_cast<std::size_t>(n - bytes);
+        if (!have_first_ending_) {
+            const unsigned char before = p > 0 ? b[p - 1] : last_byte_;
+            first_ending_ = before == '\r' ? Ending::crlf : Ending::lf;
+            have_first_ending_ = true;
+        }
+        ++lines_;
+        line_start_ = offset_ + static_cast<off_t>(p) + 1;
+        if (lines_ % kIndexEvery == 0)
+            points_.push_back(line_start_);
+    }
+    if (size > 0)
+        last_byte_ = b[size - 1];
+    if (cut > 0) {
+        std::memcpy(carry_, b + size - cut, cut);
+        carried_ = static_cast<int>(cut);
+        carry_offset_ = offset_ + static_cast<off_t>(size - cut);
+    }
+    offset_ += static_cast<off_t>(size);
+    chunk_ = nullptr;
+    chunk_size_ = 0;
+    return true;
+}
+
+bool TextScan::finish()
+{
+    chunk_ = nullptr;
+    chunk_size_ = 0;
+    if (carried_ > 0) {   // a sequence the file ends inside: bad at its first byte, as the decoder says
+        refuse_utf8(carry_offset_, carry_[0]);
+        return false;
+    }
+    if (return_pending_) {
+        refuse_return(return_offset_);
+        return false;
+    }
+    unended_ = offset_ > begin_ && last_byte_ != '\n';
+    return true;
+}
+
+void split_checked_text(const char *bytes, std::size_t size, std::vector<std::string> &lines,
+                        std::vector<Ending> &endings)
+{
+    std::size_t newlines = 0;
+    for (const char *n = static_cast<const char *>(std::memchr(bytes, '\n', size)); n != nullptr;
+         n = static_cast<const char *>(std::memchr(n + 1, '\n', static_cast<std::size_t>(bytes + size - (n + 1)))))
+        ++newlines;
+    lines.clear();
+    endings.clear();
+    lines.reserve(newlines + 1);
+    endings.reserve(newlines + 1);
+    std::size_t at = 0;
+    while (at < size) {
+        const char *newline = static_cast<const char *>(std::memchr(bytes + at, '\n', size - at));
+        std::size_t end = newline == nullptr ? size : static_cast<std::size_t>(newline - bytes);
+        Ending ending = newline == nullptr ? Ending::none : Ending::lf;
+        if (ending == Ending::lf && end > at && bytes[end - 1] == '\r') {
+            --end;
+            ending = Ending::crlf;
+        }
+        lines.emplace_back(bytes + at, end - at);
+        endings.push_back(ending);
+        at = newline == nullptr ? size : static_cast<std::size_t>(newline - bytes) + 1;
+    }
+}
