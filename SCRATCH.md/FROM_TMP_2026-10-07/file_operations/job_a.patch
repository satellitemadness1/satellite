+++ job_a/satellite/satellite_variable_file/file_edits.cpp	2026-10-07 13:13:42.309037391 -0400
@@ -0,0 +1,427 @@
+// satellite/satellite_variable_file/file_edits.cpp -- THE LIST OF LINES (OF BYTES): every
+// method of satellite_file that reads or changes an item. satellite_file.hpp says what each
+// answers; file_runs.hpp knows where the items are. The searches are file_search.cpp.
+//
+// EVERY CHANGE IS MADE WHERE THE ITEM IS: in a memory run it is the list's own edit, exactly
+// as before 2026-10-07; in a disk run the item (or the place before it) is first brought
+// into memory (take_into_memory, place_before), which splits the run around it, and the
+// change is then the same edit. The whole file is never read for a change.
+//
+// A BYTE IS AN ITEM (FO-8): for a binary file the same methods take and give runs of
+// bytes, and the std::string payloads are bytes, not text. The two kinds part only where
+// a line has something a byte has not -- an ending, and pieces made by \n.
+
+#include "satellite_file.hpp"
+
+#include "../machine/machine_codes.hpp"
+
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace satellite004 {
+
+using file_runs::ending_bytes;
+using file_runs::ending_size;
+using file_runs::Run;
+
+namespace {
+
+bool one_line(const std::string &text)
+{
+    return text.find('\n') == std::string::npos && text.find('\r') == std::string::npos;
+}
+
+} // namespace
+
+std::size_t satellite_file::size() const
+{
+    try {
+        return usable() ? runs_.total : 0;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return 0;
+    }
+}
+
+bool satellite_file::read_line(std::size_t n, std::string &out, Ending &ending) const
+{
+    if (n == 0 || n > runs_.total) {
+        out.clear();
+        past_the_end(n);
+        return false;
+    }
+    std::size_t k = 0, j = 0;
+    if (!runs_.locate(n - 1, k, j) || !runs_.read_item(k, j, out, ending)) {
+        // THE DISK IS SHORTER THAN IT WAS: something else cut the file after it was opened.
+        // A line that is not there any more is a line past the end, not a fault.
+        out.clear();
+        fail(line_past_the_end, item_word() + std::string(" ") + std::to_string(n) + " of " + path_ +
+                                    " is not on the disk any more: the file is shorter than when it was opened");
+        return false;
+    }
+    return true;
+}
+
+bool satellite_file::line(std::size_t n, std::string &out) const
+{
+    try {
+        if (!usable()) {
+            out.clear();
+            return false;
+        }
+        Ending ending = Ending::none;
+        return read_line(n, out, ending);
+    } catch (...) {
+        out.clear();
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::append(const std::string &text)
+{
+    try {
+        if (!changeable())
+            return false;
+        const std::size_t before = runs_.total;
+        std::size_t added = 0;   // the bytes the new items take on the disk
+        if (kind_ == Kind::binary) {
+            if (text.empty())
+                return true;   // an empty run adds nothing
+            runs_.append_bytes(text);
+            added = text.size();
+        } else if (one_line(text)) {
+            // THE LIKELY CASE, ONE LINE, with no list of pieces to make.
+            std::string copy(text);
+            runs_.append_line(std::move(copy), default_ending_);
+            added = text.size() + ending_size(default_ending_);
+        } else {
+            std::vector<std::string> pieces;
+            if (!take_lines(text, pieces))
+                return false;
+            for (const std::string &piece : pieces)
+                added += piece.size() + ending_size(default_ending_);
+            Run &tail = runs_.memory_tail();
+            runs_.put_lines(runs_.runs.size() - 1, runs_.items(tail), false, pieces, default_ending_, default_ending_);
+        }
+        // A LAST LINE WITH NO NEWLINE IS ENDED FIRST, so the new line is a line of its
+        // own. When that line is already on the disk, the next append-only save writes
+        // its ending before the new lines.
+        if (before > 0 && runs_.end_line_if_unended(before - 1, default_ending_)) {
+            added += ending_size(default_ending_);
+            if (before == saved_lines_)
+                last_line_needs_ending_on_disk_ = true;
+        }
+        changed_ = true;
+        if (only_appended_) {
+            pending_bytes_ += added;
+            // THE STREAM. The line is held whatever the write answers, so append is
+            // still true; a failed write is kept in code() and error().
+            if (pending_bytes_ > flush_after_ && !save_appended())
+                flush_after_ = pending_bytes_ + kFlushBytes;
+        } else {
+            // AFTER AN EDIT the appends are held for the rewrite, and count toward the budget.
+            held_since_save_ += added;
+            save_on_its_own();
+        }
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::insert(std::size_t n, const std::string &text)
+{
+    try {
+        if (!changeable())
+            return false;
+        const std::size_t total = runs_.total;
+        if (n == total + 1)
+            return append(text);
+        const std::string word(item_word());
+        if (n == 0) {   // S413
+            fail(counts_from_one, "insert: there is no " + word + " 0 in " + path_ + ": satellite counts from 1, not 0, "
+                                  "so a new " + word + " goes in at 1 (the top) to " + std::to_string(total + 1) +
+                                  " (the end)");
+            return false;
+        }
+        if (n > total) {
+            fail(line_past_the_end, "insert: " + std::to_string(n) + " is no place for a " + word + " in " + path_ +
+                                        ", which has " + std::to_string(total) + " " + word + "s: 1 to " +
+                                        std::to_string(total + 1) + " are");
+            return false;
+        }
+        std::size_t k = 0, j = 0;
+        if (kind_ == Kind::binary) {
+            if (text.empty())
+                return true;
+            if (!runs_.place_before(n - 1, k, j)) {
+                past_the_end(n);
+                return false;
+            }
+            runs_.put_bytes(k, j, 0, text);
+            edited(text.size());
+            return true;
+        }
+        std::vector<std::string> pieces;
+        if (!take_lines(text, pieces))
+            return false;
+        std::size_t added = 0;
+        for (const std::string &piece : pieces)
+            added += piece.size() + ending_size(default_ending_);
+        if (!runs_.place_before(n - 1, k, j)) {
+            past_the_end(n);
+            return false;
+        }
+        runs_.put_lines(k, j, false, pieces, default_ending_, default_ending_);
+        edited(added);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::replace_line(std::size_t n, const std::string &text)
+{
+    try {
+        if (!changeable())
+            return false;
+        if (n == 0 || n > runs_.total) {
+            past_the_end(n);
+            return false;
+        }
+        std::string current;
+        Ending own = Ending::none;
+        std::size_t k = 0, j = 0;
+        if (kind_ == Kind::binary) {
+            // BYTE n BECOMES THE RUN, of any length; an empty run takes it out.
+            if (text.size() == 1 && read_line(n, current, own) && current == text)
+                return true;   // the same byte: nothing to save
+            if (!runs_.take_into_memory(n - 1, k, j)) {
+                past_the_end(n);
+                return false;
+            }
+            runs_.put_bytes(k, j, 1, text);
+            edited(text.size());
+            return true;
+        }
+        if (one_line(text)) {
+            if (!read_line(n, current, own))
+                return false;
+            if (current == text)
+                return true;   // the same text: nothing to save
+            if (!runs_.take_into_memory(n - 1, k, j)) {
+                past_the_end(n);
+                return false;
+            }
+            std::string copy(text);
+            runs_.runs[k].lines[j].swap(copy);
+            edited(text.size());
+            return true;
+        }
+        // SEVERAL LINES: the last keeps line n's own ending, the rest take the file's.
+        std::vector<std::string> pieces;
+        if (!take_lines(text, pieces))
+            return false;
+        if (!runs_.take_into_memory(n - 1, k, j)) {
+            past_the_end(n);
+            return false;
+        }
+        std::size_t added = 0;
+        for (const std::string &piece : pieces)
+            added += piece.size() + ending_size(default_ending_);
+        runs_.put_lines(k, j, true, pieces, default_ending_, runs_.runs[k].endings[j]);
+        edited(added);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::replace_text(const std::string &from, const std::string &to)
+{
+    try {
+        if (!changeable())
+            return false;
+        if (from.empty()) {
+            fail(empty_search_text, "replace: the text to replace is empty, so there is nothing to replace");
+            return false;
+        }
+        std::size_t k = 0, j = 0;
+        if (kind_ == Kind::binary) {
+            const std::size_t at = find_bytes(from);
+            if (at == 0) {
+                fail(text_not_found, "replace: the bytes to replace are nowhere in " + path_);
+                return false;
+            }
+            if (from == to)
+                return true;   // found, and replacing it changes nothing
+            if (!runs_.erase_items(at - 1, from.size()) || (!to.empty() && !runs_.place_before(at - 1, k, j))) {
+                past_the_end(at);
+                return false;
+            }
+            if (!to.empty())
+                runs_.put_bytes(k, j, 0, to);
+            edited(to.size());
+            return true;
+        }
+        const std::size_t which = search(from);
+        if (which == 0) {
+            fail(text_not_found, "replace: the text to replace is in no line of " + path_);
+            return false;
+        }
+        if (from == to)
+            return true;
+        if (!runs_.take_into_memory(which - 1, k, j)) {
+            past_the_end(which);
+            return false;
+        }
+        std::string changed = runs_.runs[k].lines[j];
+        const std::size_t where = changed.find(from);
+        changed.replace(where, from.size(), to);   // once: what `to` brings is never looked at again
+        if (one_line(to)) {
+            runs_.runs[k].lines[j].swap(changed);
+            edited(to.size());
+            return true;
+        }
+        // `to` HOLDS A NEWLINE, so the line becomes several, as replace_line makes them.
+        std::vector<std::string> pieces;
+        if (!take_lines(changed, pieces))
+            return false;
+        std::size_t added = 0;
+        for (const std::string &piece : pieces)
+            added += piece.size() + ending_size(default_ending_);
+        runs_.put_lines(k, j, true, pieces, default_ending_, runs_.runs[k].endings[j]);
+        edited(added);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::remove_at(std::size_t n)
+{
+    try {
+        if (!changeable())
+            return false;
+        if (n == 0 || n > runs_.total) {
+            past_the_end(n);
+            return false;
+        }
+        if (!runs_.erase_items(n - 1, 1)) {
+            past_the_end(n);
+            return false;
+        }
+        edited(0);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::remove(const std::string &text)
+{
+    try {
+        if (!changeable())
+            return false;
+        if (kind_ == Kind::binary) {
+            const std::size_t at = find_bytes(text);
+            if (at == 0) {
+                fail(text_not_found, "remove: those bytes are nowhere in " + path_);
+                return false;
+            }
+            if (!runs_.erase_items(at - 1, text.size())) {
+                past_the_end(at);
+                return false;
+            }
+            edited(0);
+            return true;
+        }
+        const std::size_t n = index_of(text);
+        if (n == 0) {
+            fail(text_not_found, "remove: no line of " + path_ + " is exactly that text");
+            return false;
+        }
+        return remove_at(n);
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::truncate(std::size_t n)
+{
+    try {
+        if (!changeable())
+            return false;
+        if (n >= runs_.total)
+            return true;
+        if (!runs_.erase_items(n, runs_.total - n)) {
+            past_the_end(n + 1);
+            return false;
+        }
+        edited(0);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+bool satellite_file::clear_lines()
+{
+    try {
+        if (!changeable())
+            return false;
+        if (runs_.total == 0)
+            return true;
+        runs_.clear_items();
+        edited(0);
+        return true;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return false;
+    }
+}
+
+std::string satellite_file::read_all() const
+{
+    try {
+        if (!usable())
+            return std::string();
+        std::string all;
+        all.reserve(static_cast<std::size_t>(runs_.bytes_in_all()) + (byte_order_mark_ ? 3 : 0));
+        if (byte_order_mark_)
+            all.append("\xEF\xBB\xBF", 3);
+        for (const Run &run : runs_.runs) {
+            if (run.on_disk) {
+                runs_.each_disk_block(run, [&](const char *bytes, std::size_t size) {
+                    all.append(bytes, size);
+                    return true;
+                });
+                continue;
+            }
+            if (kind_ == Kind::binary) {
+                all += run.bytes;
+                continue;
+            }
+            for (std::size_t m = 0; m < run.lines.size(); ++m) {
+                all += run.lines[m];
+                all += ending_bytes(run.endings[m]);
+            }
+        }
+        return all;
+    } catch (...) {
+        out_of_memory(satellite004::error);
+        return std::string();
+    }
+}
