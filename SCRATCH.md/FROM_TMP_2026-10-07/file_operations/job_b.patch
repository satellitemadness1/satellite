+#!/bin/bash
+# satellite/race/file_race.sh -- the file race (SATELLITE_FILE_OPERATIONS FO-6):
+# satellite_file against plain C++ on the same 1,000,000 lines, three legs
+# (append, walk, read_all -- file_race.cpp says what each is). Seven runs in
+# each order; the fastest time of each side of each leg is compared. A run that
+# fails, or whose answers differ, stops the race with its exit status instead
+# of counting (number_race.sh's rule; the fault race.sh has, ERROR.md 9).
+#
+#     satellite/race/file_race.sh [build/file_race] [a folder to work in]
+#
+# The folder is $TMPDIR, or /tmp, when none is given; the race makes its own
+# folder inside it and removes it.
+cd "$(dirname "$0")/../.."
+race=${1:-build/file_race}
+folder=${2:-${TMPDIR:-/tmp}}
+best=("" "" "" "" "" "")
+for order in satellite-first cxx-first; do
+    for run in 1 2 3 4 5 6 7; do
+        output=$("$race" $order "$folder" 2>&1)
+        status=$?
+        read -a times <<<"$output"
+        if [ $status -ne 0 ] || [ ${#times[@]} -ne 6 ]; then
+            echo "run failed (exit $status): $output"
+            exit 1
+        fi
+        for i in 0 1 2 3 4 5; do
+            if ! [[ "${times[$i]}" =~ ^[0-9]+$ ]]; then
+                echo "run failed (exit $status): $output"
+                exit 1
+            fi
+            if [ -z "${best[$i]}" ] || [ "${times[$i]}" -lt "${best[$i]}" ]; then best[$i]=${times[$i]}; fi
+        done
+    done
+done
+python3 -c "
+n = 1000000
