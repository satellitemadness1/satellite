+// code the row pins.
+satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
+{
+    // 1. names that are not letters: punctuation only (a legal name on Linux, so it is made),
+    //    the empty path, the folder itself, and / (the program's own folder, never a file).
+    satellite.variable.file punctuation = satellite.file.new("!@#$%^&*()")
+    satellite.console.display("punctuation " + punctuation.ok + " " + punctuation.append("made") + " " + punctuation.close() + " " + satellite.file.exists("!@#$%^&*()"))
+    satellite.console.display("empty " + satellite.file.new("").ok + " " + satellite.file.open("").ok + " " + satellite.file.exists("") + " " + satellite.file.clear(""))
+    satellite.console.display("dots " + satellite.file.new(".").ok + " " + satellite.file.open("..").ok + " " + satellite.file.exists(".") + " " + satellite.file.clear(".") + " " + satellite.file.open("/").ok)
+
+    // 2. a path 5,000 bytes long, built by a loop of string +
+    satellite.variable.string long = ""
+    satellite.statement.for(satellite.variable.number i = 1; i < 501; i + 1)
+    {
+        long = long + "0123456789"
+    }
+    satellite.console.display("long " + long.size + " " + satellite.file.new(long).ok + " " + satellite.file.open(long).ok + " " + satellite.file.exists(long) + " " + satellite.file.clear(long))
+
+    // 3. a directory as the file
+    satellite.console.display("directory " + satellite.file.new("a_dir").ok + " " + satellite.file.open("a_dir").ok + " " + satellite.file.clear("a_dir") + " " + satellite.file.exists("a_dir"))
+
+    // 4. a symlink to a file: opens as the file it points at, and a save follows the link
+    satellite.variable.file link = satellite.file.open("link.se")
+    satellite.console.display("link " + link.ok + " " + link[1] + " " + link.size + " " + link.append("through the link") + " " + link.close() + " " + satellite.file.exists("link.se"))
+
+    // 5. a symlink to a directory, and 6. a dangling one (new must not make its target)
+    satellite.console.display("directory_link " + satellite.file.new("dir_link").ok + " " + satellite.file.open("dir_link").ok + " " + satellite.file.exists("dir_link") + " " + satellite.file.clear("dir_link"))
+    satellite.console.display("dangling " + satellite.file.new("dangling.se").ok + " " + satellite.file.open("dangling.se").ok + " " + satellite.file.exists("dangling.se") + " " + satellite.file.clear("dangling.se"))
+
+    // 7. a file nobody may read (chmod 000): a regular file that is there, and will not open
+    satellite.console.display("unreadable " + satellite.file.open("unreadable.se").ok + " " + satellite.file.exists("unreadable.se"))
+
+    // 8. bytes that are not UTF-8, opened as text, and 9. a file whose lines end in \r alone
+    satellite.console.display("not_text " + satellite.file.open("not_text.se").ok + " " + satellite.file.exists("not_text.se"))
+    satellite.console.display("cr_only " + satellite.file.open("cr_only.se").ok + " " + satellite.file.exists("cr_only.se"))
+
+    // 10. a byte-order mark: the file opens, and line 1 has no mark
+    satellite.variable.file bom = satellite.file.open("bom.se")
+    satellite.console.display("bom " + bom.ok + " " + bom[1] + " " + bom.size + " " + (bom[1] == "line one") + " " + bom[1].size + " " + bom.append("three") + " " + bom.close())
+
+    // 11. a FIFO given to new, open, exists and clear: never a file, and never a wait
+    satellite.console.display("fifo " + satellite.file.new("fifo.se").ok + " " + satellite.file.open("fifo.se").ok + " " + satellite.file.exists("fifo.se") + " " + satellite.file.clear("fifo.se"))
+
+    // 12. machine code as a LINE and as a PATH: "UAWAVAUATS" is the first ten bytes of
+    //     build/satl's own text (objdump -d: 55 41 57 41 56 41 55 41 54 53, push %rbp; push
+    //     %r15 ...). It is data: read back equal, and a legal name on the disk.
+    satellite.variable.file code = satellite.file.new("code.se")
+    satellite.console.display("machine_code_line " + code.append("UAWAVAUATS") + " " + (code[1] == "UAWAVAUATS") + " " + code[1] + " " + code.size + " " + code.close())
+    satellite.variable.file named = satellite.file.new("UAWAVAUATS")
+    satellite.console.display("machine_code_path " + named.ok + " " + named.append("data") + " " + named.close() + " " + satellite.file.exists("UAWAVAUATS"))
+
+    // 13. empty text given to the methods that look for text
+    satellite.variable.file again = satellite.file.open("code.se")
+    satellite.console.display("empty_text " + again.replace("", "x") + " " + again.index_of("") + " " + again.search("") + " " + again.contains("") + " " + again.remove("") + " " + again.size)
+
+    // 14. a 4-byte character never matches half of one: 𝄞 is F0 9D 84 9E and 𝄢 is F0 9D 84 A2
+    satellite.variable.file wide = satellite.file.new("wide.se")
+    wide.append("clef 𝄞 here")
+    satellite.console.display("wide " + wide.search("𝄞") + " " + wide.search("𝄢") + " " + wide.index_of("clef 𝄞 here") + " " + wide.contains("𝄞") + " " + wide.replace("𝄢", "x") + " " + wide.replace("𝄞", "𝄢") + " " + wide[1])
+
+    // 15. new over a file that is there: refused, and its bytes are untouched (the row compares)
+    satellite.console.display("keep " + satellite.file.new("keep.se").ok + " " + satellite.file.exists("keep.se"))
