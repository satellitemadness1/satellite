+// satellite/race/file_race.cpp -- the file race (SATELLITE_FILE_OPERATIONS FO-6):
+// satellite_file against plain C++ doing the same work on the same bytes,
+// 1,000,000 lines of text. The author's bar is x1.05 of C++ (DESIGN 1.1).
+//
+//     build/file_race <satellite-first|cxx-first> <a folder to work in>
+//
+// prints six numbers on stderr, nanoseconds, "<append satl> <append c++> <walk
+// satl> <walk c++> <read_all satl> <read_all c++>", and exits 0 only when every
+// leg's answers agree. A run whose answers differ exits 2, and file_race.sh stops
+// on it instead of counting it (number_race.sh's rule; the fault race.sh has,
+// ERROR.md 9). It writes only inside one fresh folder, made in the folder it is
+// given and removed at the end, as file_cases does.
+//
+// THE THREE LEGS, each side its own function that is never inlined into main,
+// so neither side sees the other's state:
+//
+//     append    make_new + append x 1,000,000 + close     vs  fopen + fwrite the same lines + fclose
+//     walk      open_existing + line(n), n = 1..size      vs  std::ifstream + std::getline
+//     read_all  open_existing + read_all                  vs  fopen + fread into one std::string
+//
+// Both sides of a leg build each line's text the same way ("line_<n>"), so the
+// making of the text costs the same on both. The walk and the read_all read the
+// file satellite_file wrote, so both sides read the very same bytes. Within a
+// leg the order is the argument's, because going first can cost a few percent.
+//
+// WHAT AGREEING MEANS: after the append, the two files hold the same bytes
+// (compared whole, outside the timing); after the walk, the same line count and
+// the same sum of lengths; after the read_all, the same string.
+
+#include "../satellite_variable_file/satellite_file.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <ftw.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+using namespace satellite004;
+
+namespace {
+
+using clock_type = std::chrono::steady_clock;
+using Kind = satellite_file::Kind;
+
+constexpr long long kLines = 1000000;
+
+long long nanoseconds_since(clock_type::time_point start)
+{
+    return (long long)std::chrono::duration_cast<std::chrono::nanoseconds>(clock_type::now() - start).count();
+}
+
+std::string line_text(long long n)
+{
+    return "line_" + std::to_string(n);
+}
+
+// Every leg answers through its arguments: `ok` is false when the work itself
+// failed (a refused append, a line that could not be read), which is a failed run,
+// not a slow one.
+
+// ---------------------------------------------------------------------------
+// APPEND
+// ---------------------------------------------------------------------------
+[[gnu::noinline]] void append_satellite(const std::string &path, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::shared_ptr<satellite_file> f = satellite_file::make_new(path, Kind::text);
+    ok = f && f->ok();
+    for (long long n = 1; ok && n <= kLines; n++)
+        ok = f->append(line_text(n));
+    ok = f && f->close() && ok;
+    ns = nanoseconds_since(start);
+}
+
+[[gnu::noinline]] void append_cxx(const std::string &path, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::FILE *f = std::fopen(path.c_str(), "w");
+    ok = f != nullptr;
+    for (long long n = 1; ok && n <= kLines; n++) {
+        const std::string text = line_text(n);
+        ok = std::fwrite(text.data(), 1, text.size(), f) == text.size() && std::fputc('\n', f) != EOF;
+    }
+    ok = f != nullptr && std::fclose(f) == 0 && ok;
+    ns = nanoseconds_since(start);
+}
+
+// ---------------------------------------------------------------------------
+// WALK: every line in order, the count and the sum of the lengths
+// ---------------------------------------------------------------------------
+[[gnu::noinline]] void walk_satellite(const std::string &path, long long &count, long long &sum, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::shared_ptr<satellite_file> f = satellite_file::open_existing(path, Kind::text);
+    ok = f && f->ok();
+    count = 0;
+    sum = 0;
+    if (ok) {
+        const std::size_t size = f->size();
+        std::string text;
+        for (std::size_t n = 1; ok && n <= size; n++) {
+            ok = f->line(n, text);
+            sum += (long long)text.size();
+            ++count;
+        }
+    }
+    ns = nanoseconds_since(start);
+}
+
+[[gnu::noinline]] void walk_cxx(const std::string &path, long long &count, long long &sum, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::ifstream in(path);
+    ok = in.is_open();
+    count = 0;
+    sum = 0;
+    std::string text;
+    while (ok && std::getline(in, text)) {
+        sum += (long long)text.size();
+        ++count;
+    }
+    ns = nanoseconds_since(start);
+}
+
+// ---------------------------------------------------------------------------
+// READ_ALL: the whole file as one string
+// ---------------------------------------------------------------------------
+[[gnu::noinline]] void read_all_satellite(const std::string &path, std::string &whole, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::shared_ptr<satellite_file> f = satellite_file::open_existing(path, Kind::text);
+    ok = f && f->ok();
+    if (ok)
+        whole = f->read_all();
+    ns = nanoseconds_since(start);
+}
+
+[[gnu::noinline]] void read_all_cxx(const std::string &path, std::string &whole, bool &ok, long long &ns)
+{
+    const clock_type::time_point start = clock_type::now();
+    std::FILE *f = std::fopen(path.c_str(), "rb");
+    ok = f != nullptr;
+    if (ok) {
+        struct stat about {};
+        ok = ::fstat(::fileno(f), &about) == 0;
+        if (ok) {
+            whole.resize((std::size_t)about.st_size);
+            ok = std::fread(&whole[0], 1, whole.size(), f) == whole.size();
+        }
+        std::fclose(f);
+    }
+    ns = nanoseconds_since(start);
+}
+
+// ---------------------------------------------------------------------------
+// THE CHECKS, outside every timing
+// ---------------------------------------------------------------------------
+std::string bytes_of(const std::string &path)
+{
+    std::string whole;
+    bool ok = false;
+    long long ns = 0;
+    read_all_cxx(path, whole, ok, ns);
+    return ok ? whole : std::string();
+}
+
+int remove_one(const char *path, const struct stat *, int, struct FTW *)
+{
+    return ::remove(path);
+}
+
+int failed(const char *what)
+{
+    std::fprintf(stderr, "file_race: %s\n", what);
+    return 2;
+}
+
+} // namespace
+
+int main(int argc, char **argv)
+{
+    if (argc != 3 || (std::strcmp(argv[1], "satellite-first") != 0 && std::strcmp(argv[1], "cxx-first") != 0)) {
+        std::fprintf(stderr, "usage: file_race <satellite-first|cxx-first> <a folder to work in>\n");
+        return 1;
+    }
+    const bool satellite_first = std::strcmp(argv[1], "satellite-first") == 0;
+
+    std::string pattern = std::string(argv[2]) + "/file_race.XXXXXX";
+    std::vector<char> name(pattern.begin(), pattern.end());
+    name.push_back('\0');
+    if (::mkdtemp(name.data()) == nullptr) {
+        std::fprintf(stderr, "file_race: could not make a folder in %s: %s\n", argv[2], std::strerror(errno));
+        return 1;
+    }
+    const std::string room = name.data();
+    const std::string satellite_path = room + "/satellite.txt";
+    const std::string cxx_path = room + "/cxx.txt";
+
+    long long append_s = 0, append_c = 0, walk_s = 0, walk_c = 0, read_s = 0, read_c = 0;
+    bool ok_s = false, ok_c = false;
+    int status = 0;
+
+    // APPEND
+    if (satellite_first) {
+        append_satellite(satellite_path, ok_s, append_s);
+        append_cxx(cxx_path, ok_c, append_c);
+    } else {
+        append_cxx(cxx_path, ok_c, append_c);
+        append_satellite(satellite_path, ok_s, append_s);
+    }
+    const std::string expected_tail = line_text(kLines) + "\n";
+    const std::string written_s = bytes_of(satellite_path);
+    if (!ok_s || !ok_c)
+        status = failed("append: a side failed");
+    else if (written_s.empty() || written_s != bytes_of(cxx_path))
+        status = failed("append: the two files differ");
+    else if (written_s.compare(written_s.size() - expected_tail.size(), expected_tail.size(), expected_tail) != 0)
+        status = failed("append: the last line is not line_1000000");
+
+    // WALK
+    long long count_s = 0, sum_s = 0, count_c = 0, sum_c = 0;
+    if (status == 0) {
+        if (satellite_first) {
+            walk_satellite(satellite_path, count_s, sum_s, ok_s, walk_s);
+            walk_cxx(satellite_path, count_c, sum_c, ok_c, walk_c);
+        } else {
+            walk_cxx(satellite_path, count_c, sum_c, ok_c, walk_c);
+            walk_satellite(satellite_path, count_s, sum_s, ok_s, walk_s);
+        }
+        if (!ok_s || !ok_c)
+            status = failed("walk: a side failed");
+        else if (count_s != kLines || count_c != kLines || sum_s != sum_c)
+            status = failed("walk: the counts or the sums differ");
+    }
+
+    // READ_ALL
+    if (status == 0) {
+        std::string whole_s, whole_c;
+        if (satellite_first) {
+            read_all_satellite(satellite_path, whole_s, ok_s, read_s);
+            read_all_cxx(satellite_path, whole_c, ok_c, read_c);
+        } else {
+            read_all_cxx(satellite_path, whole_c, ok_c, read_c);
+            read_all_satellite(satellite_path, whole_s, ok_s, read_s);
+        }
+        if (!ok_s || !ok_c)
+            status = failed("read_all: a side failed");
+        else if (whole_s != whole_c || whole_s != written_s)
+            status = failed("read_all: the strings differ");
+    }
+
+    ::nftw(room.c_str(), remove_one, 16, FTW_DEPTH | FTW_PHYS);
+    std::fprintf(stderr, "%lld %lld %lld %lld %lld %lld\n", append_s, append_c, walk_s, walk_c, read_s, read_c);
+    return status;
+}
