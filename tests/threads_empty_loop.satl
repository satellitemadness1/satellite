// stop() reaches a loop whose body is empty: the check comes before the `}` (the review, 2026-09-23).
satellite.include(satellite)

satellite.capsule spin()
{
    satellite.statement.while(satellite.bool.true)
    {
    }
}

satellite.capsule satellite.main()
{
    satellite.variable.thread t = satellite.thread.new(spin())
    t.satellite.start()
    t.satellite.stop()
    t.satellite.join()
    satellite.console.display(t)
    satellite.return(satellite)
}
