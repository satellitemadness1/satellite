satellite.include(satellite)

// A PROGRAM THAT WILL NOT STOP WHEN ASKED is killed five seconds later. It is given 0.3 s first, to
// set its trap.
satellite.capsule satellite.main(satellite.variable.arguments args)
{
    satellite.variable.program stubborn = {"sh", "-c", "trap '' TERM; while :; do sleep 0.1; done"}
    stubborn.start()
    satellite.variable.program settle = {"sleep", "0.3"}
    settle.start()
    settle.join()
    satellite.console.display(stubborn.shutdown())           // 137
    satellite.console.display(stubborn.error())              // it was ended by signal 9 (SIGKILL)
    satellite.return(satellite)
}
