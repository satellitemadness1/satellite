satellite.include(satellite)

// satellite.variable.file, the author's example (SATELLITE_FILE_OPERATIONS Part 3):
// a text file is a list of lines, and lines count from 1. check.sh runs this in a
// scratch folder, so demo.se is made there and nowhere else.
satellite.capsule satellite.main(satellite.variable.arguments arguments)
{
    satellite.variable.file my_file = satellite.file.new("demo.se", "text")
    my_file.satellite.append("line_1")
    my_file.satellite.append("line_2")
    my_file.satellite.insert(2, "line_2")
    my_file.satellite.replace(2, "line_3")
    my_file.satellite.replace("line_2", "line_4")
    satellite.statement.for(satellite.variable.number i = 1; i < my_file.satellite.size + 1; i + 1)
    {
        satellite.console.display(my_file[i])
    }
    satellite.console.display(my_file.satellite.size)
    satellite.console.display(my_file.satellite.index_of("line_3"))
    satellite.console.display(my_file.satellite.search("4"))
    satellite.console.display(my_file.satellite.index_of("nowhere"))
    satellite.console.display(my_file.satellite.contains("line_1"))
    satellite.variable.bool closed = my_file.satellite.close()
    satellite.console.display(closed)
    satellite.variable.file again = satellite.file.open("demo.se")
    satellite.console.display(again.satellite.first)
    satellite.console.display(again.satellite.last)
    again.satellite.remove_at(1)
    satellite.console.display(again[1])
    satellite.console.display(again.satellite.size)
    satellite.variable.file twice = satellite.file.new("demo.se")
    satellite.console.display(twice.satellite.ok)
    satellite.variable.file missing = satellite.file.open("no_such_file.se")
    satellite.console.display(missing.satellite.ok)
    satellite.console.display(satellite.file.exists("no_such_file.se"))
    satellite.console.display(satellite.file.exists("demo.se"))
    satellite.return(satellite)
}
