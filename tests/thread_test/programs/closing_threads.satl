satellite.include(satellite)

// THREAD.md D5 and D6: the program ends while threads are starting threads.
// spawner joins its own child in a loop, so close_all() can reach a handle a
// thread is already waiting on (D5). breeder starts threads and never joins
// them, so threads keep arriving after close_all() has taken the registry
// (D6). T1: the program ends, exit 0, every time.

satellite.capsule leaf() satellite.returns(satellite.variable.number)
{
    satellite.variable.number i = 0
    satellite.variable.number s = 0
    satellite.statement.for (i = 0; i < 200; i = i + 1)
    {
        s = s + i
    }
    satellite.return(s)
}

satellite.capsule spawner() satellite.returns(satellite.variable.number)
{
    satellite.variable.number rounds = 0
    satellite.statement.while (rounds >= 0)
    {
        satellite.variable.thread t = satellite.thread.new(leaf())
        t.start()
        t.join()
        rounds = rounds + 1
    }
    satellite.return(rounds)
}

satellite.capsule breeder() satellite.returns(satellite.variable.number)
{
    satellite.variable.number rounds = 0
    satellite.statement.while (rounds >= 0)
    {
        satellite.variable.thread t = satellite.thread.new(leaf())
        t.start()
        rounds = rounds + 1
    }
    satellite.return(rounds)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.thread a = satellite.thread.new(spawner())
    satellite.variable.thread b = satellite.thread.new(breeder())
    satellite.variable.thread c = satellite.thread.new(spawner())
    a.start()
    b.start()
    c.start()
    satellite.time.sleep(0.02)
    satellite.console.display("closing")
    satellite.return(satellite)
}
