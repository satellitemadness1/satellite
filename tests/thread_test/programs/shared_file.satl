satellite.include(satellite)

// THREAD.md D7 and Q4: four threads read_line from ONE file handle. The cursor,
// the buffer and its index were unguarded, so lines were torn, skipped or read
// twice. T1: every line whole, exactly 40000 in total, and S1406 in the log.

satellite.capsule reader(satellite.variable.file f) satellite.returns(satellite.variable.number)
{
    satellite.variable.number n = 0
    satellite.variable.variant line = f.read_line()
    satellite.statement.while (line.holding() != "nothing")
    {
        satellite.statement.if (line != "abcdefghijklmnopqrstuvwxyz0123456789")
        {
            satellite.console.display("torn line")
        }
        n = n + 1
        line = f.read_line()
    }
    satellite.return(n)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.string name = "thread_shared_file_test.txt"
    satellite.system.delete(name)
    satellite.variable.file out = satellite.file.new(name)
    satellite.variable.number i = 0
    satellite.statement.for (i = 0; i < 40000; i = i + 1)
    {
        out.write_line("abcdefghijklmnopqrstuvwxyz0123456789")
    }
    out.close()

    satellite.variable.file shared = satellite.file.open(name, "read")
    satellite.variable.thread a = satellite.thread.new(reader(shared))
    satellite.variable.thread b = satellite.thread.new(reader(shared))
    satellite.variable.thread c = satellite.thread.new(reader(shared))
    satellite.variable.thread d = satellite.thread.new(reader(shared))
    a.start()
    b.start()
    c.start()
    d.start()
    satellite.variable.number total = a.join() + b.join() + c.join() + d.join()
    satellite.system.delete(name)
    satellite.console.display("lines " + total.to_string() + " of 40000")
    satellite.return(satellite)
}
