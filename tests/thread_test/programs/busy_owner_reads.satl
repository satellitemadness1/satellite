// Found by the dark_mechanicum session on revision 04 (THREAD.md D25): one
// thread calls its own object in a loop while a watcher reads the same object.
// The spinner won the access list's compare-and-swap each time it came back,
// so each read waited ~200 us, with no promise of ever getting in. Since the
// fix waiters are served first come, first served: 0.84 s -> 0.09 s here.

satellite.include(satellite)

satellite.spacesuit worker()
{
    satellite.protected
    {
        satellite.variable.number done = 0
        satellite.variable.bool stop = satellite.bool.false
    }
    satellite.public
    {
        satellite.capsule call_step()
        {
            satellite.variable.number i = 0
            satellite.statement.for (i = 0; i < 20; i = i + 1)
            {
                done = done + 1
            }
        }
        satellite.capsule call_done() satellite.returns(satellite.variable.number)
        {
            satellite.return(done)
        }
        satellite.capsule call_set_stop()
        {
            stop = satellite.bool.true
        }
        satellite.capsule call_stop() satellite.returns(satellite.variable.bool)
        {
            satellite.return(stop)
        }
    }
}

// SPINS ON ITS OWN OBJECT'S METHODS, like a major satellite.
satellite.capsule spin(worker w) satellite.returns(satellite.variable.number)
{
    satellite.variable.number n = 0
    satellite.variable.bool stopping = satellite.bool.false
    satellite.statement.while (stopping == satellite.bool.false)
    {
        w.call_step()
        n = n + 1
        satellite.statement.if (n.modulus(250) == 0)
        {
            stopping = w.call_stop()
        }
    }
    satellite.return(n)
}

// READS THE WORKER 5000 TIMES as fast as it can.
satellite.capsule watch(worker w) satellite.returns(satellite.variable.number)
{
    satellite.variable.number last = 0
    satellite.variable.number i = 0
    satellite.statement.for (i = 0; i < 5000; i = i + 1)
    {
        last = w.call_done()
    }
    satellite.return(last)
}

satellite.capsule satellite.main()
{
    worker w
    satellite.variable.thread spinner = satellite.thread.new(spin(w))
    satellite.variable.thread watcher = satellite.thread.new(watch(w))
    spinner.start()
    watcher.start()
    satellite.variable.number seen = watcher.join()
    satellite.console.display("watcher finished, last saw " + seen)
    w.call_set_stop()
    satellite.variable.number steps = spinner.join()
    satellite.console.display("spinner stepped " + steps)
    satellite.return(satellite)
}
