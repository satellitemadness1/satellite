satellite.include(satellite)

satellite.spacesuit link()
{
    satellite.protected
    {
        satellite.variable.number received = 0
        satellite.container.list<satellite.variable.number> pieces = satellite.container.list()
    }
    satellite.public
    {
        satellite.capsule call_feed(satellite.variable.number energy)
        {
            received = received + 1
            pieces.append(energy)
        }
        satellite.capsule call_received() satellite.returns(satellite.variable.number)
        {
            satellite.return(received)
        }
        satellite.capsule call_size() satellite.returns(satellite.variable.number)
        {
            satellite.return(pieces.size())
        }
    }
}

satellite.capsule feeder(link target, satellite.variable.number n) satellite.returns(satellite.variable.number)
{
    satellite.variable.number i = 0
    satellite.statement.for (i = 0; i < n; i = i + 1)
    {
        target.call_feed(i)
    }
    satellite.return(n)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    link shared_link
    satellite.container.list<satellite.variable.thread> crew = satellite.container.list()
    satellite.variable.number t = 0
    satellite.statement.for (t = 0; t < 8; t = t + 1)
    {
        crew.append(satellite.thread.new(feeder(shared_link, 20000)))
    }
    satellite.statement.for (t = 0; t < 8; t = t + 1)
    {
        satellite.variable.thread m = crew[t]
        m.start()
    }
    satellite.statement.for (t = 0; t < 8; t = t + 1)
    {
        satellite.variable.thread m = crew[t]
        m.join()
    }
    satellite.console.display("expected 160000")
    satellite.variable.number received = shared_link.call_received()
    satellite.variable.number pieces = shared_link.call_size()
    satellite.console.display("received " + received.to_string())
    satellite.console.display("pieces   " + pieces.to_string())
    satellite.return(satellite)
}
