satellite.include(satellite)

// Found by T1's review: a thread that reaches its own handle and joins it
// waited for ever -- std::thread::join() would have thrown, the new wait did
// not. T1: refused with S1407, never a hang.

satellite.library.worker = satellite.thread.new(self_join())

satellite.capsule self_join() satellite.returns(satellite.variable.number)
{
    satellite.variable.thread mine = satellite.library.worker
    satellite.variable.number got = mine.join()
    satellite.return(got)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.thread w = satellite.library.worker
    w.start()
    w.join()
    satellite.return(satellite)
}
