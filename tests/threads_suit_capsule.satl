// A spacesuit's capsule runs on its object, which a thread would share: S727 before anything runs.
satellite.include(satellite)

satellite.spacesuit box()
{
    satellite.public
    {
        satellite.capsule call_it()
        {
            satellite.variable.thread t = satellite.thread.new(call_it())
        }
    }
}

satellite.capsule satellite.main()
{
    satellite.return(satellite)
}
