satellite.include(satellite)

// A POINTER WHOSE OBJECT IS GONE, USED: S260 OBJECT_IS_GONE, machine code 76. The pointer does
// not keep its object living (the author, 2026-10-02), so a's first object is gone once a is
// given another -- and the capsule called through p has nothing to run on. The line before it ran.

satellite.spacesuit box()
{
    satellite.protected
    {
        satellite.variable.number value = 0
    }
    satellite.public
    {
        satellite.capsule call_take()
        {
            satellite.return(value)
        }
    }
}

satellite.capsule satellite.main()
{
    box a
    box p = a.pointer()
    box other
    a = other
    satellite.console.display("before")
    satellite.console.display(p.call_take())
    satellite.console.display("THIS LINE MUST NOT RUN")
    satellite.return(satellite)
}
