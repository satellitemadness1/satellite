// A thread asleep for an hour stops when it is asked to: a sleep looks up every tenth of a second.
satellite.include(satellite)

satellite.capsule nap()
{
    satellite.time.sleep(3600s)
}

satellite.capsule satellite.main()
{
    satellite.variable.thread t = satellite.thread.new(nap())
    t.satellite.start()
    satellite.time.sleep(50ms)
    t.satellite.stop()
    t.satellite.join()
    satellite.console.display(t)
    satellite.return(satellite)
}
