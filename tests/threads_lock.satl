// THE AUTHOR'S LOCK (THREADS.md T2, satellite_object/object_lock.hpp): four threads share one
// object; its .lock() is on, so every statement that writes it runs one at a time, and every
// count comes out exact.
//
//   20000   four threads, 5,000 adds each, on one number field
//   4000    four threads, 1,000 appends each, on one list field
//   20001   a thread run on the object's own capsule: satellite.thread.new(shared.call_add())
//   20002   a method that starts a thread on a capsule of its own object, by its bare name
satellite.include(satellite)

satellite.spacesuit counter()
{
    satellite.protected
    {
        satellite.variable.number total = 0
        satellite.container.list<satellite.variable.number> seen = {}
    }
    satellite.public
    {
        satellite.capsule call_add()
        {
            total = total + 1
        }
        satellite.capsule call_note(satellite.variable.number n)
        {
            seen.satellite.append(n)
        }
        satellite.capsule call_total()
        {
            satellite.return(total)
        }
        satellite.capsule call_seen()
        {
            satellite.return(seen.satellite.size)
        }
        satellite.capsule call_add_on_a_thread()
        {
            satellite.variable.thread mine = satellite.thread.new(call_add())
            mine.satellite.start()
            mine.satellite.join()
        }
    }
}

satellite.capsule pound(counter c)
{
    satellite.variable.number i = 0
    satellite.statement.while(i < 5000)
    {
        c.call_add()
        i = i + 1
    }
}

satellite.capsule note(counter c)
{
    satellite.variable.number i = 0
    satellite.statement.while(i < 1000)
    {
        c.call_note(i)
        i = i + 1
    }
}

satellite.capsule satellite.main()
{
    counter shared()
    shared.satellite.lock()

    satellite.variable.thread a = satellite.thread.new(pound(shared))
    satellite.variable.thread b = satellite.thread.new(pound(shared))
    satellite.variable.thread c = satellite.thread.new(pound(shared))
    satellite.variable.thread d = satellite.thread.new(pound(shared))
    a.satellite.start()
    b.satellite.start()
    c.satellite.start()
    d.satellite.start()
    a.satellite.join()
    b.satellite.join()
    c.satellite.join()
    d.satellite.join()
    satellite.console.display(shared.call_total())

    satellite.variable.thread e = satellite.thread.new(note(shared))
    satellite.variable.thread f = satellite.thread.new(note(shared))
    satellite.variable.thread g = satellite.thread.new(note(shared))
    satellite.variable.thread h = satellite.thread.new(note(shared))
    e.satellite.start()
    f.satellite.start()
    g.satellite.start()
    h.satellite.start()
    e.satellite.join()
    f.satellite.join()
    g.satellite.join()
    h.satellite.join()
    satellite.console.display(shared.call_seen())

    satellite.variable.thread direct = satellite.thread.new(shared.call_add())
    direct.satellite.start()
    direct.satellite.join()
    satellite.console.display(shared.call_total())

    shared.call_add_on_a_thread()
    satellite.console.display(shared.call_total())
    satellite.return(satellite)
}
