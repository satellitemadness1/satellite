satellite.include(satellite)

satellite.capsule satellite.main(satellite.variable.arguments arguments)
{
    satellite.variable.number n = 87
    satellite.variable.string s = "87"

    satellite.console.display(n.satellite.to_string())
    satellite.console.display(n.satellite.str())
    satellite.console.display(n.satellite.string())
    satellite.console.display(n.satellite.binary())
    satellite.console.display(n.satellite.bin())
    satellite.console.display(n.satellite.hex())
    satellite.console.display(s.satellite.number())
    satellite.console.display(s.satellite.as_number())
    satellite.console.display(s.satellite.bin)
    satellite.console.display(s.satellite.bin.satellite.find("10101"))
    satellite.console.display(n.satellite.bin.satellite.find("111"))
    satellite.console.display(n.satellite.add(13))
    satellite.console.display(s.satellite.add("!"))
    satellite.console.display(n.satellite.to_string().satellite.add("x"))

    satellite.return(satellite)
}
