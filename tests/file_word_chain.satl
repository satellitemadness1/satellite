satellite.include(satellite)

// A method written after a word's call runs (the review, 2026-09-18: the append was
// dropped without a word).
satellite.capsule satellite.main(satellite.variable.arguments arguments)
{
    satellite.file.new("chain.se").satellite.append("one")
    satellite.file.open("chain.se").satellite.append("two")
    satellite.console.display(satellite.file.open("chain.se").satellite.size)
    satellite.return(satellite)
}
