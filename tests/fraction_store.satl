satellite.include(satellite)

// A name declared satellite.variable.fraction: its two numbers, a plain number
// given to it (3 is 3/1), a new fraction given to it, and its sign turned over.
satellite.capsule satellite.main()
{
    satellite.variable.fraction f = 2/4
    satellite.console.display(f)
    satellite.console.display(f.numerator)
    satellite.console.display(f.denominator)
    satellite.console.display(f.numerator + 1)
    satellite.console.display(f == 1/2)
    satellite.console.display(1.5/2.numerator)
    satellite.variable.fraction g = 3
    satellite.console.display(g)
    g = 5/7
    satellite.console.display(g)
    g = -g
    satellite.console.display(g)
    satellite.console.display(g.numerator)
    satellite.container.list halves = {2/4, 3/4}
    satellite.console.display(halves.contains(1/2))
    satellite.return(satellite)
}
