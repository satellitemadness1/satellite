satellite.include(satellite)

// .transparency(100) IS REFUSED WHERE IT RUNS: the checker sees the method and not
// what it is given, so "before" is shown and the colour is left as it was.
satellite.capsule satellite.main()
{
    satellite.console.display("before")
    satellite.variable.color my_color = x000000
    my_color.transparency(100)
    satellite.console.display(my_color)
    satellite.return(satellite)
}
