satellite.include(satellite)

// A NUMBER NAME GIVEN TWO NUMBERS DIVIDED IS REFUSED BEFORE ANYTHING RUNS (the author's 9b,
// 2026-10-12): 1 / 3 is a fraction, so the report says to declare a fraction or to write
// satellite.convert.number(1 / 3) -- and "before" never reaches the screen.
satellite.capsule satellite.main()
{
    satellite.console.display("before")
    satellite.variable.number n = 1 / 3
    satellite.console.display(n)
    satellite.return(satellite)
}
