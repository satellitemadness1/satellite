// satellite.return(satellite) on another thread ends main's own hour-long sleep too.
satellite.include(satellite)

satellite.capsule quit_soon()
{
    satellite.time.sleep(100ms)
    satellite.return(satellite)
}

satellite.capsule satellite.main()
{
    satellite.variable.thread t = satellite.thread.new(quit_soon())
    t.satellite.start()
    satellite.time.sleep(3600s)
    satellite.console.display("never reached")
    satellite.return(satellite)
}
