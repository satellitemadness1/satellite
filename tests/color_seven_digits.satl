satellite.include(satellite)

// SEVEN DIGITS ARE NOT A COLOUR EITHER, and on a later line, with its x, it is
// refused the same way before anything runs.
satellite.capsule satellite.main()
{
    satellite.console.display("before")
    satellite.variable.color my_color = x000000
    my_color = x00ff000
    satellite.console.display(my_color)
    satellite.return(satellite)
}
