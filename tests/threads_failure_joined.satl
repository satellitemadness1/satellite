// A thread's refusal is reported where it happened, and join() stops main with the same code.
satellite.include(satellite)

satellite.capsule divide(satellite.variable.number by)
{
    satellite.return(satellite.convert.whole(10 / by))
}

satellite.capsule satellite.main()
{
    satellite.variable.thread t = satellite.thread.new(divide(0))
    t.satellite.start()
    satellite.variable.number never = t.satellite.join()
    satellite.console.display("never printed")
    satellite.return(satellite)
}
