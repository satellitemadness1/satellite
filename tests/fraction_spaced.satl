satellite.include(satellite)

// A spaced slash between two numbers is a fraction too since 2026-10-12 (the author: "what about
// always a fraction? 4 / 2 is the fraction"), so a fraction name given 1 / 3 holds 1/3 -- where it
// was refused before anything ran, as whole-number division.
satellite.capsule satellite.main()
{
    satellite.console.display("before")
    satellite.variable.fraction f = 1 / 3
    satellite.console.display(f)
    satellite.return(satellite)
}
