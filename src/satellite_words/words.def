SAT_NODE(LIBRARY_MAIN_ARGUMENTS_SESSION,     LIBRARY_MAIN_ARGUMENTS_SESSION_0,                       "()",                    SAT_BARE)  // 1 14 1 1 8 0
SAT_NODE(LIBRARY_MAIN_ARGUMENTS_SESSION,     LIBRARY_MAIN_ARGUMENTS_SESSION_SHELL,                   "shell",                 SAT_NUMBERED)  // 1 14 1 1 8 1
SAT_NODE(LIBRARY_MAIN_ARGUMENTS_SESSION,     LIBRARY_MAIN_ARGUMENTS_SESSION_TERMINAL,                "terminal",              SAT_NUMBERED)  // 1 14 1 1 8 2
SAT_NODE(LIBRARY_MAIN_ARGUMENTS_SESSION,     LIBRARY_MAIN_ARGUMENTS_SESSION_LANGUAGE,                "language",              SAT_NUMBERED)  // 1 14 1 1 8 3
