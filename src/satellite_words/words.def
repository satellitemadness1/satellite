SAT_NODE(LIBRARY_MAIN_ARGUMENTS_SESSION,     LIBRARY_MAIN_ARGUMENTS_SESSION_DIRECTORY,               "directory",             SAT_NUMBERED)  // 1 14 1 1 8 5
// `length` AND NOT `count`, SETTLED BY THE AUTHOR 2026-09-11 WHEN THE TEN
// SELECTORS COLLIDED WITH IT. This row was minted as `count` earlier the same
// day -- v1's `argument_count` -- and `satellite.container.arguments.count`
// `1 4 3 2` is how many entries the OBJECT holds, which is a different number
// (3 against 37 on this machine). Both are reached off `satellite.main`'s
// parameter and the object's own children are asked first, so one word would
// have answered the other's question with nothing saying so -- the shape this
// milestone's own resolver defect had and the reason it was worth a commit.
//
// SO THE WORDS ARE SPLIT AND EACH MEANS ONE THING EVERYWHERE (DESIGN §1):
// `length` is how long the command line is, `count` is how many entries there
// are. `1 4 3 1` is `length` too and answers the same number from the same
// vector, so the shadow here is two rows agreeing rather than one hiding the
// other -- which is the whole difference between this and what it replaced.
SAT_NODE(LIBRARY_MAIN_ARGUMENTS,             LIBRARY_MAIN_ARGUMENTS_LENGTH,                          "length",                SAT_NUMBERED)  // 1 14 1 1 9
SAT_NODE(LIBRARY,                        LIBRARY_SYSTEM,                         "system",          SAT_NUMBERED)  // 1 14 2
SAT_NODE(LIBRARY_SYSTEM,                 LIBRARY_SYSTEM_0,                       "()",              SAT_BARE)  // 1 14 2 0
