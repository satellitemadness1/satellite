// --- random -----------------------------------------------------------------
// DESIGN §11. Three spinning tiers, four call shapes each, three aliases --
// and a FOURTH TIER that takes a seed and does not spin, minted at M21
// because `Rack::draw` cannot be written without it (PLAN §8's M21 entry
// reserved `1 7 13` for exactly this and left the shape to the author).
//
// THE SEEDED TIER HAS THREE SHAPES AND NOT FOUR, AND THE REGISTRY IS WHAT
// DECIDED THAT. A shape is keyed by its word and its ARITY, so the
// one-argument slot holds either a digit count or a seed and cannot hold
// both -- and the seed is the one this tier exists for. `seeded(digits)` is
// therefore not offered, which costs QUAD nothing: it draws no N-digit
// numbers. A dotted node name would have made room for one and there are
// none in this file; only an alias may carry a dot, and an alias takes no
// number.
//
SAT_NODE(SATELLITE, RANDOM,                     "random",                 SAT_NUMBERED)  // 1 7
SAT_NODE(RANDOM,    RANDOM_0,                   "()",                     SAT_BARE)  // 1 7 0
SAT_NODE(RANDOM,    RANDOM_FAST_0,              "fast()",                 SAT_NUMBERED)  // 1 7 1
SAT_NODE(RANDOM,    RANDOM_NORMAL_0,            "normal()",               SAT_NUMBERED)  // 1 7 2
SAT_NODE(RANDOM,    RANDOM_ULTRA_0,             "ultra()",                SAT_NUMBERED)  // 1 7 3
SAT_NODE(RANDOM,    RANDOM_FAST_DIGITS,         "fast(digits)",           SAT_NUMBERED)  // 1 7 4
SAT_NODE(RANDOM,    RANDOM_FAST_MIN_MAX,        "fast(min, max)",         SAT_NUMBERED)  // 1 7 5
SAT_NODE(RANDOM,    RANDOM_FAST_MIN_MAX_STEP,   "fast(min, max, step)",   SAT_NUMBERED)  // 1 7 6
SAT_NODE(RANDOM,    RANDOM_NORMAL_DIGITS,       "normal(digits)",         SAT_NUMBERED)  // 1 7 7
SAT_NODE(RANDOM,    RANDOM_NORMAL_MIN_MAX,      "normal(min, max)",       SAT_NUMBERED)  // 1 7 8
SAT_NODE(RANDOM,    RANDOM_NORMAL_MIN_MAX_STEP, "normal(min, max, step)", SAT_NUMBERED)  // 1 7 9
