SAT_NODE(WINDOW,         WINDOW_0,           "()",                        SAT_BARE)  // 1 24 0
SAT_NODE(WINDOW,         WINDOW_NEW,         "new",                       SAT_NUMBERED)  // 1 24 1
SAT_NODE(WINDOW,         WINDOW_CONSOLE,     "console",                   SAT_NUMBERED)  // 1 24 2
SAT_NODE(WINDOW_CONSOLE, WINDOW_CONSOLE_0,   "()",                        SAT_BARE)  // 1 24 2 0
SAT_NODE(WINDOW_CONSOLE, WINDOW_CONSOLE_NEW, "new(title, width, height)", SAT_NUMBERED)  // 1 24 2 1

// --- the aliases ------------------------------------------------------------
// WORD_NUMBERS §2.3, in full. Eleven spellings over six nodes, and the whole of
// the language's aliasing: every one of the 218-versus-215 and 227-versus-224
// disagreements across these documents is the first three rows and nothing else.
//
// The `.range` three are the reason an alias cannot be a node. Each is a FOUR
// segment spelling of a node that is three numbers, so writing them as children
// of `fast`, `normal` and `ultra` would have invented three parents the
// numbering does not have and taken three numbers §2.2 never assigned.
SAT_ALIAS(RANDOM_FAST_MIN_MAX,   "fast.range(min, max)")     // 1 7 5
SAT_ALIAS(RANDOM_NORMAL_MIN_MAX, "normal.range(min, max)")   // 1 7 8
SAT_ALIAS(RANDOM_ULTRA_MIN_MAX,  "ultra.range(min, max)")    // 1 7 11
SAT_ALIAS(RANDOM_SEEDED_MIN_MAX, "seeded.range(min, max)")   // 1 7 14

// The language's one alias for a type name, which the LEXER's spelling table has
// to know rather than the parser -- PLAN M3 owns `binary` and `hex` because
// DESIGN §8.5 gives them literals, and a literal is lexed.
SAT_ALIAS(VARIABLE_HEX, "hexadecimal")                       // 1 6 11

// `satellite.class` IS `satellite.spacesuit`, added 2026-09-09 by the author.
//
// THE FIRST ALIAS IN THE LANGUAGE ON A WORD THAT IS NOT A TYPE OR A CALL SHAPE,
// and the reason is the one §7.7 gives for the spellings of `arguments`: people
// type what they type. `class` is what every other language on earth calls this
// construct, and a reader arriving from any of them writes it before they have
// read a line of DESIGN. `spacesuit` remains the language's own word -- it is the
// node, it is what unparse() prints, and it is what `satellite.help` heads the
// entry with; `class` is a second spelling of it and takes no number of its own.
//
// It shadows nothing: SATELLITE's children carry no `class`, which is what
// words_invariants.hpp's aliases_do_not_shadow() checks rather than trusts. And
// it is LEXICAL -- no dot in the text -- so the lexer's spelling table resolves
// it to SPACESUIT's id and the parser never learns there were two spellings.
SAT_ALIAS(SPACESUIT, "class")                                // 1 10

// DESIGN §7.7's seven spellings of the one library global. Six here;
// `arguments` is the node's own text and is not repeated.
//
// THE ONE PLACE A BARE IDENTIFIER IS LANGUAGE-OWNED, which DESIGN §1's
// generating rule otherwise forbids. The rule survives because the user still
// writes the name: the language does not introduce `arguments`, it RECOGNISES
// the name the user chose for satellite.main's parameter when it is one of the
// seven.
//
// `argv` IS THE SEVENTH AND IT WAS ADDED ON 2026-09-09, BY THE AUTHOR, WHICH
// IS THE ONLY WAY IT COULD HAVE BEEN ADDED. §7.7 had settled the question the
// other way at M7: the seventh was refused rather than silently plain, and
// S0531 told a program named `argv` that it was one edit from `arg`. That was
// the right answer to "what happens to a name that ALMOST means the object"
// and the wrong answer to this name, and §7.7 said which door the fix comes
// through -- "adding `argv` to words.def would make it work and is an edit to
// the numbering, which WORD_NUMBERS.md is the authority over and which is the
// AUTHOR'S to make rather than a milestone's to take in passing." It was made
// after the author wrote a program with `argv` in it and had to be told by the
// interpreter that satellite does not accept the spelling every C program on
// earth uses -- which is §7.7's own "people type what they type" with the
// language's author as the witness.
//
// S0531 IS NOT DEAD AND MUST NOT BE DELETED. It still fires for `argu`,
// `arrgs`, `argvs` and every other near miss; what changed is that one of its
// examples became a spelling. An alias row is how a spelling is added, so the
// suggester's list grows here with no edit to the resolver at all.
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "arg")                     // 1 14 1 1
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "args")
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "argz")
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "argument")
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "argumentz")
SAT_ALIAS(LIBRARY_MAIN_ARGUMENTS, "argv")

// --- the place parameters ----------------------------------------------------
//
// A THIRD LIST, ONE ROW LONG, AND THE POLICY IS THAT IT STAYS ONE ROW. PLAN
// M14: `input(prompt, target)` `1 5 4` "writes a place and returns nothing --
// the only out parameter in the language, and deliberately not the start of a
// general facility". DESIGN §6.4 qualification 2's receiver-binding tag is
// the precedent -- a fact about a word that dispatch needs, declared on the
// word -- and this is that mechanism extended to a non-receiver parameter:
// the index (0-based, among the WRITTEN arguments) that names a variable the
// answer is written into. The evaluator's compiler is the consumer: it
// refuses a non-name in the place (S1002) and the whole call anywhere but
// statement position (S1003), both before any prompt could print, and it
// compiles the place as a SLOT rather than as an expression -- so v1's
// `expr_call.cpp:113` flatten-and-strcmp hack has no descendant here.
//
// SELF-DEFAULTING, unlike its two siblings: a consumer that cares defines
// SAT_PLACE before including; the many that do not get a no-op and never
// learn the list exists. The undef below covers both.
#ifndef SAT_PLACE
#define SAT_PLACE(ident, index)
#endif

SAT_PLACE(CONSOLE_INPUT_PROMPT_TARGET, 1)  // 1 5 4 -- `target` receives the line

// --- the front-end words -----------------------------------------------------
//
// A FOURTH LIST, AND IT IS WHAT MAKES `satellite.help` ABLE TO TELL THE TRUTH.
// PLAN M18: help names a node when it has a HANDLER row, an ASSIGNER row, or
// is a FRONT-END word -- one the parser or the resolver recognises and nothing
// ever dispatches. The first two are read off the tables at run time and cannot
// drift, because they ARE the mechanism. The third has no table: `include`,
// `capsule`, `main`, `return` and the type names are recognised by name in the
// front end and dispatch never sees them, so of the six paths hello world is
// written in, exactly one -- `console.display` `1 5 1` -- is a row in
// `handlers[path_id]`. Help built on the handler table alone would print that
// one and stay silent about the language's own first program.
//
// SO IT IS WRITTEN DOWN HERE RATHER THAN INFERRED, which is PLAN M18's own
// instruction and the reason is the same one this file gives everywhere else:
// a set derived from "which spellings does parser_types.cpp compare against"
// is a set that moves when somebody refactors a comparison, silently, and the
// only symptom is a help text that has started lying. A row here is a claim
// with a name on it.
//
// A NAMESPACE IS NOT LISTED AND MUST NOT BE. `satellite.console` `1 5` has no
// handler row either, and it is built because nine words UNDER it are --
// satellite_help/built.hpp derives that, so listing it here would be a second
// answer to a question already answered. What belongs in this list is only a
// word that is reached by name and has nothing underneath it to vouch for it.
//
// AND A WORD THAT PARSES IS NOT THEREBY BUILT. `satellite.include(spaceship)`
// `1 1 2` is absent: the parser accepts the line and nothing loads a second
// file, so it refuses when it runs and M25 is the milestone. Same for
// `satellite.library.main` `1 14 1` and the arguments object under it, which
// are M20's. The test of this list is not "does the front end have a case for
// it" but "does a program that writes it do what it says".
//
// AND A SECOND COLUMN, WHICH IS NOT THE SAME QUESTION AS THE FIRST. A word can
// be built and still not be something to OFFER somebody: `satellite.returns`
// `1 21` parses, works, and is a real answer to `satellite.help(satellite.returns)`
// -- and it is optional, no file under `example/` uses it, and the author's
// instruction is that it is not how a capsule is written here. Listing it beside
// `console` and `container` would be advertising a word the language does not
// want written, which is DESIGN §1.1's own concern pointed the other way: help
// must not hide what works, and must not push what nobody should type.
//
//     SAT_OFFERED    named in the listing a help walk prints
//     SAT_UNLISTED   answers when asked about, never offered
//
// THE COLUMN IS ON THIS LIST AND NOT ON A SIXTH ONE, and it is on this list
// rather than on SAT_NODE because it is a fact about a word being BUILT: a row
// with a handler is offered by having a handler, and there is nothing to say
// about a row that is neither. Everything not named here is offered, so the
// default is the safe direction -- a word added to the language and forgotten
// about shows up rather than disappearing.
//
// SELF-DEFAULTING, exactly as SAT_PLACE above: a consumer that cares defines
// SAT_BUILT before including and everybody else gets a no-op.
#ifndef SAT_BUILT
#define SAT_BUILT(ident, listing)
#endif
#ifndef SAT_OFFERED
#define SAT_OFFERED 1
#endif
#ifndef SAT_UNLISTED
#define SAT_UNLISTED 0
#endif

SAT_BUILT(SATELLITE, SAT_OFFERED)             // 1        the root every path begins at
SAT_BUILT(INCLUDE, SAT_OFFERED)               // 1 1      the first line of every file
SAT_BUILT(INCLUDE_0, SAT_OFFERED)             // 1 1 0    parses, and includes nothing
SAT_BUILT(INCLUDE_SATELLITE, SAT_OFFERED)     // 1 1 1    the line people actually type
SAT_BUILT(CAPSULE, SAT_OFFERED)               // 1 2      the declaration
SAT_BUILT(CAPSULE_0, SAT_OFFERED)             // 1 2 0    calling one
SAT_BUILT(MAIN, SAT_OFFERED)                  // 1 3      where a program starts
SAT_BUILT(MAIN_0, SAT_OFFERED)                // 1 3 0    and it is callable, since d91666a
SAT_BUILT(CONTAINER_MAP, SAT_OFFERED)         // 1 4 1    a type name in a declaration
SAT_BUILT(CONTAINER_LIST, SAT_OFFERED)        // 1 4 2
SAT_BUILT(VARIABLE_STRING, SAT_OFFERED)       // 1 6 1
SAT_BUILT(VARIABLE_TIME, SAT_OFFERED)         // 1 6 3    M13 gave Value its instant arm
SAT_BUILT(VARIABLE_NUMBER, SAT_OFFERED)       // 1 6 4
SAT_BUILT(VARIABLE_BINARY, SAT_OFFERED)       // 1 6 5    M19.5
SAT_BUILT(VARIABLE_HEX, SAT_OFFERED)          // 1 6 11   M19.5's second half
SAT_BUILT(VARIABLE_BOOL, SAT_OFFERED)         // 1 6 6
SAT_BUILT(VARIABLE_FLOAT, SAT_OFFERED)        // 1 6 10   M15
SAT_BUILT(VARIABLE_VARIANT, SAT_OFFERED)      // 1 6 14   M12
SAT_BUILT(STATEMENT, SAT_OFFERED)             // 1 13     the family
SAT_BUILT(STATEMENT_IF, SAT_OFFERED)          // 1 13 1
SAT_BUILT(STATEMENT_FOR, SAT_OFFERED)         // 1 13 2
SAT_BUILT(STATEMENT_WHILE, SAT_OFFERED)       // 1 13 3
SAT_BUILT(STATEMENT_ELSE, SAT_OFFERED)        // 1 13 4
SAT_BUILT(LIBRARY, SAT_OFFERED)               // 1 14     `satellite.library.<name>` globals
SAT_BUILT(RETURN, SAT_OFFERED)                // 1 15
SAT_BUILT(RETURN_0, SAT_OFFERED)              // 1 15 0
SAT_BUILT(RETURN_SATELLITE, SAT_OFFERED)      // 1 15 1   `satellite.main`'s last line
SAT_BUILT(RETURN_VALUE, SAT_OFFERED)          // 1 15 2
SAT_BUILT(RETURNS, SAT_UNLISTED)              // 1 21     optional, and it parses
SAT_BUILT(VARIABLE_CAPSULE, SAT_OFFERED)      // 1 6 16   M23 -- a deferred call, and it has no children to be derived from

// A TYPE NAME IS HERE WHEN `Value` HAS AN ARM FOR IT AND IT HAS NO BUILT CHILD,
// and the second half of that sentence is M23's correction of the first. This
// paragraph read "THE SIX TYPE NAMES ABOVE ARE THE SIX `Value` HAS AN ARM FOR"
// from M11 until 2026-09-12, and by then there were ELEVEN rows and THIRTEEN
// arms -- so the count was wrong and, more usefully, the RULE was.
//
// The test is not "does a declaration of it parse": every type name parses,
// `satellite.variable.window x` is accepted today and the name simply holds
// nothing, so parsing cannot separate a type the language can hold a value of
// from one it cannot. satellite_value/value.hpp's variant is that fact. But it
// is not the whole test either, because satellite_help/built.cpp derives a
// FOURTH kind in one backward pass: A PARENT OF A BUILT ROW IS BUILT. So a type
// with a method is already answered for by the method, and a row here would be
// a second statement of a derived fact.
//
// THAT IS WHY M19's FILE AND M20's ARGUMENTS OBJECT ARE NOT HERE, AND THIS
// PARAGRAPH ASKED FOR THE FIRST OF THEM BY NAME -- it said "the day it gains
// the file handle (M19) ... a row joins this list beside it", and M19 landed
// `satellite.variable.file` `1 6 2` with eleven numbered children and no row.
// Nothing was broken by it: `1 6 2 1` has a handler, so the backward pass
// carries built-ness up to `1 6 2` and help answers about the type correctly.
// The instruction was simply wrong, and a milestone that had obeyed it would
// have written a redundant line. `satellite.container.arguments` `1 4 3` is the
// same story one milestone later. *(Found at M23, by a milestone asking whether
// its own two types needed rows -- MILESTONES/M23.md section 3.)*
//
// SO M23 ADDS ONE ROW AND NOT TWO. `satellite.variable.thread` `1 6 13` has
// `start()` and `join()` under it and is derived like the file;
// `satellite.variable.capsule` `1 6 16` HAS NO CHILDREN AT ALL -- a deferred
// call is made by `satellite.thread.new` and asked nothing -- so there is
// nothing for the pass to derive from and the row is load-bearing. That is
// `satellite.variable.float`'s position at M15 exactly, and M21 gave the float
// its first method and made its row derivable without removing it.
// `satellite.container.list` and `.map` are here for the reason the rule's
// first half gives, one layer along: M16 gave both a body.

// --- the unevaluated arguments -----------------------------------------------
//
// A FIFTH LIST, ONE ROW LONG, AND IT IS A LANGUAGE DECISION RATHER THAN A
// CONVENIENCE. `satellite.help(satellite.console)` cannot be an ordinary call:
// a bare language path read as a value compiles to `op_dispatch` and refuses at
// run time, so the argument would die before help was ever entered -- and it
// refuses IDENTICALLY for a module that is built, which means the one question
// help exists to answer would be answered wrong in both directions. Measured
// 2026-09-07, before any of this was built:
//
//     satl: error S0721: `satellite.console` is a path satellite has a number
//           for and nothing behind yet -- a later milestone
//
// So `1 19 1`'s argument is a PATH, or a NAME whose declared type resolve
// already knows, and in neither case is anything evaluated. The index below is
// the written argument (0-based) the compiler reads as a path instead of
// compiling -- SAT_PLACE's shape exactly, pointed at the other half of the
// problem: a place is an argument compiled as a SLOT, and a topic is an
// argument compiled as a NUMBER, and both are refusals the compiler can make
// before anything runs.
//
// ONE ROW, AND THE POLICY IS THAT IT STAYS ONE ROW, which is what SAT_PLACE
// says about itself and is the same argument. An unevaluated argument is a hole
// in DESIGN §6's evaluation rule; one hole with a name on it is a feature and a
// general facility for making them is a second language.
#ifndef SAT_TOPIC
#define SAT_TOPIC(ident, index)
#endif

SAT_TOPIC(HELP_X, 0)  // 1 19 1 -- `x` is a path or a name, and is never run

// --- the deferred calls ------------------------------------------------------
//
// A SEVENTH LIST, ONE ROW LONG, AND IT IS THE OTHER HOLE IN DESIGN section 6's
// evaluation rule. The fifth list above is an argument that is never EVALUATED;
// this one is an argument that is evaluated and then not PERFORMED.
//
//     satellite.variable.thread t = satellite.thread.new(capsule_test(word))
//
// DESIGN section 13 settled that form on 2026-08-27 and says exactly what has
// to happen to it: "capsule_name(args) at that position is not performed -- it
// is PACKAGED. The handler evaluates the arguments and stores (capsule number,
// argument values) for the thread to run later." So `word` is evaluated, here,
// on the calling thread, at the moment `new` runs -- and `capsule_test` is not
// entered until somebody says `start()`.
//
// SO IT IS NEITHER OF THE TWO LISTS ABOVE, AND THAT IS WHY IT IS A THIRD ONE.
// A TOPIC skips the argument entirely and folds a PATH in its place; a PLACE
// compiles the argument as a SLOT. A deferred call compiles its argument's own
// arguments exactly as any call would and replaces only the LAST act -- the
// entering. The op is op_package and it is op_call with the enter removed,
// which is the same relationship op_enter has to op_call one direction along.
//
// WHAT THE INDEX MEANS is the fifth list's exactly: the written argument
// (0-based) that is a call to be packaged rather than performed.
//
// ONE ROW, AND THE POLICY IS THAT IT STAYS ONE ROW, which is what both lists
// above say about themselves and is the same argument for the third time. A
// general facility for deferring calls is `a bare name can be a value`, which
// DESIGN section 12 has deferred since the language was designed and which
// section 12's own note says this form does NOT reopen: `capsule_test(word)`
// is a CALL, which section 6.2's postfix loop already produces, and the only
// new semantics is that one handler packages its arguments instead of
// performing the call. One hole with a name on it is a feature. Two are a
// second language.
//
// AND THE ROW IS ON `new` AND NOT ON `thread`, because a deferred call is a
// VALUE of its own -- satellite.variable.capsule `1 6 16` -- and `new` is the
// one word that takes one today. The day a second word does, it joins this
// list beside `new` and nothing else moves, which is the property the fifth
// list's index has and the reason both are tables rather than special cases.
#ifndef SAT_DEFER
#define SAT_DEFER(ident, index)
#endif

SAT_DEFER(THREAD_NEW, 0)  // 1 23 1 -- `f(x)` is packaged, and x is evaluated

// --- the words that take a literal option -----------------------------------
//
// WORD_NUMBERS §1.5's fold: `my_list.sort("down")` interns to `sort_down()`
// `1 4 2 5` at resolve, so the readable word at the call site costs no string
// comparison at run time. What this list says is WHICH WORDS THAT APPLIES TO.
//
// A SIXTH LIST, ADDED 2026-09-08 AT M19, AND IT REPLACES A GUESS THAT WAS
// WRONG ABOUT TWO WORDS OUT OF THREE. `fold_option` used to ask the numbering
// instead of a table: a word took options when the rows BESIDE IT were spelled
// `<word>_<something>`, so `sort` took options because `sort_down` sat next to
// it. That rule is a spelling coincidence wearing a semantic hat, and the whole
// registry contains exactly three words it fires on:
//
//     sort    beside sort_down, sort_up               -- RIGHT
//     remove  beside remove_first, remove_last,
//                    remove_at                        -- WRONG
//     write   beside write_line                       -- WRONG
//
// `remove_first()` is not the option `first` of `remove`, it is its own verb --
// and the consequence shipped: `parts.remove("bolt")`, removing a string from a
// list of strings, was refused with S0524 "`bolt` is not an option remove has".
// M16 built that and nobody could write the call; M18's help pass then wrote
// the defect down AS THE LANGUAGE, in help_lines/README.md's list of five
// "plainly stated and plainly wrong" statements -- "a quoted word inside
// `list.remove` is read as an option name rather than as a value". It was a
// bug, and the note is corrected where it stands.
//
// M19 HIT THE SAME RAKE, which is what made it worth fixing rather than
// working around: `write(x)` `1 6 2 11` sits beside `write_line(s)` `1 6 2 4`,
// so `f.write("one")` refused with "`one` is not an option write has -- it has
// line". Renaming the new verb was available and was declined by the author on
// 2026-09-08: two words in two milestones is a rule that is wrong, not two
// unlucky names.
//
// THE ROW NAMES THE NODE WHOSE SPELLING IS THE WORD, which carries the parent
// with it -- `CONTAINER_LIST_SORT_0` is spelled `sort` and its parent is
// `CONTAINER_LIST`, so one identifier answers both halves of "does `sort` under
// a list take options". The OPTIONS THEMSELVES ARE STILL READ OFF THE SIBLINGS,
// because for a word that is declared here that reading is correct and a second
// list of `down` and `up` would be a second place for them to disagree.
//
// ONE ROW TODAY. A list that is one row long is the point rather than an
// embarrassment: the fold is one mechanism serving one word, and the day a
// second word wants it, adding it here is the whole of the change.
//
// AND IT IS SMALLER TO ASK THAN THE GUESS IT REPLACES, which is worth stating
// because a lookup table sounds like a cost and this one is a saving. The guess
// WALKED EVERY CHILD of the receiver's type on every selector call that had a
// string literal in front -- `first_child`, `next_sibling`, and a string prefix
// compare per child, twenty-six of them for a list. Asking this list is one
// integer compare against the parent, which fails for every receiver that is
// not a list and never reaches a character. `takes_options` in
// words_nodes.hpp is the reader and returns the moment it knows.
#ifndef SAT_OPTIONS
#define SAT_OPTIONS(ident)
#endif

SAT_OPTIONS(CONTAINER_LIST_SORT_0)  // 1 4 2 3 -- `sort("down")`, `sort("up")`

#undef SAT_NODE
#undef SAT_ALIAS
#undef SAT_OPTIONS
#undef SAT_PLACE
#undef SAT_BUILT
#undef SAT_TOPIC
#undef SAT_DEFER
