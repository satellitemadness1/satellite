// 1 14 1 1 8  satellite.library.main.arguments.session
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION, LIBRARY_MAIN_ARGUMENTS_SESSION,
         "The session the program was started in: whose shell, which terminal, what\n"
         "language, where home is and where the program is running. Written on its\n"
         "own it displays all five at once."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session)\n"
         "}"
         )

// 1 14 1 1 8 0  satellite.library.main.arguments.session()
