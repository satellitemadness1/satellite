         "}"
         )

// 1 14 1 1 6 2  satellite.library.main.arguments.interpreter.library_path
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_INTERPRETER_LIBRARY_PATH, LIBRARY_MAIN_ARGUMENTS_INTERPRETER_LIBRARY_PATH,
         "Where the interpreter looks for another satellite file.\n"
         "\n"
         "**Not built** — M25, which is the milestone that builds\n"
         "`satellite.include` of another file. Until something reads a library path\n"
         "there is no library path to report, so this refuses and says so rather than\n"
         "naming a directory nothing consults."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.interpreter.library_path)\n"
         "}"
         )

