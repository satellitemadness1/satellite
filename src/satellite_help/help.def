// 1 14 1 1 5  satellite.library.main.arguments.build
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_BUILD, LIBRARY_MAIN_ARGUMENTS_BUILD,
         "What built the interpreter that is running. Written on its own it displays\n"
         "all eight at once.\n"
         "\n"
         "**These describe the binary, not the machine.** They are baked in when\n"
         "satellite is compiled, so they stay true if the compiler is upgraded or\n"
         "removed afterwards — which is the whole reason they are worth carrying."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.build)\n"
         "}"
         )

// 1 14 1 1 5 0  satellite.library.main.arguments.build()
