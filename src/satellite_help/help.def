SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION_SHELL, LIBRARY_MAIN_ARGUMENTS_SESSION_SHELL,
         "Which shell the program was started from."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session.shell)\n"
         "}"
         )

// 1 14 1 1 8 2  satellite.library.main.arguments.session.terminal
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION_TERMINAL, LIBRARY_MAIN_ARGUMENTS_SESSION_TERMINAL,
         "What kind of terminal the program is running in, or `unrecorded` when there\n"
         "is none — which is the honest answer for a program started by a file\n"
         "manager or a menu."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session.terminal)\n"
         "}"
         )

// 1 14 1 1 8 3  satellite.library.main.arguments.session.language
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION_LANGUAGE, LIBRARY_MAIN_ARGUMENTS_SESSION_LANGUAGE,
         "Which language and encoding the session is set to."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session.language)\n"
         "}"
         )

// 1 14 1 1 8 4  satellite.library.main.arguments.session.home
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION_HOME, LIBRARY_MAIN_ARGUMENTS_SESSION_HOME,
         "Where the home directory is.\n"
         "\n"
         "Taken from `$HOME` first and the password database second, which is the\n"
         "opposite order from `username`: a person may point `$HOME` wherever they\n"
         "like and every other program will honour it."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session.home)\n"
         "}"
         )

// 1 14 1 1 8 5  satellite.library.main.arguments.session.directory
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_SESSION_DIRECTORY, LIBRARY_MAIN_ARGUMENTS_SESSION_DIRECTORY,
         "The directory the program was started in, which is what a relative path is\n"
         "relative to.\n"
         "\n"
         "**It is where the program STARTED**, and it does not move.\n"
         "`satellite.directory.change` changes where the program is working;\n"
         "`satellite.directory.current()` is what answers that. This one stays what\n"
         "it was, because the arguments object is what the program woke up to."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.session.directory)\n"
         "}"
         )

// 1 14 1 1 9  satellite.library.main.arguments.length
SAT_HELP(LIBRARY_MAIN_ARGUMENTS_LENGTH, LIBRARY_MAIN_ARGUMENTS_LENGTH,
         "How many words were on the command line, the program's own name included,\n"
         "as a number.\n"
         "\n"
         "It **describes** the command line rather than being part of it, so it is\n"
         "not one of the words it counts.\n"
         "\n"
         "It was spelled `count` until the object's own methods arrived, and the two\n"
         "words were split so that neither could answer the other's question:\n"
         "`length` is how long the command line is, `count` is how many entries the\n"
         "object holds."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.length)\n"
         "}"
         )

// 1 14 2  satellite.library.system
SAT_HELP(LIBRARY_SYSTEM, LIBRARY_SYSTEM,
         "The four dials that change how the interpreter itself behaves.\n"
         "\n"
         "Each one reads like a value and is written like an assignment, and a\n"
         "change takes effect at once rather than at the next run. They are seeded\n"
         "from `satellite_config.ini` at startup."
         ,
         "satellite.console.display(satellite.library.system.float_digits)\n"
         "satellite.library.system.float_digits = 5\n"
         "satellite.console.display(satellite.library.system.float_digits)"
         )

// 1 14 2 0  satellite.library.system()
SAT_HELP(LIBRARY_SYSTEM_0, LIBRARY_SYSTEM,
         "The bare shape. There is nothing to call; write one of the four dials by\n"
         "name."
         ,
         ""
         )

// 1 14 2 1  satellite.library.system.division_digits
SAT_HELP(LIBRARY_SYSTEM_DIVISION_DIGITS, LIBRARY_SYSTEM_DIVISION_DIGITS,
         "How many digits a division keeps.\n"
         "\n"
         "Retuning it is observed by the very next division rather than at the next\n"
         "run, which is what makes it a dial rather than a setting."
         ,
         "satellite.console.display(1 / 3)\n"
         "satellite.library.system.division_digits = 40\n"
         "satellite.console.display(1 / 3)"
         )

// 1 14 2 2  satellite.library.system.max_depth
SAT_HELP(LIBRARY_SYSTEM_MAX_DEPTH, LIBRARY_SYSTEM_MAX_DEPTH,
         "How deep the interpreter will go before it decides a program has run\n"
         "away with itself.\n"
         "\n"
         "It is a ceiling on memory rather than a limit on the language: the walkers\n"
         "keep their own stacks, so depth here is bounded by what the machine has\n"
         "rather than by a number somebody picked."
         ,
         "satellite.console.display(satellite.library.system.max_depth)"
         )

// 1 14 2 3  satellite.library.system.min_free_mb
SAT_HELP(LIBRARY_SYSTEM_MIN_FREE_MB, LIBRARY_SYSTEM_MIN_FREE_MB,
         "How much memory the interpreter insists on leaving free, so a runaway\n"
         "program is stopped before the machine is.\n"
         "\n"
         "It reads as `nothing` when nothing is being watched, which is not the same\n"
         "as a floor of zero.\n"
         "\n"
         "**Assigning to it retunes the watchdog**, which looks again within a\n"
         "second. A number is a floor in megabytes — `0` included, which stays armed\n"
         "and is never crossed — and the word `\"disabled\"` stops the watch. The\n"
         "configuration file sets it before a program starts; this is how a running\n"
         "program reads and changes it."
         ,
         "satellite.library.system.min_free_mb = 512\n"
         "satellite.console.display(satellite.library.system.min_free_mb)\n"
         "satellite.library.system.min_free_mb = \"disabled\"\n"
         "satellite.console.display(satellite.library.system.min_free_mb)"
         )

// 1 14 2 4  satellite.library.system.float_digits
SAT_HELP(LIBRARY_SYSTEM_FLOAT_DIGITS, LIBRARY_SYSTEM_FLOAT_DIGITS,
         "How many digits a float carries by default.\n"
         "\n"
         "Precision travels with the value, so narrowing this dial changes the\n"
         "floats made after it rather than the ones already held."
         ,
         "satellite.library.system.float_digits = 5\n"
         "satellite.variable.float narrow = 1\n"
         "satellite.console.display(narrow / 3)"
         )

// 1 15  satellite.return
SAT_HELP(RETURN, RETURN,
         "Leaves the capsule it is written in, at once, and optionally hands a\n"
         "value back to whoever called it.\n"
         "\n"
         "A capsule that runs off the end of its body has finished on its own, so\n"
         "this is only needed when you want to leave early or to answer with\n"
         "something."
         ,
         "satellite.capsule biggest(satellite.variable.number a, satellite.variable.number b)\n"
         "{\n"
         "    satellite.statement.if (a > b)\n"
         "    {\n"
         "        satellite.return(a)\n"
         "    }\n"
         "    satellite.return(b)\n"
         "}\n"
         "\n"
         "satellite.console.display(biggest(3, 9))"
         )

// 1 15 0  satellite.return()
SAT_HELP(RETURN_0, RETURN,
         "The bare shape, with nothing between the parentheses. It leaves the\n"
         "capsule and hands nothing back, which is what you want for a capsule that\n"
         "does something rather than answers something.\n"
         "\n"
         "It is the shape to use for an early exit out of a loop's enclosing\n"
         "capsule."
         ,
         "satellite.capsule announce(satellite.variable.string what)\n"
         "{\n"
         "    satellite.console.display(what)\n"
         "    satellite.return()\n"
         "}\n"
         "\n"
         "announce(\"done\")"
         )

// 1 15 1  satellite.return(satellite)
SAT_HELP(RETURN_SATELLITE, RETURN,
         "Ends the program successfully. Written at the end of `satellite.main`, it\n"
         "is how a file says it finished on purpose rather than by running out of\n"
         "lines.\n"
         "\n"
         "The word `satellite` inside the parentheses is part of the path's number\n"
         "and not a value you are returning, so nothing is handed back."
         ,
         "satellite.include(satellite)\n"
         "\n"
         "satellite.capsule satellite.main()\n"
         "{\n"
         "    satellite.console.display(\"Hello, World!\")\n"
         "    satellite.return(satellite)\n"
         "}"
         )

// 1 15 2  satellite.return(value)
SAT_HELP(RETURN_VALUE, RETURN,
         "Hands a value back to the caller.\n"
         "\n"
         "Anything can go here that is a value: a literal, a name, or the answer to\n"
         "another call. Nothing has to be declared in advance for it to work — a\n"
         "capsule that returns a value needs no announcement on its head line."
         ,
         "satellite.capsule double_it(satellite.variable.number n)\n"
         "{\n"
         "    satellite.return(n * 2)\n"
         "}\n"
         "\n"
         "satellite.console.display(double_it(21))"
         )

// 1 16  satellite.analyze
SAT_HELP(ANALYZE, ANALYZE,
         "Reads a satellite file and says what is in it, without running it.\n"
         "\n"
         "**Not built**, and unlike most of the paths here it has no milestone\n"
         "either. It is the one word in the language nobody has scheduled."
         ,
         ""
         )

// 1 17  satellite.bool
SAT_HELP(BOOL, BOOL,
         "The two constants, true and false. They are the only two values a\n"
         "`satellite.variable.bool` can hold and the only two things a condition\n"
         "will accept.\n"
         "\n"
         "They are written out in full. A bare `true` is a name you own, so typing\n"
         "it asks for a variable of yours by that name."
         ,
         "satellite.variable.bool ready = satellite.bool.true\n"
         "satellite.console.display(ready)"
         )

// 1 17 0  satellite.bool()
SAT_HELP(BOOL_0, BOOL,
         "The bare shape. There is nothing to call here; the module holds two\n"
         "constants and you write one of them by name."
         ,
         ""
         )

// 1 17 1  satellite.bool.false
SAT_HELP(BOOL_FALSE, BOOL_FALSE,
         "False, written out. It is a value like any other, so it can be assigned,\n"
         "passed to a capsule, and stored in a list.\n"
         "\n"
         "Write it in full. `false` on its own is a name the program owns, and\n"
         "nothing declares it."
         ,
         "satellite.variable.bool loud = satellite.bool.false\n"
         "satellite.statement.if (loud)\n"
         "{\n"
         "    satellite.console.display(\"loud is true\")\n"
         "}\n"
         "satellite.statement.else\n"
         "{\n"
         "    satellite.console.display(\"loud is false\")\n"
         "}"
         )

// 1 17 2  satellite.bool.true
SAT_HELP(BOOL_TRUE, BOOL_TRUE,
         "True, written out, and the other half of the pair.\n"
         "\n"
         "A condition is a bool and there is no truthiness in this language, so\n"
         "this constant and its opposite are what every test eventually comes down\n"
         "to."
         ,
         "satellite.variable.bool ready = satellite.bool.true\n"
         "satellite.statement.while (ready)\n"
         "{\n"
         "    satellite.console.display(\"once\")\n"
         "    ready = satellite.bool.false\n"
         "}"
         )

// 1 18  satellite.directory
SAT_HELP(DIRECTORY, DIRECTORY,
         "Which directory the program is in, moving between them, and what is inside\n"
         "one.\n"
         "\n"
         "It is not part of the terminal, however much moving between directories\n"
         "feels like a terminal thing: a program run with no terminal at all still has a\n"
         "directory it is in.\n"
         "\n"
         "**There is no word here that makes a directory.** That is a real gap and it\n"
         "is known rather than overlooked -- a word to make one has not been designed,\n"
         "and one invented just to round the module out would be a word designed by\n"
         "symmetry."
         ,
         "satellite.console.display(satellite.directory.exists(\".\"))"
         )

// 1 18 0  satellite.directory()
SAT_HELP(DIRECTORY_0, DIRECTORY,
         "The bare shape. `satellite.directory` is a module and is never called on its\n"
         "own, so this number is reserved and nothing reaches it."
         ,
         ""
         )

// 1 18 1  satellite.directory.change(d)
SAT_HELP(DIRECTORY_CHANGE, DIRECTORY_CHANGE,
         "Moves the program into another directory, and answers whether that worked.\n"
         "\n"
         "**It answers rather than stopping.** Somewhere not being reachable is an\n"
         "ordinary thing for a program to find out, so it comes back as false -- and a\n"
         "path that is a plain file rather than a directory is false too, not a\n"
         "different kind of trouble."
         ,
         "satellite.variable.string here = satellite.directory.current()\n"
         "satellite.console.display(satellite.directory.change(\"nowhere_at_all\"))\n"
         "satellite.console.display(satellite.directory.change(here))"
         )

// 1 18 2  satellite.directory.current()
SAT_HELP(DIRECTORY_CURRENT, DIRECTORY_CURRENT,
         "The directory the program is in, as a full path.\n"
         "\n"
         "This is the one every other path is measured against: a name with no `/` in\n"
         "front of it is read from here."
         ,
         "satellite.variable.string here = satellite.directory.current()\n"
         "satellite.console.display(here.size() > 0)"
         )

// 1 18 3  satellite.directory.exists(d)
SAT_HELP(DIRECTORY_EXISTS, DIRECTORY_EXISTS,
         "Whether there is a directory at this path. A plain file answers false.\n"
         "\n"
         "It is safe to ask about anything, and it never stops the program. Note that\n"
         "it is not a promise that `list` will work: a directory can be there and still\n"
         "not be readable by you."
         ,
         "satellite.console.display(satellite.directory.exists(\".\"))\n"
         "satellite.console.display(satellite.directory.exists(\"nowhere_at_all\"))"
         )

// 1 18 4  satellite.directory.list()
SAT_HELP(DIRECTORY_LIST_0, DIRECTORY_LIST_0,
         "What is in the directory the program is in, as a sorted list of names.\n"
         "\n"
         "`.` and `..` are not in it -- neither is a thing inside the directory, and a\n"
         "program that walked into them would go round forever. Files whose names begin\n"
         "with a dot **are** in it: there are no flags in this language, so there is one\n"
         "answer and it has to be the true one.\n"
         "\n"
         "**This is the one word in the module that stops rather than answering** when\n"
         "there is no such directory. Every other one has somewhere to put bad news; a\n"
         "list has not, because the empty list already means \"an empty directory\", and\n"
         "using it for \"no directory\" would make those two impossible to tell apart.\n"
         "Ask `satellite.directory.exists` first if you are not sure."
         ,
         "satellite.container.list<satellite.variable.string> here = satellite.directory.list()\n"
         "satellite.console.display(here.size() > 0)"
         )

// 1 18 5  satellite.directory.list(d)
SAT_HELP(DIRECTORY_LIST_D, DIRECTORY_LIST_0,
         "The same, for a directory you name."
         ,
         "satellite.container.list<satellite.variable.string> names = satellite.directory.list(\".\")\n"
         "satellite.console.display(names.size() > 0)"
         )

// 1 19  satellite.help
SAT_HELP(HELP, HELP,
         "The language's account of itself. It walks the same tree of words the\n"
         "interpreter dispatches through, so it cannot describe a word that does\n"
         "not exist and cannot leave one out that does.\n"
         "\n"
         "The parentheses are optional when you want everything. Write a path in\n"
         "them to ask about one part of the language, or the name of one of your own\n"
         "variables to ask about its type."
         ,
         "satellite.help"
         )

// 1 19 0  satellite.help()
SAT_HELP(HELP_0, HELP,
         "Everything, from the root down: the topics that are built, one to a line.\n"
         "\n"
         "Each line is indented one tab and carries the topic's path and a sentence\n"
         "saying what it is, and the lines are separated by a blank one so a long\n"
         "list stays readable on a narrow terminal. **Only what is built is\n"
         "listed** — a path no milestone has reached is not offered as somewhere to\n"
         "go.\n"
         "\n"
         "This is the one to type when you do not yet know the name of the thing you\n"
         "are looking for. Then ask about a topic by its path."
         ,
         "satellite.help()"
         )

// 1 19 1  satellite.help(x)
SAT_HELP(HELP_X, HELP,
         "One part of the language, or one of your own variables.\n"
         "\n"
         "Give it a path and you get that node and the words underneath it, so\n"
         "asking about `satellite.console` brings up display and input and the rest\n"
         "together. Give it the name of a variable you declared and you get the help\n"
         "for its type, which is why it still answers after the program that\n"
         "declared it has finished.\n"
         "\n"
         "**Nothing between the parentheses is evaluated.** The argument is a path\n"
         "or a name, never a value, so asking about a module does not try to call\n"
         "it."
         ,
         "satellite.help(satellite.console)"
         )

// 1 20  satellite.network
SAT_HELP(NETWORK, NETWORK,
         "Talking to other machines: serving, connecting, sending and receiving.\n"
         "\n"
         "**Not built** — M27 is the network, and it is the last of the language's\n"
         "modules to be scheduled."
         ,
         ""
         )

// 1 20 0  satellite.network()
SAT_HELP(NETWORK_0, NETWORK,
         "The bare shape. **Not built** — M27."
         ,
         ""
         )

// 1 20 1  satellite.network.http(port)
SAT_HELP(NETWORK_HTTP_PORT, NETWORK_HTTP_PORT,
         "Serves HTTP on a port. **Not built** — M27."
         ,
         ""
         )

// 1 20 2  satellite.network.https(host, port)
SAT_HELP(NETWORK_HTTPS_HOST_PORT, NETWORK_HTTPS_HOST_PORT,
         "Connects to a host over HTTPS. **Not built** — M27."
         ,
         ""
         )

// 1 20 3  satellite.network.new
SAT_HELP(NETWORK_NEW, NETWORK_NEW,
         "Makes a connection. **Not built** — M27."
         ,
         ""
         )

// 1 20 4  satellite.network.open
SAT_HELP(NETWORK_OPEN, NETWORK_OPEN,
         "Opens one. **Not built** — M27."
         ,
         ""
         )

// 1 20 5  satellite.network.receive
SAT_HELP(NETWORK_RECEIVE, NETWORK_RECEIVE,
         "Reads what arrived. **Not built** — M27."
         ,
         ""
         )

// 1 20 6  satellite.network.http(host, port)
SAT_HELP(NETWORK_HTTP_HOST_PORT, NETWORK_HTTP_PORT,
         "Connects to a host over HTTP. **Not built** — M27."
         ,
         ""
         )

// 1 20 7  satellite.network.https(port, cert, key)
SAT_HELP(NETWORK_HTTPS_PORT_CERT_KEY, NETWORK_HTTPS_HOST_PORT,
         "Serves HTTPS on a port, with a certificate and a key. **Not built** —\n"
         "M27."
         ,
         ""
         )

// 1 21  satellite.returns
SAT_HELP(RETURNS, RETURNS,
         "An optional note on a capsule's head line saying what kind of value it\n"
         "hands back, written after the parameters and before the brace.\n"
         "\n"
         "**It is optional and it is not how capsules are written here.** A capsule\n"
         "without it returns values perfectly well, no file under `example/` uses\n"
         "it, and DESIGN calls it optional where it specifies it. What you actually\n"
         "write is `satellite.return(value)` in the body, and in\n"
         "`satellite.main` that is `satellite.return(satellite)` on the last line."
         ,
         "satellite.capsule name_of(satellite.variable.number n)\n"
         "{\n"
         "    satellite.return(n.to_string())\n"
         "}\n"
         "\n"
         "satellite.console.display(name_of(7))"
         )

// 1 22  satellite.system
SAT_HELP(SYSTEM, SYSTEM,
         "The machine the program is running on, and the interpreter's own switches.\n"
         "\n"
         "Most of what is here describes memory, and the rest is what the machine and\n"
         "the session are: where home is, what the environment holds, how loose a\n"
         "search may be, and whether the prompt keeps what a line declares."
         ,
         "satellite.console.display(satellite.system.memory.total(\"gb\"))"
         )

// 1 22 0  satellite.system()
SAT_HELP(SYSTEM_0, SYSTEM,
         "The bare shape. There is nothing to call; one of the words underneath is\n"
         "what you write."
         ,
         ""
         )

// 1 22 1  satellite.system.delete(x)
SAT_HELP(SYSTEM_DELETE, SYSTEM_DELETE,
         "Removes a file, or an **empty** directory, and answers whether it is gone.\n"
         "\n"
         "It takes either a path or an open file, so a program already holding a file\n"
         "does not have to say its name a second time.\n"
         "\n"
         "**It is under `satellite.system` because it is one word about two kinds of\n"
         "thing.** A `satellite.file.delete` and a `satellite.directory.delete` would\n"
         "each be half an answer, and a program holding a path very often does not know\n"
         "which of the two it has.\n"
         "\n"
         "**It does not go into a directory, and there is no way to ask it to.** A\n"
         "removal that quietly descended is the one mistake here nobody could take back.\n"
         "Walk `satellite.directory.list` and say each name out loud instead.\n"
         "\n"
         "False always means \"it is still there\" -- nothing was at that path, or the\n"
         "directory was not empty, or it was not yours to remove."
         ,
         "satellite.variable.file f = satellite.file.new(\"delete_demo.txt\")\n"
         "f.close()\n"
         "satellite.console.display(satellite.system.delete(\"delete_demo.txt\"))\n"
         "satellite.console.display(satellite.system.delete(\"delete_demo.txt\"))"
         )

// 1 22 2  satellite.system.environment
SAT_HELP(SYSTEM_ENVIRONMENT, SYSTEM_ENVIRONMENT,
         "The environment the program was started in, as a map of every variable.\n"
         "\n"
         "For a single variable, write `satellite.system.environment(name)`, which\n"
         "answers nothing when it is not set."
         ,
         "satellite.container.map<satellite.variable.string, satellite.variable.string> all = satellite.system.environment\n"
         "satellite.console.display(all.size() > 0)"
         )

// 1 22 3  satellite.system.home
SAT_HELP(SYSTEM_HOME, SYSTEM_HOME,
         "The home directory of whoever is running the program.\n"
         "\n"
         "Asked of the environment first and of the password database when that is\n"
         "empty, because `$HOME` can be unset or forged and the password database is\n"
         "the authority."
         ,
         "satellite.console.display(satellite.system.home)"
         )

// 1 22 4  satellite.system.memory
SAT_HELP(SYSTEM_MEMORY, SYSTEM_MEMORY,
         "How much memory there is, in every sense of the question: the machine's,\n"
         "this program's, the swap file's, and this thread's stack.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.total(\"gb\"))"
         )

// 1 22 4 0  satellite.system.memory()
SAT_HELP(SYSTEM_MEMORY_0, SYSTEM_MEMORY,
         "The whole section at a glance — every word underneath that answers on its\n"
         "own, in one map: the firmware pair, this process, the swap file, and the\n"
         "machine's own free, total and used.\n"
         "\n"
         "The entries come out in megabytes, which is the unit you get without\n"
         "asking. A program that wants another names the word it wants and the unit\n"
         "with it — `satellite.system.memory.total(\"gb\")`.\n"
         "\n"
         "`this` is not in the map, because this thread's stack has no answer on its\n"
         "own yet. Leaving it out says that; a blank beside seven numbers would not."
         ,
         "satellite.console.display(satellite.system.memory())"
         )

// 1 22 4 1  satellite.system.memory.bit
SAT_HELP(SYSTEM_MEMORY_BIT, SYSTEM_MEMORY_BIT,
         "How wide the memory bus is, in bits — 64 on an ordinary machine, 72 where\n"
         "the memory carries error correction.\n"
         "\n"
         "**It answers 0 unless satellite is running as root**, and 0 is the truthful\n"
         "answer rather than a failure: this comes from the firmware's SMBIOS table,\n"
         "which is readable by root alone on every ordinary Linux."
         ,
         "satellite.console.display(satellite.system.memory.bit)"
         )

// 1 22 4 2  satellite.system.memory.frequency
SAT_HELP(SYSTEM_MEMORY_FREQUENCY, SYSTEM_MEMORY_FREQUENCY,
         "How fast the memory is clocked, in MT/s.\n"
         "\n"
         "**It answers 0 unless satellite is running as root**, for the same reason\n"
         "`bit` does: the firmware table it comes from is root-only."
         ,
         "satellite.console.display(satellite.system.memory.frequency)"
         )

// 1 22 4 3  satellite.system.memory.main()
SAT_HELP(SYSTEM_MEMORY_MAIN_0, SYSTEM_MEMORY_MAIN_0,
         "This program's own memory — its resident set, read fresh every time you\n"
         "ask, so a loop can watch itself grow.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.main(\"kb\") > 0)"
         )

// 1 22 4 4  satellite.system.memory.swap
SAT_HELP(SYSTEM_MEMORY_SWAP, SYSTEM_MEMORY_SWAP,
         "The swap file, which is the disk the machine uses when memory runs out.\n"
         "\n"
         "**A machine with no swap answers 0 to all three**, and that is truthful\n"
         "rather than a failed read.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         ""
         )

// 1 22 4 4 0  satellite.system.memory.swap()
SAT_HELP(SYSTEM_MEMORY_SWAP_0, SYSTEM_MEMORY_SWAP,
         "**How much swap is available** — what is left of the swap file, in\n"
         "megabytes.\n"
         "\n"
         "That is the useful question about a swap file, so it is the one you get\n"
         "for naming it. `swap.free()` is the same number under its own name, the\n"
         "way `memory.free()` and `this.available()` are, and `swap.total()` is how\n"
         "big the file is altogether."
         ,
         "satellite.console.display(satellite.system.memory.swap())"
         )

// 1 22 4 4 1  satellite.system.memory.swap.free()
SAT_HELP(SYSTEM_MEMORY_SWAP_FREE_0, SYSTEM_MEMORY_SWAP_FREE_0,
         "How much swap is unused."
         ,
         "satellite.console.display(satellite.system.memory.swap.free(\"mb\") >= 0)"
         )

// 1 22 4 4 2  satellite.system.memory.swap.total()
SAT_HELP(SYSTEM_MEMORY_SWAP_TOTAL_0, SYSTEM_MEMORY_SWAP_TOTAL_0,
         "How much swap there is altogether."
         ,
         "satellite.console.display(satellite.system.memory.swap.total(\"mb\") >= 0)"
         )

// 1 22 4 4 3  satellite.system.memory.swap.used
SAT_HELP(SYSTEM_MEMORY_SWAP_USED, SYSTEM_MEMORY_SWAP_USED,
         "How much swap is in use.\n"
         "\n"
         "**Total minus free, and not total minus available** as the machine's own\n"
         "memory is: swap holds no reclaimable cache, so there is nothing for\n"
         "\"available\" to mean here that \"free\" does not already mean."
         ,
         "satellite.console.display(satellite.system.memory.swap.used(\"mb\") >= 0)"
         )

// 1 22 4 4 4  satellite.system.memory.swap.free(unit)
SAT_HELP(SYSTEM_MEMORY_SWAP_FREE_UNIT, SYSTEM_MEMORY_SWAP_FREE_0,
         "How much swap is unused, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.swap.free(\"gb\") >= 0)"
         )

// 1 22 4 4 5  satellite.system.memory.swap.total(unit)
SAT_HELP(SYSTEM_MEMORY_SWAP_TOTAL_UNIT, SYSTEM_MEMORY_SWAP_TOTAL_0,
         "How much swap there is altogether, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.swap.total(\"gb\") >= 0)"
         )

// 1 22 4 4 6  satellite.system.memory.swap(unit)
SAT_HELP(SYSTEM_MEMORY_SWAP_UNIT, SYSTEM_MEMORY_SWAP,
         "**How much swap is available**, in the unit you name — the same question\n"
         "the bare word answers.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.swap(\"gb\"))"
         )

// 1 22 4 4 7  satellite.system.memory.swap.used(unit)
SAT_HELP(SYSTEM_MEMORY_SWAP_USED_UNIT, SYSTEM_MEMORY_SWAP_USED,
         "How much swap is in use, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.swap.used(\"kb\") >= 0)"
         )

// 1 22 4 5  satellite.system.memory.this
SAT_HELP(SYSTEM_MEMORY_THIS, SYSTEM_MEMORY_THIS,
         "This thread's own stack, as against the machine's memory.\n"
         "\n"
         "**The running thread's, and deliberately so.** Linux accounts an address\n"
         "space per process, so a heap-per-thread figure would be the same number for\n"
         "every thread and would answer nothing.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         ""
         )

// 1 22 4 5 0  satellite.system.memory.this()
SAT_HELP(SYSTEM_MEMORY_THIS_0, SYSTEM_MEMORY_THIS,
         "The bare shape. One of the words underneath is what you write."
         ,
         ""
         )

// 1 22 4 5 1  satellite.system.memory.this.available()
SAT_HELP(SYSTEM_MEMORY_THIS_AVAILABLE_0, SYSTEM_MEMORY_THIS_AVAILABLE_0,
         "How much room this thread still has on its stack."
         ,
         "satellite.console.display(satellite.system.memory.this.available(\"kb\") > 0)"
         )

// 1 22 4 5 2  satellite.system.memory.this.free()
SAT_HELP(SYSTEM_MEMORY_THIS_FREE_0, SYSTEM_MEMORY_THIS_FREE_0,
         "How much room this thread still has on its stack — the same\n"
         "question `available` asks, because a word means one thing everywhere."
         ,
         "satellite.console.display(satellite.system.memory.this.free(\"kb\") > 0)"
         )

// 1 22 4 5 3  satellite.system.memory.this.used
SAT_HELP(SYSTEM_MEMORY_THIS_USED, SYSTEM_MEMORY_THIS_USED,
         "How much of its stack this thread is using."
         ,
         "satellite.console.display(satellite.system.memory.this.used(\"kb\") > 0)"
         )

// 1 22 4 5 4  satellite.system.memory.this.available(unit)
SAT_HELP(SYSTEM_MEMORY_THIS_AVAILABLE_UNIT, SYSTEM_MEMORY_THIS_AVAILABLE_0,
         "How much room this thread still has, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.this.available(\"kb\") > 0)"
         )

// 1 22 4 5 5  satellite.system.memory.this.free(unit)
SAT_HELP(SYSTEM_MEMORY_THIS_FREE_UNIT, SYSTEM_MEMORY_THIS_FREE_0,
         "How much room this thread still has, in the unit you name — the\n"
         "same question `available(unit)` asks.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.this.free(\"kb\") > 0)"
         )

// 1 22 4 5 6  satellite.system.memory.this.used(unit)
SAT_HELP(SYSTEM_MEMORY_THIS_USED_UNIT, SYSTEM_MEMORY_THIS_USED,
         "How much of its stack this thread is using, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.this.used(\"kb\") > 0)"
         )

// 1 22 4 6  satellite.system.memory.free()
SAT_HELP(SYSTEM_MEMORY_FREE_0, SYSTEM_MEMORY_FREE_0,
         "How much of the machine's memory is unused.\n"
         "\n"
         "**Unused means AVAILABLE and not free.** Linux spends every spare page\n"
         "on cache, so the \"free\" figure on a healthy machine is a small\n"
         "frightening number; available is what a program can still have."
         ,
         "satellite.console.display(satellite.system.memory.free(\"mb\") > 0)"
         )

// 1 22 4 7  satellite.system.memory.total()
SAT_HELP(SYSTEM_MEMORY_TOTAL_0, SYSTEM_MEMORY_TOTAL_0,
         "How much memory the machine has altogether."
         ,
         "satellite.console.display(satellite.system.memory.total(\"gb\") > 0)"
         )

// 1 22 4 8  satellite.system.memory.used()
SAT_HELP(SYSTEM_MEMORY_USED_0, SYSTEM_MEMORY_USED_0,
         "How much of the machine's memory is in use — its total less what\n"
         "is available."
         ,
         "satellite.console.display(satellite.system.memory.used(\"mb\") > 0)"
         )

// 1 22 4 9  satellite.system.memory.main(unit)
SAT_HELP(SYSTEM_MEMORY_MAIN_UNIT, SYSTEM_MEMORY_MAIN_0,
         "This program's own memory, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.main(\"kb\") > 0)"
         )

// 1 22 4 10  satellite.system.memory.free(unit)
SAT_HELP(SYSTEM_MEMORY_FREE_UNIT, SYSTEM_MEMORY_FREE_0,
         "How much of the machine's memory is unused, in the unit you name.\n"
         "\n"
         "**Unused means AVAILABLE and not free.** Linux spends every spare page\n"
         "on cache, so the \"free\" figure on a healthy machine is a small\n"
         "frightening number; available is what a program can still have.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.free(\"gb\") > 0)"
         )

// 1 22 4 11  satellite.system.memory.total(unit)
SAT_HELP(SYSTEM_MEMORY_TOTAL_UNIT, SYSTEM_MEMORY_TOTAL_0,
         "How much memory the machine has altogether, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.total(\"gb\") > 0)"
         )

// 1 22 4 12  satellite.system.memory.used(unit)
SAT_HELP(SYSTEM_MEMORY_USED_UNIT, SYSTEM_MEMORY_USED_0,
         "How much of the machine's memory is in use, in the unit you name.\n"
         "\n"
         "The unit is `\"b\"`, `\"kb\"`, `\"mb\"`, `\"gb\"` or `\"tb\"`, and `\"mb\"` is\n"
         "what you get without asking. Every one of them is a power of 1024 away\n"
         "from a byte, so the answer is exact and never rounds."
         ,
         "satellite.console.display(satellite.system.memory.used(\"gb\") > 0)"
         )

// 1 22 5  satellite.system.threshold()
SAT_HELP(SYSTEM_THRESHOLD_0, SYSTEM_THRESHOLD_0,
         "Answers how loose a search is allowed to be at the moment.\n"
         "\n"
         "The scale runs from 1, which is an exact match and nothing else, up to\n"
         "10. At 6 a substring matches either way round."
         ,
         "satellite.console.display(satellite.system.threshold())"
         )

// 1 22 6  satellite.system.threshold(n)
SAT_HELP(SYSTEM_THRESHOLD_N, SYSTEM_THRESHOLD_0,
         "Sets how loose a search may be, and answers what it now is.\n"
         "\n"
         "It is what `search` on a list or a map reads, so turn it up to find near\n"
         "misses and down to insist on the exact thing."
         ,
         "satellite.system.threshold(6)\n"
         "satellite.console.display(satellite.system.threshold())"
         )

// 1 22 7  satellite.system.persist()
SAT_HELP(SYSTEM_PERSIST_0, SYSTEM_PERSIST_0,
         "Answers whether the prompt is keeping what each line declares.\n"
         "\n"
         "It is on to begin with, which is why a variable you declare at the prompt\n"
         "is still there on the next line."
         ,
         "satellite.console.display(satellite.system.persist())"
         )

// 1 22 8  satellite.system.persist(x)
SAT_HELP(SYSTEM_PERSIST_X, SYSTEM_PERSIST_0,
         "Turns the prompt's memory of declarations on or off, and answers what it\n"
         "now is.\n"
         "\n"
         "Turning it off does not throw away what is already held; it stops the next\n"
         "line adding to it, so a program can switch it off around one line and back\n"
         "on afterwards. It wants a real bool, so write\n"
         "`satellite.bool.false` rather than a bare word."
         ,
         "satellite.console.display(satellite.system.persist(satellite.bool.false))\n"
         "satellite.console.display(satellite.system.persist(satellite.bool.true))"
         )

// 1 22 9  satellite.system.environment(name)
SAT_HELP(SYSTEM_ENVIRONMENT_NAME, SYSTEM_ENVIRONMENT,
         "One environment variable, by name.\n"
         "\n"
         "Written bare, `satellite.system.environment` answers a map of the whole\n"
         "environment; given a name it answers just that one.\n"
         "\n"
         "**A name that is not set answers nothing, not an empty string.** An empty\n"
         "string is a value a variable can really hold, so the two must stay apart."
         ,
         "satellite.console.display(satellite.system.environment(\"HOME\"))\n"
         "satellite.console.display(satellite.system.environment(\"NO_SUCH_VARIABLE\"))"
         )

// 1 23  satellite.thread
SAT_HELP(THREAD, THREAD,
         "Running more than one thing at once. `satellite.thread.new` is the whole of the module; everything else a thread can do is asked of the thread itself -- `start()` and `join()`."
         ,
         ""
         )

// 1 23 0  satellite.thread()
SAT_HELP(THREAD_0, THREAD,
         "The bare shape. `satellite.thread` is a family name rather than something to call, so this number is reserved and nothing reaches it."
         ,
         ""
         )

// 1 23 1  satellite.thread.new
SAT_HELP(THREAD_NEW, THREAD_NEW,
         "Makes a thread out of a call to one of your own capsules. It does not start it -- `start()` does that.\n"
         "\n"
         "**What goes inside is a call, written out.** The arguments are worked out now, where you wrote them; the capsule itself is not entered until the thread starts. So a value that changes afterwards does not change what the thread was given.\n"
         "\n"
         "It has to be a capsule you declared. `satellite.thread.new` cannot be handed one of the language's own words."
         ,
         "satellite.capsule double_it(satellite.variable.number n) satellite.returns(satellite.variable.number)\n"
         "{\n"
         "    satellite.return(n * 2)\n"
         "}\n"
         "satellite.variable.thread t = satellite.thread.new(double_it(21))\n"
         "t.start()\n"
         "satellite.console.display(t.join())"
         )

// 1 24  satellite.window
SAT_HELP(WINDOW, WINDOW,
         "Windows on the screen, drawn by the program rather than by the terminal.\n"
         "\n"
         "**Not built** — M24. It is meant to arrive as a library loaded the first\n"
         "time a program asks for a window, so a program that never opens one never\n"
         "pays for it."
         ,
         ""
         )

// 1 24 0  satellite.window()
SAT_HELP(WINDOW_0, WINDOW,
         "The bare shape. **Not built** — M24."
         ,
         ""
         )

// 1 24 1  satellite.window.new
SAT_HELP(WINDOW_NEW, WINDOW_NEW,
         "Makes a window. **Not built** — M24."
         ,
         ""
         )

// 1 24 2  satellite.window.console
SAT_HELP(WINDOW_CONSOLE, WINDOW_CONSOLE,
         "A window that behaves like the terminal, so a program that prints can be\n"
         "given one without being rewritten.\n"
         "\n"
         "**Not built** — M24."
         ,
         ""
         )

// 1 24 2 0  satellite.window.console()
