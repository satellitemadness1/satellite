SAT_HELP(LIBRARY_MAIN_ARGUMENTS_INTERPRETER_LIBRARY_PATH_SOURCE, LIBRARY_MAIN_ARGUMENTS_INTERPRETER_LIBRARY_PATH_SOURCE,
         "Which of the ways of finding the library path answered — the environment,\n"
         "the directory beside the binary, or the one compiled in.\n"
         "\n"
         "**Not built** — M25, with `library_path` itself."
         ,
         "satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)\n"
         "{\n"
         "    satellite.console.display(arguments.interpreter.library_path_source)\n"
         "}"
         )

