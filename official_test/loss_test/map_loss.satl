// map_loss.satl -- the loss test for satellite.container.map (satellite 004, build 0039)
//
// The author's standard, 2026-10-06: "for the loss testing, we will use the number 547311173 so we
// have to start with that number, and end at that number, after say, 1,000,000 million operations...
// That will be the loss test" -- 547311173 is "satellite" spelled as numbers: 5 looks like S, 4 like A,
// 7 like T. And: "so we will use the number satellite, and the numbers 1 trillion and 1 million for
// testing" -- 1 million operations for a loss test: 100 different operations, run 10,000 times.
//
// 547311173 is "satellite" spelled as numbers, so the map files each digit under the word up to the
// letter it looks like: {"s": 5, "sa": 4, "sat": 7, ... "satellite": 3} -- a map of string to number,
// its keys already in a map's own order, and its values read 547311173. Each pass runs 100 different
// operations on it: 1-50 carry it far from where it began -- sorted by value, 547311173 filed under new
// keys as a number, a float, a string, a list (a map of lists) and a map (a map in a map), a number
// and a bool as keys, every digit changed by a different operation, entries moved into the list and
// the maps inside it and taken out of the map, its size, keys, values, first and last read and folded
// into a value -- and 51-100 undo them, the last one first, each by a different operation again. The
// undos read the new entries back (the number, the float, the string, the list joined, the map in the
// map, the number key), so an entry that changed on its way through is caught.
// 10,000 passes = 1,000,000 operations.
//
// FIXED 2026-10-06, after a fresh reviewer injected losses that still ended at 547311173:
// - EVERY WHOLE-NUMBER / KEEPS ITS REMAINDER (30, 58, 77, 84, 85, 90, 91): a / D is written
//   a / D + a % D * far, far = 10 ^ 1000. / cuts toward zero, so x["satellite"] + 1 came back 3 from
//   / 10 and / 547311173, 90 let any error below 7 ^ 49 in 7 ^ 50 vanish, and 30 -- forward, on the
//   only copy of 7 ^ 50 -- cut one away before anything could read it. The remainder is 0 when nothing
//   was lost; any other remainder, times far, lands out of reach of everything after it.
// - 92 TAKES 547311168 AWAY instead of % 547311168, which answered 5 even when 9 had added nothing.
// - WHAT AN OPERATION CANNOT SEE IS CHECKED BEFORE IT RUNS, against the exact value it must be given:
//   lost(held, must) answers 1 when held is not exactly that, and wrong counts them. Each check line
//   names the operation it guards:
//     entries dropped unread -- each entry 93-99 take out, read just before it goes (the bool key's
//     value was never read at all), the keys 50 filed (51), the box (66, so a clear that did nothing
//     is seen);
//     a sort, which puts any order back -- the keys before 100 (without it the last
//     .keys == start.keys could not fail), the map in the map before 48 and 53;
//     a text minus, which answers the text unchanged when what it takes away never came -- the string
//     before 52 (52-62), the number key's text before 75;
//     upper and lower, which cannot see a letter that changed case -- the string before 22 and 79;
//     ^ 50, since -7 to the 50th is the same number -- x["sat"] before 11;
//     a number's .reverse(), which drops the zeros it ends with, so x * 10 would come back --
//     x["number"] before 18 and 83;
//     a float division that rounds a loss in its last places away -- before / 64 (19) and
//     / 547311173.0 (88).
// - EVERY PASS IS CHECKED, not only the last: a pass must end with the entries it began with, in the
//   same order, or the run stops there -- a loss undone by itself on the next pass would be back after
//   an even number of them.
// The answer is always 547311173: it prints 547311173 when every check held and every pass ended with
// exactly the entries the map began with -- == on two maps is strict about every value -- in the same
// order (.keys compared as lists), and otherwise one line: {"pass", the pass that went wrong, "wrong",
// how many checks failed in it, the map at its end}.
satellite.include(satellite)

// lost(held, must): 1 when held is not exactly must, 0 when it is. {held} == {must} compares inside
// lists, which is strict, and answers false -- not a refusal -- when a loss changed held's type.
satellite.capsule lost(satellite.container.multiple held, satellite.container.multiple must)
{
    satellite.statement.if ({held} == {must})
    {
        satellite.return(0)
    }
    satellite.return(1)
}

satellite.capsule satellite.main()
{
    satellite.container.map x = {"s": 5, "sa": 4, "sat": 7, "sate": 3, "satel": 1, "satell": 1, "satelli": 1, "satellit": 7, "satellite": 3}
    satellite.container.map start = {"s": 5, "sa": 4, "sat": 7, "sate": 3, "satel": 1, "satell": 1, "satelli": 1, "satellit": 7, "satellite": 3}
    satellite.variable.number far = 10 ^ 1000                                                                            // where a division puts a remainder: out of reach
    satellite.variable.number wrong = 0                                                                                  // how many checks failed
    satellite.variable.number failed = 0                                                                                 // the pass they failed in
    satellite.statement.for(satellite.variable.number pass = 0; pass < 10000; pass + 1)
    {
        // 1-50: away from where it began
        x = x.sort("value")                                                                                              // 1: the entries in value order
        x["number"] = 547311173                                                                                          // 2: 547311173 itself, under a new key
        x.set("float", 547311173.0)                                                                                      // 3: as a float, with .set
        x["string"] = "547311173"                                                                                        // 4: as a string
        x["digits"] = {5, 4, 7, 3, 1, 1, 1, 7, 3}                                                                        // 5: as a list of its digits: a map of lists
        x["map"] = {"satellite": 547311173}                                                                              // 6: as a map: a map in the map
        x[547311173] = "satellite"                                                                                       // 7: a number as a key
        x[satellite.bool.true] = 547311173.5                                                                             // 8: a bool as a key
        x["s"] = x["s"] + 547311168                                                                                      // 9: 5 -> 547311173
        x["sa"] = x["sa"] * 136827793                                                                                    // 10: 4 -> 547311172
        wrong = wrong + lost(x["sat"], 7)                                                                                // check: ^ 50 cannot see a sign, -7 to the 50th is the same number
        x["sat"] = x["sat"] ^ 50                                                                                         // 11: 7 -> 7 ^ 50, 43 digits
        x["sate"] = x["sate"] - 547311176                                                                                // 12: 3 -> -547311173
        x["satel"] = x["satel"] * 547311173.0                                                                            // 13: 1 -> 547311173.0, a float
        x["satell"] = x["satell"] + "547311173"                                                                          // 14: 1 -> 547311174: a number plus text that spells a number
        x["satelli"] = x["satelli"] - 547311173                                                                          // 15: 1 -> -547311172
        x["satellit"] = x["satellit"] * 10000000000000000000000000000000000000000                                        // 16: 7 -> 7 and 40 zeros
        x["satellite"] = x["satellite"] * 547311173                                                                      // 17: 3 -> 1641933519
        wrong = wrong + lost(x["number"], 547311173)                                                                     // check: a number's .reverse() drops the zeros it ends with, so x * 10 would come back
        x["number"] = x["number"].reverse()                                                                              // 18: 547311173 -> 371113745
        wrong = wrong + lost(x["float"], 547311173.0)                                                                    // check: / 64 rounds a loss in the 128th place away
        x["float"] = x["float"] / 64                                                                                     // 19: -> 8551737.078125
        x["float"] = x["float"] - 8551737                                                                                // 20: -> 0.078125
        x["string"] = x["string"] + "satellite"                                                                          // 21: -> "547311173satellite"
        wrong = wrong + lost(x["string"], "547311173satellite")                                                          // check: 22 cannot see a letter that changed case
        x["string"] = x["string"].upper()                                                                                // 22: -> "547311173SATELLITE"
        x["string"] = x["string"].reverse()                                                                              // 23: -> "ETILLETAS371113745"
        x["digits"][1] = x["digits"][1] * x["digits"].sum                                                                // 24: 5 * 32 = 160, inside the list in the map
        x["map"]["satellite"] = x["map"]["satellite"] - 547311170                                                        // 25: 3, inside the map in the map
        x[547311173] = x[547311173] + "!"                                                                                // 26: "satellite!", under the number key
        x[satellite.bool.true] = x[satellite.bool.true] * 2                                                              // 27: 1094622347.0, under the bool key
        x["digits"].append(x["sat"])                                                                                     // 28: 7 ^ 50 copied into the list in the map ...
        x.remove("sat")                                                                                                  // 29: ... and "sat" taken out: it lives only in the list
        x["digits"][10] = x["digits"][10] / 7 + x["digits"][10] % 7 * far                                                // 30: 7 ^ 49, written inside the list inside the map, its remainder kept
        x["map"]["s"] = x["s"]                                                                                           // 31: 547311173 copied into the map in the map ...
        x.remove("s")                                                                                                    // 32: ... and "s" taken out
        x["moved"] = x.get("satel")                                                                                      // 33: the first entry's value copied with .get ...
        x.remove_first()                                                                                                 // 34: ... and the first entry, "satel", taken out
        x["box"] = satellite.container.map()                                                                             // 35: an empty map
        x["box"]["sa"] = x["sa"]                                                                                         // 36: 547311172 copied into it ...
        x.remove("sa")                                                                                                   // 37: ... and "sa" taken out
        x["sate"] = x["sate"] + x.size                                                                                   // 38: + how many entries there are, 14
        x["string"] = x["string"] + x.first                                                                              // 39: + the first key now, "satell"
        x["string"] = x["string"] + x.has("s")                                                                           // 40: + " false": "s" is gone
        x["string"] = x["string"] + x["map"].contains("s")                                                               // 41: + " true": it is in the map in the map
        x["string"] = x["string"] + "?" + x["box"].empty                                                                 // 42: + "? false": the box holds "sa"
        x["satellite"] = x["satellite"] * x["digits"].size                                                               // 43: * 10, the size of the list in the map
        x["satellit"] = x["satellit"] + x["digits"].max                                                                  // 44: + 7 ^ 49, its largest
        x["satelli"] = x["satelli"] - x["digits"].min                                                                    // 45: - 1, its smallest
        x["number"] = x["number"] + x.values.size                                                                        // 46: + how many values there are, 14
        x["string"] = x["string"] + x.keys.join("")                                                                      // 47: + every key's text, in order
        wrong = wrong + lost(x["map"].keys, {"satellite", "s"})                                                          // check: its order, before 48 sorts any order back
        x["map"] = x["map"].sort()                                                                                       // 48: the map in the map in key order
        x["string"] = x["string"] + "<" + x.last + ">"                                                                   // 49: + the newest key, "<box>"
        x["keys"] = x.keys                                                                                               // 50: the keys, as a list under a key of their own
        // 51-100: back again, each undoing one of 1-50, the last one first
        wrong = wrong + lost(x["keys"], {"satell", "satelli", "sate", "satellite", "satellit", "number", "float", "string", "digits", "map", 547311173, satellite.bool.true, "moved", "box"}) // check: the keys 50 filed, before 51 drops them unread
        x.remove_last()                                                                                                  // 51: undoes 50, the newest entry, "keys"
        wrong = wrong + lost(x["string"], "ETILLETAS371113745satell false true? falsesatellsatellisatesatellitesatellitnumberfloatstringdigitsmap547311173truemovedbox<box>") // check: 52-62 answer the text unchanged when what they take away never came
        x["string"] = x["string"] - "<box>"                                                                              // 52: undoes 49
        wrong = wrong + lost(x["map"].keys, {"s", "satellite"})                                                          // check: its order, before 53 sorts any order back
        x["map"] = x["map"].sort("value")                                                                                // 53: undoes 48, its own order again: 3 before 547311173
        x["string"] = x["string"] - "satellsatellisatesatellitesatellitnumberfloatstringdigitsmap547311173truemovedbox"  // 54: undoes 47
        x["number"] = x["number"] - 14                                                                                   // 55: undoes 46
        x["satelli"] = x["satelli"] + 1                                                                                  // 56: undoes 45
        x["satellit"] = x["satellit"] - 256923577521058878088611477224235621321607                                       // 57: undoes 44, 7 ^ 49
        x["satellite"] = x["satellite"] / 10 + x["satellite"] % 10 * far                                                 // 58: undoes 43, its remainder kept
        x["string"] = x["string"] - "? false"                                                                            // 59: undoes 42
        x["string"] = x["string"] - " true"                                                                              // 60: undoes 41
        x["string"] = x["string"] - " false"                                                                             // 61: undoes 40
        x["string"] = x["string"] - "satell"                                                                             // 62: undoes 39
        x["sate"] = x["sate"] - 14                                                                                       // 63: undoes 38
        x["sa"] = x["box"]["sa"]                                                                                         // 64: undoes 37, 547311172 back from the box
        x["box"].clear()                                                                                                 // 65: undoes 36
        wrong = wrong + lost(x["box"].size, 0)                                                                           // check: the box 65 cleared, before 66 drops it whole
        x.remove("box")                                                                                                  // 66: undoes 35
        x["satel"] = x["moved"]                                                                                          // 67: undoes 34
        x.remove("moved")                                                                                                // 68: undoes 33
        x["s"] = x["map"]["s"]                                                                                           // 69: undoes 32, 547311173 back from the map in the map
        x["map"].remove_last()                                                                                           // 70: undoes 31, its newest entry, "s"
        x["digits"][10] = x["digits"][10] * 7                                                                            // 71: undoes 30
        x["sat"] = x["digits"].last                                                                                      // 72: undoes 29, 7 ^ 50 back from the list
        x["digits"].remove_last()                                                                                        // 73: undoes 28
        x[satellite.bool.true] = x[satellite.bool.true] / 2                                                              // 74: undoes 27
        wrong = wrong + lost(x[547311173], "satellite!")                                                                 // check: 75 answers the text unchanged when its "!" never came
        x[547311173] = x[547311173] - "!"                                                                                // 75: undoes 26
        x["map"]["satellite"] = x["map"]["satellite"] + 547311170                                                        // 76: undoes 25
        x["digits"][1] = x["digits"][1] / 32 + x["digits"][1] % 32 * far                                                 // 77: undoes 24, its remainder kept
        x["string"] = x["string"].split("").reverse().join("")                                                           // 78: undoes 23
        wrong = wrong + lost(x["string"], "547311173SATELLITE")                                                          // check: 79 cannot see a capital letter that went missing
        x["string"] = x["string"].lower()                                                                                // 79: undoes 22
        x["string"] = x["string"] - x[547311173]                                                                         // 80: undoes 21, taking away what the number key holds, "satellite"
        x["float"] = x["float"] + 8551737                                                                                // 81: undoes 20
        x["float"] = x["float"] * 64                                                                                     // 82: undoes 19
        wrong = wrong + lost(x["number"], 371113745)                                                                     // check: 83's .reverse() drops a number's end zeros too
        x["number"] = x["number"].string.reverse().number                                                                // 83: undoes 18
        x["satellite"] = x["satellite"] / x["digits"].join("").number + x["satellite"] % x["digits"].join("").number * far // 84: undoes 17, the list in the map joined back into 547311173, its remainder kept
        x["satellit"] = x["satellit"] / 10000000000000000000000000000000000000000 + x["satellit"] % 10000000000000000000000000000000000000000 * far // 85: undoes 16, its remainder kept
        x["satelli"] = x["satelli"] + x["number"]                                                                        // 86: undoes 15, adding back what "number" holds
        x["satell"] = x["satell"] - x["string"].number                                                                   // 87: undoes 14, taking away what "string" spells
        wrong = wrong + lost(x["satel"], 547311173.0)                                                                    // check: dividing by 547311173.0 rounds a loss in its last places away
        x["satel"] = (x["satel"] / x["float"]).number                                                                    // 88: undoes 13, dividing by what "float" holds
        x["sate"] = x["sate"] + x["map"]["satellite"] + 3                                                                // 89: undoes 12, adding back what the map in the map holds
        x["sat"] = x["sat"] / 256923577521058878088611477224235621321607 + x["sat"] % 256923577521058878088611477224235621321607 * far // 90: undoes 11, 7 ^ 50 / 7 ^ 49, its remainder kept
        x["sa"] = x["sa"] / 136827793 + x["sa"] % 136827793 * far                                                        // 91: undoes 10, its remainder kept
        x["s"] = x["s"] - 547311168                                                                                      // 92: undoes 9
        wrong = wrong + lost(x[satellite.bool.true], 547311173.5)                                                        // check: the bool key's value, which nothing else ever reads, before 93 drops it
        x.remove(satellite.bool.true)                                                                                    // 93: undoes 8
        wrong = wrong + lost(x[547311173], "satellite")                                                                  // check: each entry 94-99 take out is read first, so none is dropped unread
        x.remove(547311173)                                                                                              // 94: undoes 7
        wrong = wrong + lost(x["map"], {"satellite": 547311173})                                                         // check: the map in the map, whole
        x.remove("map")                                                                                                  // 95: undoes 6
        wrong = wrong + lost(x["digits"], {5, 4, 7, 3, 1, 1, 1, 7, 3})                                                   // check: 84's join("") cannot see "5" for 5, or the digits in another order
        x.remove("digits")                                                                                               // 96: undoes 5
        wrong = wrong + lost(x["string"], "547311173")                                                                   // check: 87's .number cannot see "0547311173"
        x.remove("string")                                                                                               // 97: undoes 4
        wrong = wrong + lost(x["float"], 547311173.0)                                                                    // check: 88's division rounds a loss in its last places away
        x.remove("float")                                                                                                // 98: undoes 3
        wrong = wrong + lost(x["number"], 547311173)                                                                     // check: "number", last read by 86
        x.remove("number")                                                                                               // 99: undoes 2
        wrong = wrong + lost(x.keys, {"satell", "satelli", "sate", "satellite", "satellit", "sa", "satel", "s", "sat"})  // check: their order, before 100 sorts any order back
        x = x.sort("key")                                                                                                // 100: undoes 1, every key back in its own order
        wrong = wrong + lost(x, start)                                                                                   // check: every pass ends with the entries it began with ...
        wrong = wrong + lost(x.keys, start.keys)                                                                         // ... in the same order
        satellite.statement.if (wrong > 0)
        {
            failed = pass
            satellite.statement.break
        }
    }
    satellite.statement.if (wrong == 0)
    {
        satellite.console.display(547311173)
    }
    satellite.statement.else
    {
        satellite.console.display({"pass", failed, "wrong", wrong, x})
    }
    satellite.return(satellite)
}
