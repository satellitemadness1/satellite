// string_loss.satl -- the loss test for satellite.variable.string (satellite 004, build 0039)
//
// The author, 2026-10-06: "for the loss testing, we will use the number 547311173 so we have
// to start with that number, and end at that number, after say, 1,000,000 million
// operations... That will be the loss test" -- "it's 'satellite' spelled as numbers".
//
// The string starts as "547311173". Each pass, 50 different operations carry it away -- .hex
// .bin .number; every kind of number (547311173 1.5 50% b1010 x1F 1/3) joined behind it,
// all but 50% in front too, and a bool each way; case changes;
// accents, Greek, Cyrillic, Deseret, emoji, CJK, U+9C40 (satellite's 40000 "wide" mark);
// escapes; .replace .split/.join .reverse(); .append of itself; rotations by [ ] and .at; an
// insert; answers of .size .find .ends_with .contains .starts_with .empty == != < > written
// in; colours; whitespace; every character split apart -- to 1,411 characters. Then 50 more
// undo them in reverse order, mostly with - and .replace on the exact text, which take
// nothing away when that text is not exactly there. 100 x 10,000 = 1,000,000 operations.
//
// Traps ride along: "a" + U+F600 is the last two 16-bit units of 😀; U+2005F ends in 95, the
// code of a space (.trim); 😀 > 한 only by code, not by unit; e < E in satellite's own order.
//
// FIXED 2026-10-06, after a fresh reviewer proved losses this test could not see: if .trim
// took U+2005F off with the whitespace, the - that undoes F47 found nothing, took nothing, and
// the pass still ended right. The hole was wider: made to do nothing, 35 of the 100 operations
// still answered 547311173 -- F04 F15 F29 F30 F31 F38 F41-F44 F47-F50, and 21 of the undos. An
// operation that did nothing was undone by a - or a .replace that found nothing too; a cut at
// a .find (F21 F19 F08 F06), or a .replace or a .split that takes every copy (F20 F17), threw
// away whatever stood there, right or wrong; F15's capitals hid what F04-F14 did to the case;
// and the colour codes were cut off by position, and taken from satl itself, so never read.
// The 100 operations are unchanged. What is new is that nothing is undone without being read:
// - before F15 and after F31 the string is compared with its literal, worked out by hand from
//   547311173, and with the F31 literal again once F32 is undone (every undo from F50 to F32);
// - the middle must be 1,411 characters (an F32-F50 that did nothing);
// - .trim must find exactly the whitespace F48 put there, U+2005F must then be the string's
//   last character, and the colour codes cut off by position must be exactly the ones F45
//   and F46 put there -- and those codes must carry 0;255;0, 255;0;0 and 0;0;255;
// - each cut at a .find, and each undo that takes every copy, must find its text as the
//   string's exact end.
// A check that fails is named in `wrong`, and the pass is answered wrong. Made to do nothing,
// each of the 100 operations now makes the answer wrong.
//
// THE ANSWER IS ALWAYS 547311173. The first pass that does not end there, or fails a check,
// stops the loop, and its string is printed instead, after the names of the checks it failed.

satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.string s = "547311173"
    // the colours' own codes, taken from satl itself: the text before Q, and after it
    satellite.variable.color red_colour = xFF0000
    satellite.variable.string green = "Q".foreground(x00FF00)
    satellite.variable.string fg_open = green.substring(1, green.find("Q"))
    satellite.variable.string fg_close = green.substring(green.find("Q") + 2, green.size)
    satellite.variable.string red = "Q".foreground(red_colour)
    satellite.variable.string red_open = red.substring(1, red.find("Q"))
    satellite.variable.string blue = "Q".background(x0000FF)
    satellite.variable.string bg_open = blue.substring(1, blue.find("Q"))
    satellite.variable.string bg_close = blue.substring(blue.find("Q") + 2, blue.size)
    // the string after F14 and after F31, known in advance: worked out by hand from 547311173, never read back
    // from satl. After the last a, and the A, comes U+F600, which does not show.
    satellite.variable.string after_f14 = "547311173547311173⟨209f4e45⟩⟨100000100111110100111001000101⟩éωж😀鱀𙱀𐐨ǆ\"\\\'日本語\ta"
    satellite.variable.string after_f31 = "壹/3x壹F壹.5fαlse b壹0壹0⑦54⑦3壹壹壹⑦354⑦3壹壹壹⑦3⟨209F4E45⟩⟨壹00000壹00壹壹壹壹壹0壹00壹壹壹00壹000壹0壹⟩ÉΩЖ😀鱀𙱀𐐀Ǆ\"\\\'日本語\tA⦃54⑦3壹壹壹⑦3壹.550%b壹0壹0x壹F壹/3 true"
    // the names of the checks a pass failed; any one makes the answer wrong
    satellite.variable.string wrong = ""
    // the codes carry their colours: a colour lost in .foreground or .background would otherwise go unseen,
    // because the undo cuts the same codes, taken from satl too
    satellite.statement.if (fg_open.substring(2, fg_open.size) + fg_close.substring(2, fg_close.size) + red_open.substring(2, red_open.size) + bg_open.substring(2, bg_open.size) + bg_close.substring(2, bg_close.size) != "[38;2;0;255;0m[39m[38;2;255;0;0m[48;2;0;0;255m[49m")
    {
        wrong = wrong + " colours"
    }
    satellite.statement.for(satellite.variable.number pass = 0; pass < 10000; pass + 1)
    {
        // 50 out
        s = s + "⟨" + s.hex + "⟩"  // F01
        s = s + "⟨" + s.substring(1, 9).bin + "⟩"  // F02
        s = s.substring(1, 9).number + s  // F03
        s = s.lowercase()  // F04
        s = s + "é"  // F05
        s.append("ω")  // F06
        s = s.add("ж")  // F07
        s = s + "😀"  // F08
        s.append("鱀")  // F09
        s = s + "𙱀"  // F10
        s = s.add("𐐨")  // F11
        s = s + "ǆ\"\\\'"  // F12
        s.append("日本語\t")  // F13
        s = s + "a"  // F14 -- the text is a, then U+F600
        // CHECK: F01-F14 did exactly what they say -- F15 below puts the whole string in capitals, which would
        // hide a lowercase() that did nothing, or any of F05-F14 joined in the wrong case
        satellite.statement.if (s != after_f14)
        {
            wrong = wrong + " F01-F14"
        }
        s = s.upper()  // F15
        s = s + "⦃" + 547311173  // F16
        s = s + 1.5  // F17
        s = s + 50%  // F18
        s = s + b1010  // F19
        s = s + x1F  // F20
        s = s + 1/3  // F21
        s = s + satellite.bool.true  // F22
        s = 7 + s  // F23
        s = b1010 + s  // F24
        s = satellite.bool.false + s  // F25
        s = 1.5 + s  // F26
        s = x1F + s  // F27
        s = 1/3 + s  // F28
        s = s.replace("1", "壹")  // F29
        s = s.split("7").join("⑦")  // F30
        s = s.replace("a", "α")  // F31
        // CHECK: F15-F31 did exactly what they say -- a case change, a join or a .replace that did nothing would
        // be undone by one that does nothing too
        satellite.statement.if (s != after_f31)
        {
            wrong = wrong + " F15-F31"
        }
        s = s + s  // F32
        s = s.reverse()  // F33
        s.append(s)  // F34
        s = s.substring(2, s.size) + s[1]  // F35
        s = s.substring(s.size - 2, s.size) + s.substring(1, s.size - 3)  // F36
        s = s.substring(1, 100) + "ñ" + s.substring(101, s.size)  // F37
        s = s + "‹" + s.size + "›"  // F38
        s = s + "【" + s.find("鱀") + "】"  // F39
        s.append("😀")  // F40
        s = s + "〔" + s.ends_with("a") + s.ends_with("😀") + "〕"  // F41 -- a, then U+F600: the tail of 😀, so false
        s = s + "〖" + (s > (s.substring(1, s.find("😀")) + "한")) + "〗"  // F42
        s = s + "〘" + (s == s.resolved) + (s != s.to_string) + (s < s.upper()) + "〙"  // F43
        s = s + "⟪" + s.empty + s.contains("𙱀") + s.starts_with(s.substring(1, 5)) + "⟫"  // F44
        s = s.foreground(x00FF00)  // F45
        s = s.foreground(red_colour)  // F46
        s = s.add("𠁟")  // F47
        s = " \t\r\n" + s + "\n\r\t "  // F48
        s = s.background(x0000FF)  // F49
        s = s.split("").join("·")  // F50
        // CHECK: the middle is 1,411 characters -- an F32-F50 that did nothing would be undone by a - or a .replace
        // that finds nothing
        satellite.statement.if (s.size != 1411)
        {
            wrong = wrong + " F32-F50"
        }
        // 50 back, the last one out undone first
        s = s.replace("·", "")  // undoes F50
        s = s.replace(bg_open, "").replace(bg_close, "")  // undoes F49
        // CHECK: .trim below must find exactly the whitespace F48 put round the string
        satellite.statement.if (s.substring(1, 4) + s.substring(s.size - 3, s.size) != " \t\r\n\n\r\t ")
        {
            wrong = wrong + " F48"
        }
        s = s.trim  // undoes F48
        // CHECK: U+2005F must be the last character -- if .trim took it with the whitespace, or left some
        // whitespace behind it, the - below would find nothing, take nothing, and hide the loss
        satellite.statement.if (s[s.size] != "𠁟")
        {
            wrong = wrong + " F47"
        }
        s = s - "𠁟"  // undoes F47
        // CHECK: the codes the next two lines cut off by position are exactly the ones F45 and F46 put there
        satellite.statement.if (s.substring(1, red_open.size + fg_open.size) + s.substring(s.size - red_open.size - fg_close.size + 1, s.size) != red_open + fg_open + red_open + fg_close)
        {
            wrong = wrong + " F45-F46"
        }
        s = s.substring(red_open.size + 1, s.size - fg_close.size).replace(red_open, fg_close)  // undoes F46
        s = s.substring(fg_open.size + 1, s.size - fg_close.size)  // undoes F45
        s = s - "⟪ false true true⟫"  // undoes F44
        s = s - "〘 true false true〙"  // undoes F43
        s = s - "〖 true〗"  // undoes F42
        s = s - "〔 false true〕"  // undoes F41
        s = s.replace("】😀", "】")  // undoes F40
        s = s - "【46】"  // undoes F39
        s = s - "‹521›"  // undoes F38
        s = s - "ñ"  // undoes F37
        s = s.substring(4, s.size) + s.at(1) + s.at(2) + s.at(3)  // undoes F36
        s = s[s.size] + s.substring(1, s.size - 1)  // undoes F35
        s = s.replace(s.substring(s.size / 2 + 1, s.size) + s.substring(s.size / 2 + 1, s.size), s.substring(s.size / 2 + 1, s.size))  // undoes F34
        s = s.split("").reverse().join("")  // undoes F33
        s = s.replace(s.substring(1, s.size / 2) + s.substring(1, s.size / 2), s.substring(1, s.size / 2))  // undoes F32
        // CHECK: F50 back to F32 undone exactly -- the string is its literal again
        satellite.statement.if (s != after_f31)
        {
            wrong = wrong + " F32-F50 back"
        }
        s = s.replace("α", "a")  // undoes F31
        s = s.split("⑦").join("7")  // undoes F30
        s = s.replace("壹", "1")  // undoes F29
        s = s - "1/3"  // undoes F28
        s = s - "x1F"  // undoes F27
        s = s - "1.5"  // undoes F26
        s = s - "false "  // undoes F25
        s = s - "b1010"  // undoes F24
        s = s - "7"  // undoes F23
        s = s - " true"  // undoes F22
        // CHECK: the undo below cuts the string at "1/3", so it must stand once, as the very end
        satellite.statement.if (s.find("1/3") + 3 != s.size)
        {
            wrong = wrong + " F21"
        }
        s = s.substring(1, s.find("1/3"))  // undoes F21
        // CHECK: the undo below takes every copy of "x1F", so it must stand once, as the very end
        satellite.statement.if (s.find("x1F") + 3 != s.size)
        {
            wrong = wrong + " F20"
        }
        s = s.replace("x1F", "")  // undoes F20
        // CHECK: the undo below cuts the string at "b1010", so it must stand once, as the very end
        satellite.statement.if (s.find("b1010") + 5 != s.size)
        {
            wrong = wrong + " F19"
        }
        s = s.substring(1, s.find("b1010"))  // undoes F19
        s = s - "50%"  // undoes F18
        // CHECK: the undo below takes every copy of "1.5", so it must stand once, as the very end
        satellite.statement.if (s.find("1.5") + 3 != s.size)
        {
            wrong = wrong + " F17"
        }
        s = s.split("1.5").join("")  // undoes F17
        s = s - "⦃547311173"  // undoes F16
        s = s.lower()  // undoes F15
        s = s - "a"  // undoes F14 -- a, then U+F600
        s = s - "日本語\t"  // undoes F13
        s = s - "ǆ\"\\\'"  // undoes F12
        s = s - "𐐨"  // undoes F11
        s = s.replace("𙱀", "")  // undoes F10
        s = s - "鱀"  // undoes F09
        // CHECK: the undo below cuts the string at "😀", so it must stand once, as the very end
        satellite.statement.if (s.find("😀") + 1 != s.size)
        {
            wrong = wrong + " F08"
        }
        s = s.substring(1, s.find("😀"))  // undoes F08
        s = s - "ж"  // undoes F07
        // CHECK: the undo below cuts the string at "ω", so it must stand once, as the very end
        satellite.statement.if (s.find("ω") + 1 != s.size)
        {
            wrong = wrong + " F06"
        }
        s = s.substring(1, s.find("ω"))  // undoes F06
        s = s.replace("é", "")  // undoes F05
        s = s.uppercase()  // undoes F04
        s = s - "547311173"  // undoes F03
        s = s - "⟨100000100111110100111001000101⟩"  // undoes F02
        s = s - "⟨209F4E45⟩"  // undoes F01
        // every pass ends at 547311173 and fails no check; the first that does not stops here, keeping its string
        satellite.statement.if (wrong != "")
        {
            s = "pass " + pass + ", checks failed:" + wrong + " -- " + s
        }
        satellite.statement.if (s != "547311173")
        {
            pass = 10000
        }
    }
    satellite.statement.if (s == "547311173")
    {
        satellite.console.display(547311173)
    }
    satellite.statement.else
    {
        satellite.console.display(s)
    }
    satellite.return(satellite)
}
