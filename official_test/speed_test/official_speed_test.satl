
satellite.include(satellite)

satellite.spacesuit test_object()
{
    satellite.protected
    {
        satellite.variable.number test_number = 0
        satellite.container.list<satellite.variable.number> test_list = {0, 0, 0, 0}
        satellite.variable.string test_str = "VOID"
        satellite.container.list<satellite.variable.string> str_test_list = {"str1", "str2"}

        satellite.container.list<test_object> my_list_of_stuff

        satellite.capsule set_test_number(satellite.variable.number test_input)
        {
            test_number = test_input
        }

        satellite.capsule set_test_list_number(satellite.container.list<satellite.variable.number> test_input)
        {
            test_list = test_input
        }

        satellite.capsule add_test_list_number(satellite.variable.number test_input)
        {
            test_list.append(test_input)
        }

        satellite.capsule set_test_str(satellite.variable.string str_input_test)
        {
            test_str = str_input_test
        }

        satellite.capsule set_test_str_list(satellite.container.list<satellite.variable.string> input_str_list)
        {
            str_test_list = input_str_list
        }

        satellite.capsule add_str_to_list(satellite.variable.string str_input)
        {
            str_test_list.append(str_input)
        }
    }

    satellite.public
    {
        satellite.capsule call_set_test_number(satellite.variable.number test_input)
        {
            set_test_number(test_input)
        }

        satellite.capsule call_set_test_list_number(satellite.container.list<satellite.variable.number> test_input)
        {
            set_test_list_number(test_input)
        }

        satellite.capsule call_set_test_str(satellite.variable.string test_input)
        {
            set_test_str(test_input)
        }

        satellite.capsule call_add_test_list_number(satellite.variable.number test_input)
        {
            add_test_list_number(test_input)
        }

        satellite.capsule call_set_test_str_list(satellite.container.list<satellite.variable.string> test_input)
        {
            set_test_str_list(test_input)
        }

        satellite.capsule call_add_str_to_list(satellite.variable.string test_input)
        {
            add_str_to_list(test_input)
        }
    }
}

satellite.capsule satellite.main()
{
    satellite.console.display("SATELLITE SPEED TEST\n\nVERSION: 001.01\n\n")

    satellite.variable.number op_counter = 0
    satellite.variable.number statement1_counter = 0
    satellite.variable.number statement2_counter = 0
    satellite.variable.number statement3_counter = 0
    satellite.variable.number statement4_counter = 0
    satellite.variable.number statement5_counter = 0
    satellite.variable.number statement6_counter = 0

    satellite.statement.while(statement1_counter < 1000)
    {
        test_object local_test_object

        local_test_object.call_set_test_number(1000000000000 + 1000000000000)

        statement1_counter = statement1_counter + 1
    }

    test_object local_test_object

    satellite.statement.while(statement2_counter < 1000)
    {
        local_test_object.call_set_test_list_number({547311173, 547311173, 547311173, 547311173, 547311173})

        statement2_counter = statement2_counter + 1
    }

    satellite.statement.while(statement3_counter < 1000)
    {
        local_test_object.call_add_test_list_number(547311173)

        statement3_counter = statement3_counter + 1
    }

    satellite.statement.while(statement4_counter < 1000)
    {
        local_test_object.call_set_test_str("547311173")

        statement4_counter = statement4_counter + 1
    }

    satellite.statement.while(statement5_counter < 1000)
    {
        local_test_object.call_set_test_str_list({"547311173", "547311173", "547311173", "547311173", "547311173", "547311173"})

        statement5_counter = statement5_counter + 1
    }

    satellite.statement.while(statement6_counter < 1000)
    {
        local_test_object.call_add_str_to_list("547311173")

        statement6_counter = statement6_counter + 1
    }

    satellite.return(satellite)
}