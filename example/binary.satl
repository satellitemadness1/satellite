satellite.include(satellite)

// satellite.variable.binary -- M19.5, and DESIGN §8.5's type.
//
// THE WIDTH IS PART OF THE VALUE. That is the whole reason a run of bits is a
// type of its own rather than a number written in another base, and it is what
// every line below is really about: b0010 and b10 are two different values.
//
// EVERY METHOD HERE IS CALLED ON A NAME, AND THAT IS THE LANGUAGE RATHER THAN
// A STYLE. A selector folds only through a DECLARED name -- WORD_NUMBERS §1.5's
// one hop -- so `run.width().to_string()` does not compile and the two steps
// are written out. A conversion verb is the shape people chain, so this type
// meets the rule more often than most; PLAN §8's M19.5 entry says so in advance.

satellite.capsule show(satellite.variable.binary run)
{
    satellite.variable.string written = run.to_string()
    satellite.variable.number how_wide = run.width()
    satellite.variable.number worth = run.to_number()
    satellite.variable.string wide_text = how_wide.to_string()
    satellite.variable.string worth_text = worth.to_string()
    satellite.console.display("  " + written + "   width " + wide_text + "   worth " + worth_text)
    satellite.return(satellite)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.console.display("a run of bits, and what it is worth:")

    satellite.variable.binary four = b1010
    show(four)

    // The same VALUE, written wider. Everything about it differs except what
    // it is worth -- which is exactly what "the width is part of the value"
    // has to mean if it means anything.
    satellite.variable.binary eight = b00001010
    show(eight)

    satellite.console.display("")
    satellite.console.display("so they are not the same value:")
    // Displayed rather than joined, because a `satellite.variable.bool` has no
    // `to_string` to join WITH -- that is a gap one type over and not this
    // milestone's to fill.
    satellite.console.display("  b1010 == b00001010 is")
    satellite.variable.bool alike = four == eight
    satellite.console.display(alike)

    // to_number is what the bits are WORTH; as_number is the digits read as an
    // ordinary decimal. One word apart, and a thousand apart.
    satellite.console.display("")
    satellite.console.display("two ways to read the same run:")
    satellite.variable.number worth = four.to_number()
    satellite.variable.number written_as = four.as_number()
    satellite.variable.string worth_text = worth.to_string()
    satellite.variable.string written_text = written_as.to_string()
    satellite.console.display("  b1010.to_number()    " + worth_text)
    satellite.console.display("  b1010.as_number()    " + written_text)

    // Writing bits to a file puts the BYTES and not the text. Sixteen bits is
    // two of them, and a width that is not a multiple of eight is refused
    // rather than padded -- half a byte has no representation in a file.
    satellite.console.display("")
    satellite.console.display("written to a file, bits become bytes:")
    satellite.variable.binary letters = b0100000101000010
    satellite.variable.file f = satellite.file.new("binary_example.bin")
    f.write(letters)
    f.close()

    satellite.variable.file back = satellite.file.open("binary_example.bin", "read")
    satellite.variable.string came_back = back.read_all()
    satellite.variable.string letters_text = letters.to_string()
    satellite.console.display("  " + letters_text + " -> " + came_back)
    back.close()
    satellite.system.delete("binary_example.bin")

    satellite.return(satellite)
}
