// full_test_helper.satl — the companion spaceship for full_test.satl.
//
// A **spaceship** is satellite's word for a file of includable code (§16).
// This one exists so that full_test.satl has something to include: a program
// that spans two files is a feature, and it is the one feature a single file
// cannot demonstrate about itself.
//
// Nothing in here is special. It is ordinary top-level satellite — one capsule
// and one spacesuit — and `satellite.include(full_test_helper)` merges both
// declarations into the including program before anything runs. There is no
// export list and no header: what a spaceship declares is what it offers.
//
// It has no satellite.main, which is exactly right. A spaceship is code to be
// included, not a program to be run, and the loader merges declarations rather
// than running the file it took them from.

// Reached from full_test.satl by bare name, as though it had been written
// there. The path is resolved relative to the file that included it, not to
// the directory the interpreter was started in (§16), which is why
// `./satl --run example/full_test.satl` finds this from anywhere.
satellite.capsule triple(satellite.variable.number n)
    satellite.returns(satellite.variable.number)
{
    satellite.return(n * 3)
}

// A spacesuit crosses the include boundary the same way a capsule does: the
// including program constructs one, calls its methods, and cannot see the
// protected field, all without knowing which file it came from.
satellite.spacesuit tally()
{
    satellite.protected { satellite.variable.number n }

    satellite.public {
        tally() { n = 0 }
        satellite.capsule bump() { n = n + 1 }
        satellite.capsule value() satellite.returns(satellite.variable.number)
        {
            satellite.return(n)
        }
    }
}
