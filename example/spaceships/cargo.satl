satellite.include(satellite)

// A SPACESHIP -- another file, included by example/spaceships/launch.satl.
//
// EVERYTHING HERE IS REACHED THROUGH THE NAME `cargo`. The file that includes
// this one calls `cargo.weigh(3)`, declares a `cargo.crate`, and reads
// `satellite.library.cargo.loads`; nothing below is dragged into its namespace,
// and the names are numbered under `satellite.library.cargo` with a counter of
// this file's own.
//
// INSIDE THIS FILE THE NAMES ARE BARE. `satellite.library.loads` is this file's
// global, and `weigh` is this file's capsule.

satellite.library.loads = 0

satellite.spacesuit crate()
{
    satellite.protected
    {
        satellite.variable.string label = "empty"
    }

    satellite.public
    {
        satellite.capsule fill(satellite.variable.string with)
        {
            label = with
        }

        satellite.capsule describe() satellite.returns(satellite.variable.string)
        {
            satellite.return("a crate of " + label)
        }
    }
}

satellite.capsule weigh(satellite.variable.number crates)
{
    satellite.return(crates * 40)
}

// A LAUNCH RUNS WHEN THIS FILE IS INCLUDED. The arguments an include hands over
// go to every launch whose parameters fit them, in the order written here:
// `satellite.include(cargo)` runs `arrive`, `cargo("fuel")` runs `load`, and
// `cargo("fuel", 2)` runs `load_many`.
satellite.capsule.launch arrive()
{
    satellite.console.display("cargo: docked with nothing to load")
}

satellite.capsule.launch load(satellite.variable.string what)
{
    satellite.library.loads = satellite.library.loads + 1
    satellite.console.display("cargo: loading " + what)
}

satellite.capsule.launch load_many(satellite.variable.string what, satellite.variable.number count)
{
    satellite.library.loads = satellite.library.loads + count
    satellite.variable.string shown = count.to_string()
    satellite.console.display("cargo: loading " + shown + " of " + what)
}

// THIS FILE'S OWN MAIN RUNS ONLY WHEN satl IS GIVEN THIS FILE. Included, the
// file is not the program, and `satellite.main` is left alone.
satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.console.display("cargo.satl run on its own")
    satellite.return(satellite)
}
