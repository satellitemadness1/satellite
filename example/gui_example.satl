
satellite.include(satellite)
// will there be a satellite.include(window) here ?

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.window my_terminal = satellite.console.new("my window title", 800x600)

    my_terminal.open() // window appears
    my_terminal.close() // window closes

    satellite.return(satellite)
}