// M16 -- containers and the search power.
//
// The acceptance program: every family this milestone built, in the order
// PLAN.md §8's entry names them. A list and its methods, a map and its
// methods, the sort primitive, the subscripts, and the search power over the
// ten-level ladder with its dial.

satellite.include(satellite)

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    // A DECLARATION HOLDS NOTHING, of a container exactly as of every other
    // type -- DESIGN §8.7 -- so the bare call shape is what constructs one.
    satellite.container.list<satellite.variable.number> l = satellite.container.list()
    l.append(3)
    l.append(1)
    l.append(2)
    satellite.console.display(l)

    // The sort primitive. `sort("down")` folds to sort_down() at resolve and
    // `sort("up")` folds onto the bare sort() -- WORD_NUMBERS §1.5.
    l.sort()
    satellite.console.display(l)
    l.sort("down")
    satellite.console.display(l)
    l.sort("up")
    satellite.console.display(l)

    satellite.console.display(l.size())
    satellite.console.display(l.sum())
    satellite.console.display(l.max())
    satellite.console.display(l.join(", "))

    // Subscripts: a whole number is a position, and a negative one counts
    // from the end. A slice clamps where an index refuses.
    satellite.console.display(l[0])
    satellite.console.display(l[-1])
    satellite.console.display(l[0:2])
    l[0] = 9
    satellite.console.display(l)

    // A map, in insertion order, which is what makes .keys a walk a program
    // can rely on.
    satellite.container.map<satellite.variable.string, satellite.variable.number> m = satellite.container.map()
    m.set("bolt", 7)
    m.set("nut", 9)
    m["washer"] = 4
    satellite.console.display(m)
    satellite.console.display(m.keys())
    satellite.console.display(m.values())
    satellite.console.display(m["bolt"])
    satellite.console.display(m.has("rivet"))

    // The search power. The dial says how loose a match may be; at 1 it is an
    // exact match, and 6 reaches a substring either way.
    satellite.container.list<satellite.variable.string> parts = satellite.container.list()
    parts.append("bolt")
    parts.append("nut")
    parts.append("washer")

    satellite.system.threshold(6)
    satellite.console.display(satellite.system.threshold())

    // The short spelling: the values that matched.
    satellite.container.list<satellite.variable.string> found = parts["olt"]
    satellite.console.display(found)

    // The rich spelling: a map per hit, with the value, the key, the path and
    // the score. `1 4 2 26`, minted for this milestone.
    satellite.container.list<satellite.container.map> hits = parts.search("was")
    satellite.console.display(hits)

    // And a string splits into a list, which is the row that had refused
    // since M11 naming this milestone.
    satellite.variable.string line = "a,b,c"
    satellite.console.display(line.split(","))

    satellite.return(satellite)
}
