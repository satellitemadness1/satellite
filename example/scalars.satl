// M11 -- scalars and control flow, running. Every statement form, both module
// constants, and a method from each family; `satl example/scalars.satl` prints
// fourteen lines and exits 0, and MILESTONES/M11.md §5 is the transcript.
//
// EVERY RECEIVER HERE IS A DECLARED NAME, and that is the milestone's boundary
// rather than a style: a selector folds through the declared type -- names.cpp
// keeps WORD_NUMBERS section 1.5's one hop -- so a method on a literal or on a
// call's answer says so and asks for a name in between.

satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.string greeting = "Hello"
    greeting.append(", World!")
    satellite.console.display(greeting)
    satellite.console.display(greeting.upper())
    satellite.console.display(greeting.size())

    satellite.variable.bool loud = satellite.bool.true
    satellite.statement.if (loud)
    {
        satellite.console.display("loud is true")
    }
    satellite.statement.else
    {
        satellite.console.display("loud is false")
    }

    satellite.variable.number total = 0
    satellite.statement.for (satellite.variable.number i = 0; i < 5; i = i + 1)
    {
        total = total + i
    }
    satellite.console.display(total)

    satellite.variable.number countdown = 3
    satellite.statement.while (countdown > 0)
    {
        satellite.variable.string line = countdown.to_string()
        line.append("...")
        satellite.console.display(line)
        countdown = countdown - 1
    }

    satellite.variable.string sample = "  satellite  "
    satellite.variable.string trimmed = sample.trim()
    satellite.console.display(trimmed)
    satellite.console.display(trimmed.substring(0, 3))
    satellite.console.display(trimmed.contains("tell"))
    satellite.console.display(trimmed.find("tell"))

    satellite.variable.number negative = 0 - 7
    satellite.console.display(negative.abs())

    satellite.variable.number one = 1
    satellite.console.display(one.shift_left(10))

    satellite.return(satellite)
}
