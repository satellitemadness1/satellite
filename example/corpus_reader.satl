// M19 -- QUAD's corpus reader, written in satellite.
//
// THE SECOND OF THE MILESTONE'S TWO DONE-WHEN PROGRAMS. PLAN.md §8's M19 entry
// names it exactly: `quad_main.cpp:184-197`, "written in satellite by hand
// against DESIGN.md -- `read_line` until nothing, skip empty lines, a line
// starting `"# "` opens a document, count lines and documents, print the two
// counts, and they must match the C++ QUAD's on the same file."
//
// WHAT THE C++ DOES, IN FULL, so the transcription can be checked by eye:
//
//     while (std::getline(in, ln)) {
//         if (ln.empty()) continue;
//         if (ln.rfind("# ", 0) == 0) {          // "# title" opens a document
//             mind.beginDocument(ln.substr(2));
//             continue;
//         }
//         mind.perceive(ln);
//         ...
//         ++n;
//     }
//
// So a document title is NOT a line, an empty line is NOT a line, and `n`
// counts what is left. Every one of those three is a branch below.
//
// IT NEEDS NO FLOAT AND NO SORT, which is why it is M19's and not M21's.
// PLAN.md is explicit that this is not the milestone QUAD.md §4 asks for --
// §4 wants one mechanism out of `mind.hpp`, exercising floats, containers,
// sorting and persistence at once, and that is M21, `Sky::decay` plus
// `Rack::draw`. Claiming it here would orphan the one thing three documents
// agree on.
//
// THE PATH IS WRITTEN IN because `satellite.library.main.arguments` is M20's.
// When that lands this reads its file from the command line and the two counts
// stop being about one fixture.

satellite.include(satellite)

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.string corpus = "example/corpus.txt"

    satellite.variable.file in = satellite.file.open(corpus, "read")
    satellite.statement.if (in.ok() == satellite.bool.false)
    {
        // DESIGN §9's ordinary case: say which file and why, and stop having
        // said something a person can act on.
        satellite.console.display("cannot read " + in.path() + ": " + in.error())
        satellite.return(satellite)
    }

    satellite.variable.number documents = 0
    satellite.variable.number lines = 0

    // A VARIANT, BECAUSE THE END OF THE FILE IS `nothing` AND NOT AN EMPTY
    // STRING -- DESIGN §8.7, which names this exact loop as what M19 inherits.
    // An empty line and the end of the file are two different answers here, and
    // the whole of the reader's first branch depends on telling them apart.
    satellite.variable.variant line = in.read_line()
    satellite.statement.while (line.holding() != "nothing")
    {
        satellite.variable.string text = line.held()

        satellite.statement.if (text.size() == 0)
        {
            // skip
        }
        satellite.statement.else
        {
            // §2.2 has no one-argument `substring`, so the call is written with
            // both -- PLAN.md M19 says so, and the title is what follows "# ".
            satellite.statement.if (text.starts_with("# "))
            {
                satellite.variable.string title = text.substring(2, text.size())
                documents = documents + 1
            }
            satellite.statement.else
            {
                lines = lines + 1
            }
        }

        line = in.read_line()
    }

    satellite.console.display(in.close())
    satellite.console.display("documents " + documents.to_string())
    satellite.console.display("lines " + lines.to_string())
    satellite.return(satellite)
}
