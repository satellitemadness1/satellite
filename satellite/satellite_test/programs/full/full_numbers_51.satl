satellite.include(satellite)

// full_numbers_51 -- satellite.test.full(), a program satl must REFUSE.
// random: a count of digits below 0 is refused (S431).
// It exits 72, and its report on stderr holds: satellite.random.fast(digits) -- a count of digits is 0 or more
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.console.display(satellite.random.fast(-1))
    satellite.return(satellite)
}
