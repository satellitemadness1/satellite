satellite.include(satellite)

// full_numbers_24 -- satellite.test.full(), a program satl must REFUSE.
// binary: a sum stored back in a binary name holds a number.
// It exits 27, and its report on stderr holds: satellite.variable.binary, and it holds a number
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.variable.binary flags = b0010
    flags = flags + b0001
    satellite.return(satellite)
}
