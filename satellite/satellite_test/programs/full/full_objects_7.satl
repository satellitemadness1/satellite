satellite.include(satellite)

// full_objects_7 -- REFUSED before anything runs: a satellite.protected capsule called from outside
// its spacesuit (S230: "satl refuses these before anything runs: a field or a protected capsule
// reached from outside").

satellite.spacesuit box()
{
    satellite.protected
    {
        satellite.variable.number value = 0

        satellite.capsule secret()
        {
            satellite.return(value)
        }
    }

    satellite.public
    {
        satellite.capsule call_take()
        {
            satellite.return(value)
        }
    }
}

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    box b
    satellite.console.display(b.secret())
    satellite.return(satellite)
}
