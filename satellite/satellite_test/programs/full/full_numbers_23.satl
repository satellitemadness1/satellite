satellite.include(satellite)

// full_numbers_23 -- satellite.test.full(), a program satl must REFUSE.
// binary: b12 is not binary.
// It exits 27, and its report on stderr holds: ERROR: b12 is not binary
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.variable.binary flags = b12
    satellite.return(satellite)
}
