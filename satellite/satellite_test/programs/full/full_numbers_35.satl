satellite.include(satellite)

// full_numbers_35 -- satellite.test.full(), a program satl must REFUSE.
// percentage: the % is required, a percentage name given 50.
// It exits 27, and its report on stderr holds: ERROR: expected 50%
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.variable.percent p = 50
    satellite.return(satellite)
}
