satellite.include(satellite)

// full_objects_8 -- REFUSED when its line runs: two objects put in order. satellite.help(satellite.spacesuit):
// "An object has no order, so < > <= >= stop the program (S301)."

satellite.spacesuit box()
{
    satellite.protected
    {
        satellite.variable.number value = 0

        satellite.capsule secret()
        {
            satellite.return(value)
        }
    }

    satellite.public
    {
        satellite.capsule call_take()
        {
            satellite.return(value)
        }
    }
}

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    box a
    box b
    satellite.console.display(a < b)
    satellite.return(satellite)
}
