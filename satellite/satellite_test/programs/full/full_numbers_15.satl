satellite.include(satellite)

// full_numbers_15 -- satellite.test.full(), a program satl must REFUSE.
// float: 1.0 / 0 is a division by zero (S401).
// It exits 22, and its report on stderr holds: the / of 1.0 and 0 is a division by zero
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.console.display(1.0 / 0)
    satellite.return(satellite)
}
