satellite.include(satellite)

// full_numbers_46 -- satellite.test.full(), a program satl must REFUSE.
// random: a bare satellite.random.ultra() draws nothing (S430).
// It exits 71, and its report on stderr holds: satellite.random.ultra() draws nothing
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.console.display(satellite.random.ultra())
    satellite.return(satellite)
}
