satellite.include(satellite)

// full_numbers_17 -- satellite.test.full(), a program satl must REFUSE.
// float: ^ takes a whole-number power only, 2.0 ^ 0.5 (S210).
// It exits 14, and its report on stderr holds: is a power that is not a whole number
// Nothing is printed on stdout.

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 1
    satellite.console.display(2.0 ^ 0.5)
    satellite.return(satellite)
}
