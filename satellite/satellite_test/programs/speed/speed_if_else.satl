satellite.include(satellite)

// speed_if_else.satl -- satellite.test.speed(): IF, ELSE IF AND ELSE, four ways down.
// x walks the Park-Miller sequence, x = x * 48271 % 2147483647, and each pass goes down one of four
// branches by x % 4, so which branch runs changes from pass to pass.
// Prints: how many passes went down each of the four branches.  C++ twin: speed_if_else().

satellite.capsule satellite.main()
{
    satellite.variable.number passes = 750000
    satellite.variable.number x = 547311173
    satellite.variable.number a = 0
    satellite.variable.number b = 0
    satellite.variable.number c = 0
    satellite.variable.number d = 0
    satellite.statement.for(satellite.variable.number i = 0; i < passes; i + 1)
    {
        x = x * 48271 % 2147483647
        satellite.statement.if (x % 4 == 0)
        {
            a = a + 1
        }
        satellite.statement.else satellite.statement.if (x % 4 == 1)
        {
            b = b + 1
        }
        satellite.statement.else satellite.statement.if (x % 4 == 2)
        {
            c = c + 1
        }
        satellite.statement.else
        {
            d = d + 1
        }
    }
    satellite.console.display(a.string + " " + b.string + " " + c.string + " " + d.string)
    satellite.return(satellite)
}
