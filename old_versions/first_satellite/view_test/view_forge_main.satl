    satellite.console.display("BUILDING THE FORGE ITSELF...")
    satellite.console.display("WHY: THE OBJECTS ARE ONLY STORAGE, AND ONLY A view_forge CAN TURN ONE OF THEM INTO A VIEW ON THE CONSOLE")
    
    view_forge local_view_forge
    
    satellite.console.display("HANDING THE FORGE ITS TARGET, THE DATA \"" + local_user_input + "\" TYPED IN AT THE PROMPT ABOVE")
    
    local_view_forge.call_set_forge_target(local_user_input)
    
    satellite.console.display("SEARCHING THE LIBRARY \"object_list\" FOR AN OBJECT WHOSE NAME MATCHES THE TARGET \"" + local_user_input + "\"")
    satellite.console.display("WHY: THE FORGE RECEIVES A WHOLE forge_object, NOT A NAME, SO satellite.main HAS TO FIND THE OBJECT BEFORE THE FORGE CAN FORGE IT")
    satellite.console.display("MATCHING IS EXACT, CHARACTER FOR CHARACTER, AGAINST THE VARIABLE \"name_str\" OF EVERY OBJECT")
    
    satellite.variable.number search_index = 0
    satellite.variable.number target_index = 0
    satellite.variable.bool target_found = FALSE
    
    satellite.console.display("ENTERING satellite.statement.while(search_index < object_list.length())")
    satellite.console.display("THE LOOP WILL KEEP RUNNING UNTIL \"search_index\" REACHES " + object_list.length())
    
    satellite.statement.while(search_index < object_list.length())
    {
        satellite.variable.string search_name = object_list[search_index].call_get_name_str()
        
        satellite.console.display("SEARCH PASS " + search_index + ": COMPARING THE NAME \"" + search_name + "\" AGAINST THE TARGET \"" + local_user_input + "\"")
        
        satellite.statement.if(search_name == local_user_input)
        {
            satellite.console.display("MATCH! THE OBJECT AT \"object_list[" + search_index + "]\" IS THE TARGET")
            
            target_found = TRUE
            target_index = search_index
            
            satellite.console.display("VARIABLE \"target_found\" NOW SET TO DATA=TRUE")
            satellite.console.display("VARIABLE \"target_index\" NOW SET TO DATA=" + target_index)
        }
        satellite.statement.else()
        {
            satellite.console.display("NO MATCH, MOVING ON")
        }
        
        search_index = search_index + 1
    }
    
    satellite.console.display("EXITED satellite.statement.while(search_index < object_list.length())")
    satellite.console.display("SEARCHED " + search_index + " OBJECTS")
    
    satellite.statement.if(target_found == TRUE)
    {
        satellite.console.display("THE TARGET \"" + local_user_input + "\" WAS LOCATED AT \"object_list[" + target_index + "]\"")
        
        satellite.console.display("SENDING THE forge_object AT \"object_list[" + target_index + "]\" INTO THE FORGE...")
        
        local_view_forge.call_forge_object(object_list[target_index])
        
        satellite.console.display("THE FORGE HAS RETURNED, THE TARGET HAS BEEN FULLY FORGED AND DISPLAYED")
    }
    satellite.statement.else()
    {
        satellite.console.display("THE TARGET \"" + local_user_input + "\" DOES NOT MATCH ANY OF THE " + object_list.length() + " OBJECTS LOADED")
        satellite.console.display("NOTHING CAN BE FORGED, BECAUSE THE FORGE CAN ONLY RECEIVE AN OBJECT THAT EXISTS")
        satellite.console.display("TIP: OBJECT NAMES ARE WRITTEN IN FULL UPPERCASE, FOR EXAMPLE \"CHINA\" OR \"CHINESE\"")
    }
    
    satellite.console.display("\nSATELLITE VIEW FORGE COMPLETE")
        satellite.return(satellite)
}
