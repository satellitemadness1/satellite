satellite.include(satellite)

// Found by T1's review: A joins B while B joins A. Each waits for a thread
// that waits for it. T1: whichever join closes the circle is refused with
// S1407, the other join returns with that error, and the program ends.

satellite.library.a = satellite.thread.new(wait_for_b())
satellite.library.b = satellite.thread.new(wait_for_a())

satellite.capsule wait_for_b() satellite.returns(satellite.variable.number)
{
    satellite.time.sleep(0.05)
    satellite.variable.thread other = satellite.library.b
    satellite.variable.number got = other.join()
    satellite.return(got)
}

satellite.capsule wait_for_a() satellite.returns(satellite.variable.number)
{
    satellite.time.sleep(0.05)
    satellite.variable.thread other = satellite.library.a
    satellite.variable.number got = other.join()
    satellite.return(got)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.thread a = satellite.library.a
    satellite.variable.thread b = satellite.library.b
    a.start()
    b.start()
    a.join()
    satellite.return(satellite)
}
