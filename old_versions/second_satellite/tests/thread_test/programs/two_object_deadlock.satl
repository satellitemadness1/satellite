satellite.include(satellite)

// THREAD.md T2: thread A is inside x.poke(y) and calls y.touch(), while thread
// B is inside y.poke(x) and calls x.touch(). Each holds one object on its
// access list and waits for the other's. T2: never a hang -- S1408 in the
// thread that would close the circle, every time.

satellite.spacesuit node()
{
    satellite.protected
    {
        satellite.variable.number touched = 0
    }
    satellite.public
    {
        satellite.capsule touch()
        {
            touched = touched + 1
        }
        satellite.capsule poke(node other)
        {
            satellite.time.sleep(0.05)
            other.touch()
        }
    }
}

satellite.capsule go(node from, node to) satellite.returns(satellite.variable.number)
{
    from.poke(to)
    satellite.return(1)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    node x
    node y
    satellite.variable.thread a = satellite.thread.new(go(x, y))
    satellite.variable.thread b = satellite.thread.new(go(y, x))
    a.start()
    b.start()
    a.join()
    b.join()
    satellite.console.display("no deadlock")
    satellite.return(satellite)
}
