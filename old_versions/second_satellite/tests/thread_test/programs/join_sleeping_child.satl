satellite.include(satellite)

// Found by T1's review: close_all() woke threads one at a time, in launch
// order. `parent` joins `child`, which is asleep; the parent cannot end until
// the child does, and the child was never woken because the parent came first.
// T1: the program ends promptly, exit 0.

satellite.capsule child() satellite.returns(satellite.variable.number)
{
    satellite.time.sleep(3600)
    satellite.return(1)
}

satellite.capsule parent() satellite.returns(satellite.variable.number)
{
    satellite.variable.thread c = satellite.thread.new(child())
    c.start()
    satellite.variable.number got = c.join()
    satellite.return(got)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.thread p = satellite.thread.new(parent())
    p.start()
    satellite.time.sleep(0.1)
    satellite.console.display("closing")
    satellite.return(satellite)
}
