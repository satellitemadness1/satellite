satellite.include(satellite)

// THREAD.md D14, run as `satl --call call_thread_error.satl later`: the thread
// divides by zero and nobody joins it. --call used to drop that error and exit
// 0. T1: S0705 on stderr and a failing status.

satellite.capsule boom() satellite.returns(satellite.variable.number)
{
    satellite.variable.number zero = 0
    satellite.return(1 / zero)
}

satellite.capsule later() satellite.returns(satellite.variable.number)
{
    satellite.variable.thread t = satellite.thread.new(boom())
    t.start()
    satellite.time.sleep(0.05)
    satellite.return(1)
}
