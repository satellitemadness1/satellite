satellite.include(satellite)

// THREAD.md D15: a thread reading a .gz file when the program ends. The wake
// signal (SIGUSR2, no SA_RESTART) could make zlib's read(2) fail with EINTR,
// which zlib calls a stream error, and close_all() would report it. Needs
// thread_gzip_test.txt.gz in the current directory -- many lines, any text.
// T1: exit 0 and nothing on stderr, every time.

satellite.capsule reader() satellite.returns(satellite.variable.number)
{
    satellite.variable.number n = 0
    satellite.statement.while (n >= 0)
    {
        satellite.variable.file f = satellite.file.open("thread_gzip_test.txt.gz", "read")
        satellite.variable.variant line = f.read_line()
        satellite.statement.while (line.holding() != "nothing")
        {
            n = n + 1
            line = f.read_line()
        }
        f.close()
    }
    satellite.return(n)
}

satellite.capsule satellite.main(satellite.container.list<satellite.variable.string> arguments)
{
    satellite.variable.thread a = satellite.thread.new(reader())
    satellite.variable.thread b = satellite.thread.new(reader())
    a.start()
    b.start()
    satellite.time.sleep(0.05)
    satellite.console.display("closing")
    satellite.return(satellite)
}
