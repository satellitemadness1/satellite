-- THE STREAM  (0000000100000000 up)
0000000100000000  line_end_token               the end of a statement
0000000100000001  end_of_file_token            always the last token
0000000100000010  error_token                  [COUNTED] the character the lexer had no code for. The lexer never throws
0000000100000011  free                         to 0000000111111111, free for this family

-- BRACKETS  (0000001000000000 up)
0000001000000000  left_brace_token             {  opens a body
0000001000000001  right_brace_token            }  closes a body
0000001000000010  left_parenthesis_token       (  opens arguments
0000001000000011  right_parenthesis_token      )  closes arguments
0000001000000100  left_square_bracket_token    [  opens an index
0000001000000101  right_square_bracket_token   ]  closes an index
0000001000000110  free                         to 0000001011111111, free for this family

-- ARITHMETIC  (0000001100000000 up)
-- EVERY ARITHMETIC TOKEN NEEDS WHITESPACE ON BOTH SIDES (the author, 2026-09-16):
-- "Literally every math operation, ANY math operation has to have spacebar(sign)spacebar".
-- This was already the rule for / alone; it is now the rule for all six, which is
-- what frees the TOUCHING spelling of each to mean something else. A touching /
-- between two numbers is a FRACTION (the author, same day): "when you encounter
-- number/number with NO space -- that becomes a fraction". So the tight rows below
-- are not errors-in-waiting, they are the reserved half of each operator.
0000001100000000  plus_token                   +  with whitespace on BOTH sides
0000001100000001  minus_token                  -  with whitespace on BOTH sides
0000001100000010  times_token                  *  with whitespace on BOTH sides
0000001100000011  divide_token                 /  with whitespace on BOTH sides; a touching / is a path or a fraction
0000001100000100  modulus_token                %  with whitespace on BOTH sides
0000001100000101  power_token                  ^  with whitespace on BOTH sides. The author ruled ^ is power, 2026-09-16; ** spaced is its second spelling (SATELLITE_INFINITY.md, INF-1)
0000001100000110  tight_plus_token             +  touching: not an operation. Reserved
0000001100000111  tight_minus_token            -  touching: the UNARY minus, which is how -5 is written
0000001100001000  tight_times_token            *  touching: not an operation. Reserved
0000001100001001  fraction_token               /  touching, between two numbers: 5/4 is a fraction (not built yet)
0000001100001010  tight_modulus_token          %  touching: not an operation. Reserved -- except straight after a number's digits, where 50% is percentage_token
0000001100001011  tight_power_token            ^  touching: not an operation. Reserved
0000001100001100  free                         to 0000001111111111, free for this family

-- ASSIGNMENT  (0000010000000000 up)
0000010000000000  assign_token                 =
0000010000000001  plus_assign_token            +=   QUESTION: 003 DESIGN §6 has one assignment form and no compound
0000010000000010  minus_assign_token           -=   QUESTION: as above
0000010000000011  times_assign_token           *=   QUESTION: as above
0000010000000100  divide_assign_token          /=   QUESTION: as above
0000010000000101  modulus_assign_token         %=   QUESTION: as above
0000010000000110  free                         to 0000010011111111, free for this family

-- COMPARISON  (0000010100000000 up)
0000010100000000  equals_token                 ==
0000010100000001  not_equals_token             !=
0000010100000010  less_than_token              <
0000010100000011  greater_than_token           >
0000010100000100  less_or_equal_token          <=
0000010100000101  greater_or_equal_token       >=
0000010100000110  free                         to 0000010111111111, free for this family

-- LOGIC AND BITS  (0000011000000000 up)
0000011000000000  and_token                    &&   QUESTION: 003 DESIGN §13 leaves && and || open, and may spell them as words
0000011000000001  or_token                     ||   QUESTION: as above
0000011000000010  not_token                    !    QUESTION: §13 leaves open whether ! is the negation
0000011000000011  bit_and_token                &    QUESTION: §6 has no bitwise row; & ends an expression and is reported
0000011000000100  bit_or_token                 |    QUESTION: as above
0000011000000101  bit_exclusive_or_token       ^    ANSWERED 2026-09-16: ^ is POWER (see the arithmetic family). No spelling reaches this code; kept because a code is never reused
0000011000000110  bit_not_token                ~    QUESTION: as above
0000011000000111  shift_left_token             <<   QUESTION: 003 DESIGN §5.5 refuses << and >> permanently (the author asked for them 2026-09-16)
0000011000001000  shift_right_token            >>   QUESTION: as above
0000011000001001  bit_run_join_token           !!   lays two bit runs end to end; DESIGN §6.6's fifth precedence level, decided 2026-09-09
0000011000001010  free                         to 0000011011111111, free for this family

-- SEPARATORS AND REACH  (0000011100000000 up)
0000011100000000  comma_token                  ,  between arguments
0000011100000001  semicolon_token              ;  inside a for
0000011100000010  colon_token                  :  in for (TYPE name : list), and in a slice
0000011100000011  namespace_token              :: QUESTION: satellite joins every segment with a dot; no program uses ::
0000011100000100  method_token                 .  reaches a member; a following ( makes it a call
0000011100000101  decimal_point_token          .  QUESTION: 003's lexer folds 3.14 into one number, dot included
0000011100000110  word_separator_token         .  between a word's numbers: #1.5.1
0000011100000111  path_separator_token         /  QUESTION: a path with a slash is written in quotes, so it travels as characters
0000011100001000  linux_home_token             ~  QUESTION: 003 spells $HOME as a live CHARACTER code, not a token
0000011100001001  question_token               ?  QUESTION: no grammar production accepts it
0000011100001010  arrow_token                  -> QUESTION: a return type is satellite.returns(TYPE)
0000011100001011  free                         to 0000011111111111, free for this family

-- TEXT AND COMMENTS  (0000100000000000 up)
0000100000000000  double_quote_token           "  a string literal starts or ends
0000100000000001  single_quote_token           '  QUESTION: the language has no character type
0000100000000010  escape_token                 \  QUESTION: an escape lives inside a string's value, which a token may not
0000100000000011  comment_token                // to the end of the line -- a MARKER only: the text is not stored (003 DESIGN 5.6)
0000100000000100  comment_start_token          /* QUESTION: 003 DESIGN §5.6 has no block comment, on purpose
0000100000000101  comment_end_token            */ QUESTION: as above
0000100000000110  free                         to 0000100011111111, free for this family

-- LITERALS AND PAYLOADS -- [COUNTED] means a count follows, then that many codes  (0000100100000000 up)
0000100100000000  word_number_token            [COUNTED] a satellite word as its numbers: count, then the numbers
0000100100000001  name_token                   [COUNTED] a name the user owns: count, then that many character codes
0000100100000010  number_token                 [COUNTED] a number literal: count, then that many character codes
0000100100000011  string_token                 [COUNTED] a string literal: count, then that many character codes
0000100100000100  binary_token                 [COUNTED] b11001100 -- count, then that many character codes
0000100100000101  hexadecimal_token            [COUNTED] xFFAAC2985765 -- count, then that many character codes
0000100100000110  option_token                 [COUNTED] 0#down -- a folded option; count, then that many character codes
0000100100000111  string_index_token           [COUNTED] the string at this index in the .sati, once the program carries no text
0000100100001000  wide_run_token               [COUNTED] count, then that many characters as their own 16-bit Unicode number
0000100100001001  wide_run_32_token            [COUNTED] RETIRED by D3.1 (2026-09-16): nothing writes it; a character above U+FFFF is wide_token and two codes
0000100100001010  long_count_token             the count that follows continues in the next code: no literal has a ceiling
0000100100001011  percentage_token             [COUNTED] 50% 12.5% 1000000000000% -- count, then the digits before the % (the author, 2026-09-17)
0000100100001100  free                         to 0000100111111111, free for this family

-- BATCH MARKS -- .satb, a PROPOSAL against open decision D12.1  (0000101000000000 up)
0000101000000000  batch_start_token            opens a batch: these calls may run on one pool thread
0000101000000001  batch_end_token              closes a batch
0000101000000010  wait_token                   the main thread waits here until everything marked before it has finished
0000101000000011  batch_size_token             how many commands one batch carries; a count follows
0000101000000100  free                         to 0000101011111111, free for this family

-- THE WORDS  (0001000000000000 up)
0000101100000000  find_token                   find  [METHOD] object.find(x) -- where x sits inside the receiver
0000101100000001  replace_token                replace  [METHOD] object.replace(a, b)
0000101100000010  to_string_token              to_string/str/string  [METHOD] the receiver as base-10 text
0000101100000011  to_number_token              number/as_number/to_number  [METHOD] the receiver as a whole number
0000101100000100  to_binary_token              binary/bin/as_binary  [METHOD] the receiver as base-2 text
0000101100000101  to_hexadecimal_token         hex/as_hex/to_hex  [METHOD] the receiver as base-16 text
0000101100000110  add_token                    add  [METHOD] object.add(x)
0000101100000111  append_token                 append  [METHOD] object.append(x) -- a new last line (a file); a new last item (a list) (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001000  insert_token                 insert  [METHOD] object.insert(n, x) -- x becomes line n and the rest move down; lines count from 1 (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001001  index_of_token               index_of  [METHOD] object.index_of(x) -- the number of the first line that IS x, or 0 (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001010  search_token                 search  [METHOD] object.search(x) -- the number of the first line that CONTAINS x, or 0 (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001011  contains_token               contains/contain  [METHOD] object.contains(x) -- whether any line is x (a file), any item is x (a list), any key is x (an index). `contain` is the author's alias, 2026-09-18
0000101100001100  remove_at_token              remove_at  [METHOD] object.remove_at(n) -- takes line n out (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001101  remove_token                 remove  [METHOD] object.remove(x) -- takes out the first line that is x (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001110  remove_first_token           remove_first  [METHOD] object.remove_first() (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100001111  remove_last_token            remove_last  [METHOD] object.remove_last() (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010000  truncate_token               truncate  [METHOD] object.truncate(n) -- keeps the first n lines (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010001  clear_token                  clear  [METHOD] object.clear -- no lines; the file stays (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010010  size_token                   size  [METHOD] object.size -- how many lines (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010011  empty_token                  empty  [METHOD] object.empty -- whether there are none (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010100  first_token                  first  [METHOD] object.first -- the first line (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010101  last_token                   last  [METHOD] object.last -- the last line (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010110  save_token                   save  [METHOD] object.save -- every change on the disk now, whole or not at all (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100010111  read_all_token               read_all  [METHOD] object.read_all -- the whole file as one string (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011000  close_token                  close  [METHOD] object.close -- saves, then closes (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011001  open_token                   open  [METHOD] object.open -- opens a closed file handle again (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011010  ok_token                     ok  [METHOD] object.ok -- whether the file is open (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011011  error_text_token             error  [METHOD] object.error -- why the last thing failed, in words (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011100  path_token                   path  [METHOD] object.path -- the path the file was opened on (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011101  exists_token                 exists  [METHOD] object.exists -- whether the handle's path is still a file (SATELLITE_FILE_OPERATIONS, 2026-09-18)
0000101100011110  sort_token                   sort  [METHOD] object.sort() -- the receiver, to be ordered by the .by_name() or .by_value() that follows (the author, 2026-09-18)
0000101100011111  by_name_token                by_name  [METHOD] object.sort().by_name() -- ordered A to Z, ALWAYS; .reverse() is how you get Z to A (the author, 2026-09-18)
0000101100100000  by_value_token               by_value  [METHOD] object.sort().by_value() -- smallest first, ALWAYS; .reverse() is how you get largest first (the author, 2026-09-18)
0000101100100001  reverse_token                reverse  [METHOD] object.reverse() -- a list, a string, a number, a binary or a hex, back to front (the author, 2026-09-18)
0000101100100010  keys_token                   keys  [METHOD] index.keys -- every key, as a list, IN THE ORDER THEY WERE PUT IN (words.tsv already numbers satellite.container.map.keys 1 4 1 8)
0000101100100011  values_token                 values  [METHOD] index.values -- every value, as a list, in the same order as .keys (words.tsv already numbers satellite.container.map.values 1 4 1 9)
0000101100100100  power_of_token               power_of/to_the_power_of/power  [METHOD] object.power_of(x) -- the object to the power of x; three spellings, the author's (SATELLITE_INFINITY.md, messages five and nine)
0000101100100101  resize_token                 resize  [METHOD] infinity.resize(n) -- that one infinity's nines width (SATELLITE_INFINITY.md, message two)
0000101100100110  nines_token                  nines  [METHOD] infinity.nines() -- the first count shown in nines (SATELLITE_INFINITY.md, Q14)
0000101100100111  focus_token                  focus  [METHOD] window.focus() -- ask the desktop to bring this window to the front (SATELLITE_WINDOW.md WIN-3)
0000101100101000  title_token                  title  [METHOD] window.title("text") -- the window's title now; window.title reads it back (SATELLITE_WINDOW.md WIN-3)
0000101100101001  pressed_token                pressed  [METHOD] button.pressed(a_capsule) -- the capsule to run when it is pressed; button.pressed reads the name back (SATELLITE_WINDOW.md WIN-11)
0000101100101010  press_token                  press  [METHOD] button.press() -- the PROGRAM presses it, as a click does; it takes nothing (SATELLITE_WINDOW.md WIN-11)
0000101100101011  text_token                   text  [METHOD] object.text -- the words on a piece of a window, read with no brackets; object.text("x") writes them (GTK_AND_NO_DEPENDENCIES.md GTK-1)
0000101100101100  on_token                     on  [METHOD] object.on -- whether a checkbox or a switch is turned on; object.on(1) turns it on and object.on(0) off (GTK_AND_NO_DEPENDENCIES.md GTK-3)
0000101100101101  value_token                  value  [METHOD] object.value -- the number a slider or a number box is at, or the percentage a progress bar shows; object.value(x) sets it (GTK_AND_NO_DEPENDENCIES.md GTK-4)
0000101100101110  chosen_token                 chosen  [METHOD] choice.chosen -- which of its items is picked, as TEXT; choice.chosen("green") picks that one (GTK_AND_NO_DEPENDENCIES.md GTK-5)
0000101100101111  changed_token                changed  [METHOD] piece.changed(a_capsule) -- the capsule to run when a person changes it: typed in it, moved it, ticked it, picked in it (GTK_AND_NO_DEPENDENCIES.md GTK-9)
0000101100110000  closed_token                 closed  [METHOD] window.closed(a_capsule) -- the capsule to run when the window goes away, whoever closed it (GTK_AND_NO_DEPENDENCIES.md GTK-9)
0000101100110001  width_token                  width  [METHOD] object.width -- how wide it is on the screen right now, in pixels (GTK_AND_NO_DEPENDENCIES.md GTK-8)
0000101100110010  height_token                 height  [METHOD] object.height -- how tall it is on the screen right now, in pixels (GTK_AND_NO_DEPENDENCIES.md GTK-8)
0000101100110011  fullscreen_token             fullscreen  [METHOD] window.fullscreen -- whether it fills the screen; window.fullscreen(1) makes it and window.fullscreen(0) gives it back (GTK_AND_NO_DEPENDENCIES.md GTK-8)
0000101100110100  colour_token                 colour/color  [METHOD] piece.colour("#00ff88") -- the colour its words are drawn in; two spellings, one meaning (GTK_AND_NO_DEPENDENCIES.md GTK-10)
0000101100110101  background_token             background  [METHOD] piece.background("#222222") -- the colour behind it (GTK_AND_NO_DEPENDENCIES.md GTK-10)
0000101100110110  font_token                   font  [METHOD] piece.font("IBM Plex Mono", 12) -- the face and the size its words are drawn in (GTK_AND_NO_DEPENDENCIES.md GTK-10)
0000101100110111  every_token                  every  [METHOD] window.every(a_capsule, 1000) -- run that capsule every so many milliseconds, for as long as the window is open (GTK_AND_NO_DEPENDENCIES.md GTK-13)
0000101100111000  key_token                    key  [METHOD] window.key(a_capsule) -- the capsule to run when a key is pressed; window.key reads which key it was (GTK_AND_NO_DEPENDENCIES.md GTK-14)
0000101100111001  clicked_token                clicked  [METHOD] piece.clicked(a_capsule) -- the capsule to run when a person clicks it; a BUTTON uses .pressed instead (GTK_AND_NO_DEPENDENCIES.md GTK-14)
0000101100111010  message_token                message  [METHOD] window.message("saved") -- say something to a person, with one button to dismiss it (GTK_AND_NO_DEPENDENCIES.md GTK-11)
0000101100111011  ask_token                    ask  [METHOD] window.ask(a_capsule, "delete it?") -- ask a person yes or no; the capsule runs with the answer in window.answer. The NAME comes first, as every capsule-naming method spells it (GTK_AND_NO_DEPENDENCIES.md GTK-11)
0000101100111100  answer_token                 answer  [METHOD] window.answer -- what a person last answered: "yes", "no", or "" if they dismissed it (GTK_AND_NO_DEPENDENCIES.md GTK-11)
0000101100111101  menu_token                   menu  [METHOD] window.menu(the_menu) -- put a menu across the top of this window; a second one goes beside the first (GTK_AND_NO_DEPENDENCIES.md GTK-12)
0000101100111110  item_token                   item  [METHOD] menu.item(a_capsule, "Open") -- an item on a menu, and the capsule that runs when a person picks it. The NAME comes first, as every capsule-naming method spells it (GTK_AND_NO_DEPENDENCIES.md GTK-12)
0000101100111111  free                         to 0000101111111111, free for this family

0001000000000000  word_base                    reserved: no word has this code
0001000000000001  the first word               satellite -- and every satellite.something.something after it
0001111111111111  the last word                to here: 4096 codes, words ONLY, nothing else is ever put here

-- FREE  (0010000000000000 up)
1001110001000000  wide_token                   the author, 2026-09-16: the next TWO codes are one 32-bit integer -- a character above U+FFFF inside a payload (D3.1)
1001110001000001  free                         to 1001110011111111, free beside the wide token

0010000000000000  free                         to 1001101111111111, unclaimed
1001110100000000  free                         to 1111111011111111, unclaimed -- the range above wide_token's family (split 2026-09-18, INF-1: one range used to run over it)

-- KEPT BACK  (1111111100000000 up)
1111111111111111  extend_token                 the next code carries the token; kept back so an all-ones buffer is never a token
