satellite.include(satellite)

// A WINDOW, AND THE AUTHOR'S OWN LINE FOR ONE (SATELLITE_WINDOW.md WIN-3,
// 2026-09-19): "satellite.variable.window my_window = satellite.window.new(...)"
// followed by an append of a button at a position.
//
// THREE ARGUMENTS AND NOT `800x600`. satl reads `x600` as a hex literal -- xFFAA
// is hex -- so `800x600` is two numbers side by side and is refused. Three is
// also what 003 wrote: its own removed word table has
// satellite.window.console.new(title, width, height).
//
// A POSITION IS THE PIECE'S CENTRE, not its corner: 400, 300 is the middle of an
// 800x600 window, whatever size the button turns out to be.
//
// `.pressed` NAMES A CAPSULE, WRITTEN AS IT IS WRITTEN (WIN-11) -- not
// "when_pressed" in quotes, and not a value worked out. satl proves the capsule
// is there before the program runs, which is why the name may stand there at
// all: a button wired to a capsule nobody wrote is refused with the rest of the
// program, rather than at the moment somebody presses it.
//
// WHAT A PRESS HANDS THE CAPSULE is decided by what the capsule DECLARES, because
// a press has nobody to write its arguments -- this program said `.pressed` and
// walked away. There are three shapes and no others:
//
//     when_pressed()                                     nothing
//     when_pressed(satellite.variable.window the_piece)  what was pressed
//     when_pressed(the_piece, its_window)                ...and the window it is in
//
// THE SECOND WINDOW IS THE ONLY WAY A PRESS CAN CLOSE WHAT IT WAS PRESSED IN.
// There are no globals, so `my_window` below is a name this capsule cannot see:
// a capsule gets its own frame and the arguments are the whole of what reaches it.
//
// A PRESS RUNS ON THE INTERPRETER'S THREAD, never the window's, and presses run
// ONE AT A TIME in the order they were made -- so a press that arrives while the
// program is still running its own lines waits, and is not lost.
//
// THE RUN DOES NOT END WHILE THE WINDOW IS OPEN. There is no wait word here and
// there does not need to be one: press the button, the capsule closes the window,
// and the program ends. Closing the window by hand ends it too.
//
// ON A MACHINE WITH NO SCREEN this refuses with S730 NO_DISPLAY and exits 50,
// which is not a fault in the program: the same file on a desktop opens a window.

satellite.capsule when_pressed(satellite.variable.window the_piece, satellite.variable.window its_window)
{
    satellite.console.display("the button was pressed, and this closes the window it is in")
    its_window.close()
}

satellite.capsule satellite.main()
{
    satellite.variable.window my_window = satellite.window.new("window_title", 800, 600)

    satellite.variable.window my_button = satellite.window.button("text")
    my_button.pressed(when_pressed)

    my_window.append(my_button, 400, 300)

    satellite.console.display("the window is open, and this line already ran")
    satellite.console.display(my_window)

    satellite.return(satellite)
}
