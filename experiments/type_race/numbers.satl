satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.number i = 0
    satellite.variable.number total = 0
    satellite.container.list<satellite.variable.number> my_list = satellite.container.list()
    satellite.variable.string s = ""

    satellite.statement.while(i < 1000000)
    {
        total = total + i
        my_list.append(i)
        s = "number " + i
        i = i + 1
    }

    satellite.console.display(total)
    satellite.console.display(my_list.size)
    satellite.console.display(s)

    satellite.return(satellite)
}
