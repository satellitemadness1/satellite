// STRINGS: a 100-character string joined to itself and compared, a turn at a time --
// copying and comparing 16-bit characters, which AVX2 does 16 at once.
satellite.include(satellite)

satellite.capsule satellite.main()
{
    satellite.variable.string piece = "the satellite programming language races itself, compiled twice over."
    satellite.variable.string joined = ""
    satellite.variable.number same = 0
    satellite.variable.number counter = 0
    satellite.statement.while(counter < 300000)
    {
        joined = piece + piece + piece + piece
        satellite.statement.if(joined == piece + piece + piece + piece)
        {
            same = same + 1
        }
        counter = counter + 1
    }
    satellite.console.display(same)
    satellite.return(satellite)
}
