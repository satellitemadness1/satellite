# Build products. This list is the Makefile's `clean` target, restated —
# if you add a binary there, add it here, because the two drifting apart is
# how a 500KB test binary ends up in a commit.

# The two shipped binaries (Makefile: all).
satl
satl-term

# The eleven test binaries (Makefile: test). library_test_tsan is the
# ThreadSanitizer build and is 10MB, which is the one that really hurts.
ast_test
bignum_test
env_test
eval_test
interp_test
lexer_test
library_test
library_test_tsan
parser_test
satellite_string_test
spacesuit_test

# Objects. *.o.tmp is the interrupted-compile leftover that `clean`'s own
# *.o does not match — see plans/todo.txt item 5.
*.o
*.o.tmp

# Generated by the Makefile, not authored: .libdir-stamp records the prefix
# baked into system.o so a changed prefix forces a rebuild, and the man pages
# are compressed from the dist/*.1 sources, which ARE tracked.
.libdir-stamp
dist/satl.1.gz
dist/satl-term.1.gz

# Benchmark and example harnesses. Their sources are tracked; these are what
# their Makefiles build. example/website/gtk_window is absent from that
# directory's clean target but is still a build product.
example/cxx_compare/compare
example/cxx_compare/bench
example/cxx_compare/hello
example/py_compare/compare
example/py_compare/.python.out
example/py_compare/.satellite.out
example/website/tour
example/website/gtk_window
example/website/cxx.out
example/website/satellite.out

# dpkg-buildpackage staging. The debian/ sources are tracked; everything
# debhelper writes into it at build time is not. The .deb itself lands in the
# PARENT directory and so never appears here.
debian/.debhelper/
debian/satellite/
debian/satellite-term/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/*.debhelper.log
