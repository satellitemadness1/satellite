// The bytecode format, as data. DESIGN.md §17 is the prose; this file is the
// machine-readable half, and the two must agree.
//
// There is no generator and no build step. This is an X-macro list: every
// consumer defines SAT_WORD / SAT_PATH, includes this file, and undefines them
// again. The registry, the arity table, the id->name strings and the
// disassembler therefore all come from ONE list and cannot drift apart, which
// is the whole reason the file exists. Adding a name is one line here.
//
// §17: ids are FROZEN. Assignment by order of appearance would renumber every
// construct after an insertion and silently change the meaning of already
// compiled files. Never renumber, never reuse, always append.
//
// The identifiers are deliberately not the bare words. `and`, `or`, `true` and
// `false` are C++ keywords or alternative tokens, and pasting them into an enum
// name is a trap; the quoted string is what the language actually calls the
// thing, and the identifier only has to be unique.

#ifndef SAT_WORD
#define SAT_WORD(id, ident, text)
#endif
#ifndef SAT_PATH
#define SAT_PATH(ident, s1, s2, s3, s4, arity)
#endif
#ifndef SAT_OP
#define SAT_OP(id, ident, text, arity)
#endif

// --- the registry: one id per distinct word, flat across all positions -------
// Flat means a word has one id wherever it appears: `console` is 6 in every
// position. §17 takes flat over per-position because at 64 bits a segment there
// is nothing to gain by packing, and flat leaves one table and one hex dump to
// read.

SAT_WORD( 1, SATELLITE,  "satellite")

// Segment-1 dispatch keys — parser.cpp's at_language_path() set.
SAT_WORD( 2, INCLUDE,    "include")
SAT_WORD( 3, CAPSULE,    "capsule")
SAT_WORD( 4, MAIN,       "main")
SAT_WORD( 5, RETURN,     "return")
SAT_WORD( 6, CONSOLE,    "console")
SAT_WORD( 7, DISPLAY,    "display")
SAT_WORD( 8, RETURNS,    "returns")
SAT_WORD( 9, SPACESUIT,  "spacesuit")
SAT_WORD(10, PROTECTED,  "protected")
SAT_WORD(11, PUBLIC,     "public")
SAT_WORD(12, STATEMENT,  "statement")
SAT_WORD(13, IF,         "if")
SAT_WORD(14, ELSE,       "else")
SAT_WORD(15, WHILE,      "while")
SAT_WORD(16, FOR,        "for")
SAT_WORD(17, VARIABLE,   "variable")

// 18..20 reserved. §15 ranks break and continue as the two gaps that hurt most,
// and holding low ids for them costs nothing today. Do not fill these with
// anything else.

// Type names — the second segment of satellite.variable.* / .container.*
SAT_WORD(21, BOOL,       "bool")
SAT_WORD(22, NUMBER,     "number")
SAT_WORD(23, STRING,     "string")
SAT_WORD(24, TIME,       "time")
SAT_WORD(25, FILE,       "file")
SAT_WORD(26, CONTAINER,  "container")
SAT_WORD(27, LIST,       "list")
// `map` is a type name and belongs in this group, but it is id 73 and lives at
// the bottom of the file. The append-only rule above forbids putting it here,
// and this is the FIRST entry whose semantic group and numeric position
// disagree. Grouping is a comment; numbering is the format. When the two
// conflict the numbering wins, and a pointer like this one is the fix.

// Modules and module functions.
SAT_WORD(28, LIBRARY,    "library")
SAT_WORD(29, HELP,       "help")
SAT_WORD(30, NOW,        "now")
SAT_WORD(31, OPEN,       "open")
SAT_WORD(32, DIRECTORY,  "directory")
SAT_WORD(33, CURRENT,    "current")
SAT_WORD(34, CHANGE,     "change")
SAT_WORD(35, EXISTS,     "exists")
SAT_WORD(36, TRUE_,      "true")
SAT_WORD(37, FALSE_,     "false")

// Methods. Bare selectors read relative to what precedes them (§1), so they are
// user-facing bare words but language-owned names, and they need ids like any
// other. Taken from eval.cpp's call_method tables.
SAT_WORD(38, PLUS,        "plus")
SAT_WORD(39, MINUS,       "minus")
SAT_WORD(40, TIMES,       "times")
SAT_WORD(41, DIVIDED_BY,  "divided_by")
SAT_WORD(42, MODULO,      "modulo")
SAT_WORD(43, ABS,         "abs")
SAT_WORD(44, FLOOR,       "floor")
SAT_WORD(45, CEIL,        "ceil")
SAT_WORD(46, ROUND,       "round")
SAT_WORD(47, TO_STRING,   "to_string")
SAT_WORD(48, LENGTH,      "length")
SAT_WORD(49, CONCAT,      "concat")
SAT_WORD(50, CONTAINS,    "contains")
SAT_WORD(51, STARTS_WITH, "starts_with")
SAT_WORD(52, ENDS_WITH,   "ends_with")
SAT_WORD(53, FIRST,       "first")
SAT_WORD(54, LAST,        "last")
SAT_WORD(55, APPEND,      "append")
SAT_WORD(56, EMPTY,       "empty")
SAT_WORD(57, AND_,        "and")
SAT_WORD(58, OR_,         "or")
SAT_WORD(59, NEGATE,      "negate")
SAT_WORD(60, OK,          "ok")
SAT_WORD(61, READ,        "read")
SAT_WORD(62, WRITE,       "write")
SAT_WORD(63, CLOSE,       "close")
SAT_WORD(64, ERROR,       "error")
SAT_WORD(65, PATH,        "path")
SAT_WORD(66, NANOSECONDS, "nanoseconds")

// Comparison. These are what `==` `!=` `<` `<=` `>` `>=` COMPILE TO: an operator
// is surface syntax for a selector, exactly as §7 makes a method surface syntax
// for a module function, so the machine needs no arithmetic or comparison
// opcodes of its own. `+` is already `plus` (38) and needed nothing new; these
// six are the operators that had no name yet.
//
// They dispatch on the receiver like every other selector — `minus` is already
// both a number and a time method, `contains` both a string and a list one — so
// one id per comparison covers every type that can be compared.
SAT_WORD(67, EQUALS,           "equals")
SAT_WORD(68, NOT_EQUALS,       "not_equals")
SAT_WORD(69, LESS_THAN,        "less_than")
SAT_WORD(70, LESS_OR_EQUAL,    "less_or_equal")
SAT_WORD(71, GREATER_THAN,     "greater_than")
SAT_WORD(72, GREATER_OR_EQUAL, "greater_or_equal")

// satellite.container.map<K, V>, and the six selectors it adds. `map` is a type
// name whose group is up beside `list` (27); it is here because ids are never
// renumbered and 73 was next.
//
// `length` (48) and `to_string` (47) are REUSED rather than duplicated — the
// space is flat, so a word has one id wherever it appears, and a map answering
// to `length` is the same word a list answers to.
//
// `has` is a new word rather than a reuse of `contains` (50) on purpose:
// `contains` is substring containment on a string and element containment on a
// list, and on a map it would be ambiguous between keys and values. A name that
// has to be disambiguated by its receiver is a name that will be read wrong.
SAT_WORD(73, MAP,     "map")
SAT_WORD(74, GET,     "get")
SAT_WORD(75, SET,     "set")
SAT_WORD(76, REMOVE,  "remove")
SAT_WORD(77, HAS,     "has")
SAT_WORD(78, KEYS,    "keys")
SAT_WORD(79, VALUES,  "values")

// --- the arity table: complete paths, and how many operands each takes -------
// §17: decoding is positional. Nothing in the stream announces "I am an
// instruction" — the reader starts at an instruction boundary and each path's
// arity says how many operand units follow, which returns it to a boundary.
// This table IS the grammar of the format. A path whose arity is unrecorded is
// a stream that cannot be decoded.
//
// Zero segments beyond the ones used. The four ids are exactly the four 64-bit
// words of the name code.

SAT_PATH(P_INCLUDE,        1,  2,  0, 0, 1)   // satellite.include(x)
SAT_PATH(P_RETURN,         1,  5,  0, 0, 1)   // satellite.return(x)
SAT_PATH(P_DISPLAY,        1,  6,  7, 0, 1)   // satellite.console.display(x)
SAT_PATH(P_TIME_NOW,       1, 24, 30, 0, 0)   // satellite.time.now()
SAT_PATH(P_FILE_OPEN,      1, 25, 31, 0, 2)   // satellite.file.open(path, mode)
SAT_PATH(P_DIR_CURRENT,    1, 32, 33, 0, 0)   // satellite.directory.current()
SAT_PATH(P_DIR_CHANGE,     1, 32, 34, 0, 1)   // satellite.directory.change(d)
SAT_PATH(P_DIR_EXISTS,     1, 32, 35, 0, 1)   // satellite.directory.exists(d)
SAT_PATH(P_BOOL_TRUE,      1, 21, 36, 0, 0)   // satellite.bool.true
SAT_PATH(P_BOOL_FALSE,     1, 21, 37, 0, 0)   // satellite.bool.false
SAT_PATH(P_HELP,           1, 29,  0, 0, 0)   // satellite.help

// --- machine ops: kind 4, and a SEPARATE id space ----------------------------
// These are not names. No satellite program can write MOVE, and §1's rule is
// that the registry above enumerates what the LANGUAGE owns — putting machine
// operations in it would undercut the closure property that let the registry be
// a frozen table in the first place. The unit's kind field has 16 values and
// used 4, so kind 4 costs nothing and keeps the two spaces apart. Ids here
// restart at 1 and are read against this table, never against the one above.
//
// Methods deliberately have NO entry here and none above: CALL_METHOD carries
// an explicit argument count, so a method's arity is read from the stream
// rather than from a table, and the decoder stays positional without needing
// one row per selector.
//
// Arity is operand UNITS following the op, exactly as SAT_PATH's is.

SAT_OP(1, OP_MOVE,          "move",          2)  // dst, src
SAT_OP(2, OP_LOADK,         "loadk",         2)  // dst, pool index
SAT_OP(3, OP_LOADI,         "loadi",         2)  // dst, immediate
SAT_OP(4, OP_JUMP,          "jump",          1)  // target unit
SAT_OP(5, OP_JUMP_IF_FALSE, "jump_if_false", 2)  // test reg, target unit
SAT_OP(6, OP_JUMP_IF_TRUE,  "jump_if_true",  2)  // test reg, target unit
SAT_OP(7, OP_CALL,          "call",          4)  // capsule, first arg reg, count, dst
SAT_OP(8, OP_CALL_METHOD,   "call_method",   5)  // recv, selector, first arg, count, dst
SAT_OP(9, OP_RETURN,        "return",        1)  // src reg

// Targets are ABSOLUTE unit indices, not byte offsets and not relative jumps.
// Units are fixed width, so an index is a multiply-free array subscript, and an
// absolute target survives having code moved around it during compilation.
//
// JUMP_IF_TRUE exists for one reason: `||`. §15 ranks `&&` and `||` third among
// the gaps stage 0 found, and when they land they CANNOT compile to the `and`
// (57) / `or` (58) selectors, because a call evaluates its argument before it
// runs and those two must not. Short-circuit is a branch, not a call, and it
// needs a branch in each polarity.

#undef SAT_WORD
#undef SAT_PATH
#undef SAT_OP
